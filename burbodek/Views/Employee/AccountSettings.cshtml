@section Scripts {
	<script>
				let originalProfileSrc = null;
		let selectedProfileFile = null;

		function previewProfileImage(event) {
			const file = event.target.files[0];
			if (!file) return;

			// Validate type
			if (!file.type.startsWith('image/')) {
				Swal.fire({
					text: "Please select a valid image file.",
					icon: "warning",
					buttonsStyling: false,
					confirmButtonText: "OK",
					customClass: { confirmButton: "btn btn-primary" }
				});
				return;
			}

			// Validate size (max 5MB)
			if (file.size > 5 * 1024 * 1024) {
				Swal.fire({
					text: "Image size must not exceed 5MB.",
					icon: "warning",
					buttonsStyling: false,
					confirmButtonText: "OK",
					customClass: { confirmButton: "btn btn-primary" }
				});
				return;
			}

			const reader = new FileReader();
			reader.onload = function (e) {
				// Store original src before replacing
				const preview = document.getElementById('profilePreview');
				if (!originalProfileSrc) {
					originalProfileSrc = preview.src;
				}

				selectedProfileFile = file;
				preview.src = e.target.result;
				document.getElementById('profileActions').classList.remove('d-none');
				document.getElementById('profileActions').classList.add('d-flex');
			};
			reader.readAsDataURL(file);
		}

		function confirmProfileImage() {
			if (!selectedProfileFile) return;

			const formData = new FormData();
			formData.append('profileImage', selectedProfileFile);

			// Add antiforgery token

			Swal.fire({
				text: "Uploading profile picture...",
				icon: "info",
				showConfirmButton: false,
				allowOutsideClick: false,
				didOpen: () => Swal.showLoading(),
			});

			fetch('/Employee/UpdateProfilePicture', {
				method: 'POST',
				body: formData
			})
			.then(res => {
				if (!res.ok) throw new Error(`HTTP error: ${res.status}`);
				return res.json();
			})
			.then(data => {
				if (data.success) {
					Swal.fire({
						text: "Profile picture updated successfully.",
						icon: "success",
						buttonsStyling: false,
						confirmButtonText: "OK",
						customClass: { confirmButton: "btn btn-primary" }
					});
					// Update original src to new image
					originalProfileSrc = document.getElementById('profilePreview').src;
					resetProfileActions();
				} else {
					Swal.fire({
						text: data.message ?? "Failed to update profile picture.",
						icon: "error",
						buttonsStyling: false,
						confirmButtonText: "OK",
						customClass: { confirmButton: "btn btn-primary" }
					});
				}
			})
			.catch(() => {
				Swal.fire({
					text: "A network error occurred. Please try again.",
					icon: "error",
					buttonsStyling: false,
					confirmButtonText: "OK",
					customClass: { confirmButton: "btn btn-primary" }
				});
			});
		}

		function cancelProfileImage() {
			// Revert preview to original
			if (originalProfileSrc) {
				document.getElementById('profilePreview').src = originalProfileSrc;
			}
			resetProfileActions();
		}

		function resetProfileActions() {
			selectedProfileFile = null;
			document.getElementById('profileImageInput').value = '';
			document.getElementById('profileActions').classList.add('d-none');
			document.getElementById('profileActions').classList.remove('d-flex');
		}
		// Change Password button
		$('#kt_signin_password_button button').click(function() {
			// Hide the display div
			$('#kt_signin_password').addClass('d-none');
			// Show the edit form
			$('#kt_signin_password_edit').removeClass('d-none');
			// Hide the button itself
			$(this).hide();
		});

		// Cancel button for password
		$('#kt_password_cancel').click(function() {
			$('#kt_signin_password').removeClass('d-none');
			$('#kt_signin_password_edit').addClass('d-none');
			// Show the Change Password button again
			$('#kt_signin_password_button button').show();
		});
		 $('#kt_account_profile_details_form').submit(function(e) {
			e.preventDefault();

			// Get form values
			var firstName = $('input[name="FirstName"]').val();
			var lastName = $('input[name="LastName"]').val();
			var mobileNumber = $('input[name="MobileNo"]').val();
			var birthDay = $('input[name="Birthday"]').val();
			var nationality = $('select[name="Nationality"]').val();

			Swal.fire({
				title: 'Are you sure?',
				text: "Do you want to update your profile details?",
				icon: 'question',
				showCancelButton: true,
				confirmButtonText: 'Yes, update it!',
				cancelButtonText: 'Cancel'
			}).then((result) => {
				if (result.isConfirmed) {
					$.ajax({
						url: '/Employee/ChangeProfileDetails',
						type: 'POST',
						data: {
							Firstname: firstName,
							Lastname: lastName,
							MobileNumber: mobileNumber,
							Birthday: birthDay,
							Nationality: nationality,
						},
						success: function(response) {
							if(response.response) {
								Swal.fire({
									icon: 'success',
									title: 'Profile Updated',
									text: 'Your profile details have been successfully updated.'
								});
							} else {
								Swal.fire({
									icon: 'error',
									title: 'Error',
									text: response.message || 'Unable to update profile. Please try again.'
								});
							}
						},
						error: function(xhr, status, error) {
							Swal.fire({
								icon: 'error',
								title: 'Server Error',
								text: `An unexpected error occurred. Please try again later. ${xhr.responseText}`
							});
							console.log(xhr.responseText);
						}
					});
				}
			});
		});
		 $('#kt_password_submit').click(function(e) {
			e.preventDefault();

			var currentPassword = $('#currentpassword').val();
			var newPassword = $('#newpassword').val();
			var confirmNewPassword = $('#confirmpassword').val();

			// Basic validation
			if(!currentPassword || !newPassword || !confirmNewPassword) {
				Swal.fire({
					icon: 'warning',
					title: 'Validation Error',
					text: 'Please fill in all password fields.'
				});
				return;
			}

			if(newPassword !== confirmNewPassword) {
				Swal.fire({
					icon: 'warning',
					title: 'Validation Error',
					text: 'New password and confirmation do not match.'
				});
				return;
			}

			Swal.fire({
				title: 'Are you sure?',
				text: "Do you want to change your password?",
				icon: 'question',
				showCancelButton: true,
				confirmButtonText: 'Yes, change it!',
				cancelButtonText: 'Cancel'
			}).then((result) => {
				if(result.isConfirmed) {
					$.ajax({
						url: '@Url.Action("ChangePassword", "Employee")',
						type: 'POST',
						data: {
							CurrentPassword: currentPassword,
							NewPassword: newPassword,
							ConfirmNewPassword: confirmNewPassword
						},
						success: function(response) {
							if(response.response) {
								Swal.fire({
									icon: 'success',
									title: 'Password Updated',
									text: 'Your password has been successfully changed.'
								}).then(() => {
									// Clear form
									$('#currentpassword').val('');
									$('#newpassword').val('');
									$('#confirmpassword').val('');
									// Hide form and show password div
									$('#kt_signin_password_edit').addClass('d-none');
									$('#kt_signin_password').removeClass('d-none');
									$('#kt_signin_password_button button').show();
								});
							} else {
								Swal.fire({
									icon: 'error',
									title: 'Error',
									text: response.message || 'Failed to update password. Please try again.'
								});
							}
						},
						error: function(xhr, status, error) {
							Swal.fire({
								icon: 'error',
								title: 'Server Error',
								text: 'An unexpected error occurred. Please try again later.'
							});
							console.log(xhr.responseText);
						}
					});
				}
			});
		});
	</script>
}