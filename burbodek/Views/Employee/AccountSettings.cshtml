@{
	ViewData["Title"] = "Account Settings - Profile";
    Layout = "~/Views/Shared/_LayoutEmployee.cshtml";
}
@{
	bool hasNewJobs = ViewBag.HasNewJobs ?? false;
	bool hasNewTrainings = ViewBag.HasNewTrainings ?? false;
	bool hasNewInterviews = ViewBag.HasNewInterviews ?? false;
}
@model Users;
<div id="kt_app_content_container" class="app-container container-xxl">
	<!--begin::Navbar-->
	<div class="card mb-5 mb-xl-10">
		<div class="card-body pt-9 pb-0">
			<!--begin::Details-->
			<div class="d-flex flex-wrap flex-sm-nowrap">
				<!--begin::Pic-->
				<div class="me-7 mb-4">
					<div class="symbol symbol-100px symbol-lg-160px symbol-fixed position-relative">

						<!--begin::Avatar Image-->
						<img id="profilePreview" src="@(Model.UserProfile?.Picture ?? "/assets/media/avatars/300-14.jpg")" alt="image" />
						<!--end::Avatar Image-->
						<!--begin::Online Indicator-->
						<div class="position-absolute translate-middle bottom-0 start-100 mb-6 bg-success rounded-circle border border-4 border-body h-20px w-20px"></div>
						<!--end::Online Indicator-->
						<!--begin::Upload Overlay-->
						<div id="uploadOverlay"
							 class="position-absolute top-0 start-0 w-100 h-100 rounded d-flex align-items-center justify-content-center"
							 style="background: rgba(0,0,0,0.45); opacity:0; transition: opacity 0.2s; cursor:pointer; border-radius: inherit;"
							 onclick="document.getElementById('profileImageInput').click()"
							 onmouseenter="this.style.opacity='1'"
							 onmouseleave="this.style.opacity='0'">
							<i class="ki-duotone ki-pencil fs-2x text-white">
								<span class="path1"></span><span class="path2"></span>
							</i>
						</div>
						<!--end::Upload Overlay-->
						<!--begin::Hidden File Input-->
						<input type="file"
							   id="profileImageInput"
							   accept="image/*"
							   class="d-none"
							   onchange="previewProfileImage(event)" />
						<!--end::Hidden File Input-->
					</div>

					<!--begin::Accept/Decline Buttons-->
					<div id="profileActions" class="d-none d-flex justify-content-center gap-2 mt-3">
						<button type="button"
								class="btn btn-icon btn-sm btn-success"
								onclick="confirmProfileImage()"
								data-bs-toggle="tooltip"
								title="Save">
							<i class="ki-duotone ki-check fs-2">
								<span class="path1"></span>
							</i>
						</button>
						<button type="button"
								class="btn btn-icon btn-sm btn-danger"
								onclick="cancelProfileImage()"
								data-bs-toggle="tooltip"
								title="Cancel">
							<i class="ki-duotone ki-cross fs-2">
								<span class="path1"></span>
							</i>
						</button>
					</div>
					<!--end::Accept/Decline Buttons-->
				</div>
				<!--end::Pic-->
				<!--begin::Info-->
				<div class="flex-grow-1">
