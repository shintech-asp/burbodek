@model List<JobApplication>;
@{
    ViewData["Title"] = "My Applications";
    Layout = "~/Views/Shared/_LayoutEmployee.cshtml";
    int totalPending = Model.Count(a => a.Status == "Applied");
    int totalApplication = Model.Count();
    int totalInterview = Model.Count(a => a.Status == "Interview");
    int totalRejected = Model.Count(a => a.Status == "Rejected");

}

<div class="container-xxl" id="kt_content_container">

    <!-- 🔹 Stats Section -->
    <div class="row mb-8">

        <!-- Total Applied -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h3 class="fw-bold">@totalApplication</h3>
                    <p class="text-muted mb-0">Total Applications</p>
                </div>
            </div>
        </div>

        <!-- Shortlisted -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h3 class="fw-bold text-success">@totalInterview</h3>
                    <p class="text-muted mb-0">For Interview</p>
                </div>
            </div>
        </div>

        <!-- Pending -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h3 class="fw-bold text-primary">@totalPending</h3>
                    <p class="text-muted mb-0">Pending Review</p>
                </div>
            </div>
        </div>

        <!-- Hired -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h3 class="fw-bold text-info">@totalRejected</h3>
                    <p class="text-muted mb-0">Rejected</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 🔹 Applications Table -->
    <div class="card">
        <div class="card-header border-0 pt-6">
            <h2 class="fw-bold">My Applied Jobs</h2>
            <div class="card-toolbar">
                <div class="d-flex justify-content-end">
                    <select class="form-select form-select-solid w-200px" data-control="select2" data-placeholder="Filter by status">
                        <option></option>
                        <option value="all" selected>All</option>
                        <option value="pending">Pending</option>
                        <option value="reviewing">Reviewing</option>
                        <option value="shortlisted">Shortlisted</option>
                        <option value="hired">Hired</option>
                        <option value="rejected">Rejected</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="card-body pt-0">
            <div class="table-responsive">
                <table class="table align-middle table-row-dashed gy-5">
                    <thead>
                        <tr class="fw-bold text-muted">
                            <th class="min-w-200px">Job Title</th>
                            <th class="min-w-150px">Company</th>
                            <th class="min-w-120px">Applied Date</th>
                            <th class="min-w-100px">Status</th>
                            <th class="min-w-200px text-center">Actions</th>
                        </tr>
                    </thead>
                    @if (Model.Count > 0)
                    {
                        <tbody>
                            <!-- Row Example -->
                            @foreach (var data in Model)
                            {

                                <tr>
                                    <td><a href="#" class="text-dark fw-bold text-hover-primary fs-6">@data.Jobs.JobTitle</a></td>
                                    <td>@data.Jobs.Users.Username</td>
                                    <td>
                                        @data.CreatedAt.ToString("MMMM dd yyyy")
                                    </td>
                                    @{
                                        string badge;
                                        if (data.Status == "Applied")
                                        {
                                            badge = "badge-light-primary";
                                        }
                                        else if (data.Status == "Interview")
                                        {
                                            badge = "badge-light-success";
                                        }
                                        else if (data.Status == "Hired")
                                        {
                                            badge = "badge-light-info";
                                        }
                                        else
                                        {
                                            badge = "badge-light-danger";
                                        }
                                    }
                                    <td><span class="badge @badge">@data.Status</span></td>
                                    <td class="text-center">
                                        <a asp-action="ApplicationDetails" asp-controller="Employee" asp-route-Id="@data.Jobs.Id" class="btn btn-sm btn-light btn-active-light-primary me-2">View Details</a>
                                        <a asp-controller="Employee" asp-action="Reply" class="btn btn-sm btn-light btn-active-light-success">Mail</a>
                                    </td>
                                </tr>
                            }
                            <!-- Add more rows as needed -->
                        </tbody>
                    }
                    else
                    {
                        <tbody>
                            <tr>
                                <td class="text-center fst-italic" colspan="5">No jobs applied</td>
                            </tr>
                        </tbody>
                    }

                </table>
            </div>
        </div>
    </div>
</div>
