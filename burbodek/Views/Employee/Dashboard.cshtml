@using Humanizer
@using burbodek.Models.ViewModels
@{
	ViewData["Title"] = "Dashboard";
	Layout = "~/Views/Shared/_LayoutEmployee.cshtml";
}
@model EmployeeDashboardViewModel

<style>
	/* Main Layout */
	.feed-wrapper {
		display: flex;
		background-color: #f0f2f5;
		height: calc(100vh - 60px);
		overflow: hidden;
		margin: 0;
		padding: 0;
	}

	.feed-main {
		flex: 1;
		max-width: 680px;
		margin: 0 auto;
		overflow-y: auto;
		overflow-x: hidden;
		padding: 16px 0;
		scrollbar-width: thin;
		scrollbar-color: #b0b3b8 transparent;
	}

		.feed-main::-webkit-scrollbar {
			width: 8px;
		}

		.feed-main::-webkit-scrollbar-track {
			background: transparent;
		}

		.feed-main::-webkit-scrollbar-thumb {
			background-color: #b0b3b8;
			border-radius: 4px;
		}

			.feed-main::-webkit-scrollbar-thumb:hover {
				background-color: #8a8d91;
			}

	.feed-sidebar {
		width: 360px;
		padding: 16px 12px;
		overflow-y: auto;
		overflow-x: hidden;
		scrollbar-width: thin;
		scrollbar-color: #b0b3b8 transparent;
	}

		.feed-sidebar::-webkit-scrollbar {
			width: 8px;
		}

		.feed-sidebar::-webkit-scrollbar-track {
			background: transparent;
		}

		.feed-sidebar::-webkit-scrollbar-thumb {
			background-color: #b0b3b8;
			border-radius: 4px;
		}

			.feed-sidebar::-webkit-scrollbar-thumb:hover {
				background-color: #8a8d91;
			}

	/* Feed Card Styling */
	.feed-card {
		background-color: #ffffff;
		border-radius: 8px;
		border: none;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
		transition: box-shadow 0.2s ease;
		margin-bottom: 16px;
	}

		.feed-card:hover {
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
		}

	.feed-header {
		padding: 12px 16px;
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.feed-avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: cover;
	}

	.feed-user-info h6 {
		margin: 0;
		font-size: 15px;
		font-weight: 600;
		color: #050505;
		line-height: 1.2;
	}

	.feed-timestamp {
		font-size: 13px;
		color: #65676b;
		margin: 0;
	}

	.feed-content {
		padding: 0 16px 12px 16px;
	}

	.feed-text {
		font-size: 15px;
		color: #050505;
		line-height: 1.5;
		margin: 0;
	}

	.feed-image {
		width: 100%;
		max-height: 500px;
		object-fit: cover;
		display: block;
		background-color: #f0f2f5;
	}

	.feed-stats {
		padding: 8px 16px;
		border-bottom: 1px solid #e4e6eb;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.feed-likes {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 15px;
		color: #65676b;
	}

	.feed-views {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		color: #65676b;
	}

	.feed-actions {
		padding: 4px 8px;
	}

	.feed-action-btn {
		flex: 1;
		border: none;
		background: transparent;
		border-radius: 6px;
		font-weight: 500;
		font-size: 15px;
		color: #65676b;
		padding: 8px 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		transition: background-color 0.2s ease;
		cursor: pointer;
	}

		.feed-action-btn:hover {
			background-color: #f0f2f5;
		}

	/* Payment Sidebar Styling */
	.payment-sidebar {
		background-color: #ffffff;
		border-radius: 8px;
		border: none;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
		overflow: hidden;
		position: sticky;
		top: 0;
	}

	.payment-header {
		background-color: #ffffff;
		border-bottom: 1px solid #e4e6eb;
		padding: 16px 20px;
	}

	.payment-title {
		font-size: 17px;
		font-weight: 700;
		color: #050505;
		margin: 0;
	}

	.payment-item {
		padding: 16px 20px;
		border-bottom: 1px solid #f0f2f5;
		transition: background-color 0.2s ease;
	}

		.payment-item:hover {
			background-color: #f7f8fa;
		}

		.payment-item:last-child {
			border-bottom: none;
		}

	.payment-training-name {
		font-size: 15px;
		font-weight: 600;
		color: #050505;
		margin-bottom: 4px;
		display: block;
		text-decoration: none;
	}

		.payment-training-name:hover {
			color: #1877f2;
			text-decoration: underline;
		}

	.payment-username {
		font-size: 13px;
		color: #65676b;
		margin-bottom: 8px;
		display: block;
	}

	.payment-details {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 12px;
		flex-wrap: wrap;
		gap: 8px;
	}

	.payment-price {
		font-size: 15px;
		font-weight: 700;
		color: #050505;
	}

	.payment-badge {
		padding: 4px 12px;
		border-radius: 16px;
		font-size: 12px;
		font-weight: 600;
		display: inline-block;
	}

	.badge-pending {
		background-color: #fff3cd;
		color: #856404;
	}

	.badge-paid {
		background-color: #d1ecf1;
		color: #0c5460;
	}

	.badge-full {
		background-color: #d4edda;
		color: #155724;
	}

	.badge-reserved {
		background-color: #d4edda;
		color: #155724;
	}

	.payment-due {
		font-size: 13px;
		color: #65676b;
		margin-top: 8px;
	}

	.payment-view-btn {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background-color: #f0f2f5;
		border: none;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background-color 0.2s ease;
		margin-left: auto;
		text-decoration: none;
	}

		.payment-view-btn:hover {
			background-color: #e4e6eb;
		}

	.payment-empty {
		padding: 40px 20px;
		text-align: center;
		color: #65676b;
		font-size: 14px;
	}

	/* Responsive */
	@@media (max-width: 1200px) {
		.feed-sidebar

	{
		display: none;
	}

	.feed-main {
		max-width: 100%;
	}

	}
</style>

<div class="feed-wrapper">
	<!-- Main Feed (Scrollable) -->
	<div class="feed-main">
		@foreach (var campaign in Model.Campaign.OrderByDescending(c => c.CreatedAt))
		{
			<div class="feed-card">
				<!-- Post Header -->
				<div class="feed-header">
					<img src="@(campaign.LogoFilePath ?? "~/assets/media/avatars/default.jpg")"
						 class="feed-avatar"
						 alt="@campaign.CampaignName" />
					<div class="feed-user-info flex-grow-1">
						<h6>@campaign.CampaignName</h6>
						<p class="feed-timestamp">@campaign.CreatedAt.Humanize()</p>
					</div>
				</div>

				<!-- Post Content -->
				@if (!string.IsNullOrEmpty(campaign.CampaignDescription))
				{
					<div class="feed-content">
						<p class="feed-text">@campaign.CampaignDescription</p>
					</div>
				}

				<!-- Post Image -->
				@if (!string.IsNullOrEmpty(campaign.LogoFilePath))
				{
					<img src="@campaign.LogoFilePath"
						 class="feed-image"
						 alt="@campaign.CampaignName" />
				}

				<!-- Post Stats -->
				<div class="feed-stats">
					<div class="feed-views">
						<i class="ki-duotone ki-eye fs-5"></i>
						<span>@campaign.TotalClicks views</span>
					</div>
				</div>

				<!-- Post Actions -->
				<div class="feed-actions">
					@if(campaign.ListingType == "Jobs")
					{
						<a class="feed-action-btn view-campaign-btn w-100" asp-controller="Employee" asp-action="JobViewCampaign"asp-route-CampaignId="@campaign.Id" asp-route-Id="@campaign.SelectedListingId">
							<i class="ki-duotone ki-arrow-right fs-3"></i>
							View Details
						</a>
					}
					else
					{
						<a class="feed-action-btn view-campaign-btn w-100" asp-controller="Employee" asp-action="TrainingViewCampaign" asp-route-CampaignId="@campaign.Id" asp-route-Id="@campaign.SelectedListingId">
							<i class="ki-duotone ki-arrow-right fs-3"></i>
							View Details
						</a>
					}
				</div>
			</div>
		}
	</div>

	<!-- Right Sidebar (Fixed) -->
	<div class="feed-sidebar">
		<div class="payment-sidebar">
			<div class="payment-header">
				<h5 class="payment-title">Training Pending Payment</h5>
			</div>

			@if (Model != null && Model.Training.Count > 0)
			{
				@foreach (var data in Model.Training)
				{
					<div class="payment-item">
						<a href="#" class="payment-training-name">@data.TrainingApplication.Training.Name</a>
						<span class="payment-username">@data.TrainingApplication.Training.Users.Username</span>

						<div class="payment-details">
							<span class="payment-price">₱@data.Price.ToString("N0")</span>

							@if (data.ModeOfPayment == "Cash" && data.PaymentOption == "Full")
							{
								<span class="payment-badge badge-reserved">Slot Reserved</span>
							}
							else
							{
								@if (data.Paid == null)
								{
									<span class="payment-badge badge-pending">Pending</span>
								}
								else if (data.Paid != data.Price)
								{
									<span class="payment-badge badge-paid">Paid Downpayment</span>
								}
								else
								{
									<span class="payment-badge badge-full">Fully Paid</span>
								}
							}

							<a asp-action="TrainingPayment" asp-controller="Employee" asp-route-Id="@data.Id" class="payment-view-btn">
								<i class="ki-duotone ki-arrow-right fs-4"></i>
							</a>
						</div>

						<div class="payment-due">
							Due: @data.TrainingApplication.Training.Expiration.Humanize()
						</div>
					</div>
				}
			}
			else
			{
				<div class="payment-empty">
					No training pending for payment.
				</div>
			}
		</div>
	</div>
</div>