@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_LayoutEmployee.cshtml";
}
@model burbodek.Models.ViewModels.JobListViewModel;
<style>
    .required-badge {
        background: linear-gradient(135deg, #e7f1ff, #f4f9ff);
        color: #0d6efd;
        border: 1px solid #cfe2ff;
        border-radius: 999px;
        padding: 6px 12px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        box-shadow: 0 2px 4px rgba(13,110,253,0.1);
        transition: all .2s ease-in-out;
    }

        .required-badge:hover {
            background: #0d6efd;
            color: #fff;
            border-color: #0d6efd;
            transform: translateY(-1px);
        }

        .required-badge i {
            font-size: 0.8rem;
        }

</style>
<div class="d-flex flex-column flex-root">
    <div class="page d-flex flex-row flex-column-fluid">
        <div class="wrapper d-flex flex-column flex-row-fluid" id="kt_wrapper">

            <!-- Header -->
            <div id="kt_header" class="header align-items-stretch">
                <div class="container-fluid d-flex flex-column align-items-center py-5">
                    <h1 class="text-dark fw-bold mb-4">Cruise Ship Jobs</h1>
                    <form asp-action="Index" method="get" class="d-flex w-75">
                        <input type="text" name="keyword" value="@Model.Keyword" class="form-control form-control-lg me-2" placeholder="Job title, keyword..." />
                        <input type="text" name="location" value="@Model.Location" class="form-control form-control-lg me-2" placeholder="Location" />
                        <select class="form-select" name="filter">
                            <option value="All">All</option>
                            <option value="Jobs">Jobs</option>
                            <option value="Trainings">Trainings</option>
                        </select>
                        <button type="submit" class="btn btn-lg btn-primary">Search</button>
                    </form>
                </div>
            </div>

            <!-- Job Results -->
            <div class="content d-flex flex-column flex-column-fluid py-5">
                <div class="container">
                    <h4 class="mb-5">Search Results</h4>

                    @if ((Model.Jobs != null && Model.Jobs.Count > 0) || (Model.Trainings != null && Model.Trainings.Count > 0))
                    {
                        @foreach (var data in Model.Jobs)
                        {
                            <div class="card mb-5 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title fw-bold text-primary">@data.JobTitle</h5>
                                    <p class="text-muted">@data.EmployerAddress</p>
                                    <p>@data.JobDescription</p>
                                    <div>
                                        <div class="mb-5">
                                            <small class="text-muted fw-bold d-block mb-1">Required Badges</small>

                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var badge in data.JobRequiredBadge)
                                                {
                                                    <span class="badge required-badge">
                                                        <i class="ki-duotone ki-shield-check me-1">
                                                            <span class="path1"></span>
                                                            <span class="path2"></span>
                                                        </i>
                                                        @badge.Badge
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between mt-3">
                                        <span class="fw-bold">₱@data.SalaryMin.ToString("N0") - ₱@data.SalaryMax.ToString("N0") / month</span>
                                        @if (data.AlreadyApplied)
                                        {
                                            <button class="btn btn-sm btn-light-success" disabled>
                                                Applied <i class="ki-duotone ki-double-check">
                                                    <span class="path1"></span>
                                                    <span class="path2"></span>
                                                </i>
                                            </button>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-light-primary" asp-controller="Employee" asp-action="JobInfo" asp-route-Id="@data.Id">Apply Now</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        @foreach (var data in Model.Trainings)
                        {
                            <div class="card mb-5 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title fw-bold text-primary">@data.Name</h5>
                                    <p class="text-muted">@data.EmployerAddress</p>
                                    <p>@data.TrainingDescription</p>
                                    @if(data.TrainingBadge != null)
                                    {
                                        <div class="mb-5">
                                            <small class="text-muted fw-bold d-block mb-1">Badge Awarded:</small>

                                            <div class="d-flex flex-wrap gap-2">
                                                <span class="badge required-badge">
                                                    <i class="ki-duotone ki-shield-check me-1">
                                                        <span class="path1"></span>
                                                        <span class="path2"></span>
                                                    </i>
                                                    @data.TrainingBadge
                                                </span>
                                            </div>
                                        </div>

                                    }
                                    <div class="d-flex justify-content-between mt-3">
                                        <span class="fw-bold">₱@data.Price.ToString("N0") / pesos only</span>
                                        @if (data.AlreadyApplied)
                                        {
                                            <button class="btn btn-sm btn-light-success" disabled>
                                                Applied <i class="ki-duotone ki-double-check">
                                                    <span class="path1"></span>
                                                    <span class="path2"></span>
                                                </i>
                                            </button>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-light-primary" asp-controller="Employee" asp-action="TrainingInfo" asp-route-Id="@data.Id">Apply Now</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center fst-italic fw-bold">
                            <p>No job/training posted yet</p>
                        </div>
                    }

                    <!-- Pagination -->
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@(Model.CurrentPage - 1)"
                                       asp-route-keyword="@Model.Keyword"
                                       asp-route-location="@Model.Location">Previous</a>
                                </li>
                            }

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-keyword="@Model.Keyword"
                                       asp-route-location="@Model.Location">@i</a>
                                </li>
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@(Model.CurrentPage + 1)"
                                       asp-route-keyword="@Model.Keyword"
                                       asp-route-location="@Model.Location">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
