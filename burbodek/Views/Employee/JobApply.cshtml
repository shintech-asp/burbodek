							<label class="fs-6 fw-semibold mb-2 required">Application</label>
							<textarea class="form-control form-control-solid" rows="4" name="ApplicationLetter" placeholder=""></textarea>
						</div>
						<!--end::Input group-->
					}

					<!-- Upload Media -->
					@if (Model.Jobs.JobUploads != null)
					{
						var uploadsList = Model.Jobs.JobUploads.ToList();
						@for (int i = 0; i < uploadsList.Count; i++)
						{
							var data = uploadsList[i];

							<div class="mb-5">
								<label class="form-label fw-bold required">@data.Name</label>

								<div class="card">
									<div class="card-body">
										<input type="hidden" name="Uploads[@i].JobUploadsId" value="@data.Id" />
										<input type="file" class="form-control filepond" name="Uploads[@i].File" accept="image/*,application/pdf" required/>
									</div>
								</div>
							</div>
						}

					}
					<!--begin::Separator-->
					<div class="separator mb-8"></div>
					<!--end::Separator-->
					<!--begin::Submit-->
					<button type="submit" class="btn btn-primary" id="kt_careers_submit_button">
						<!--begin::Indicator label-->
						<span class="indicator-label">Apply Now</span>
						<!--end::Indicator label-->
						<!--begin::Indicator progress-->
						<span class="indicator-progress">
							Please wait...
							<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
						</span>
						<!--end::Indicator progress-->
					</button>
					<!--end::Submit-->
				</form>
