								<label class="required fs-5 fw-semibold mb-2">First Name</label>
								<!--end::Label-->
								<!--begin::Input-->
								<input type="text" class="form-control form-control-solid" placeholder="" name="FirstName" value="@Model.UserProfile?.FirstName" readonly>
								<!--end::Input-->
								<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
							</div>
							<!--end::Col-->
							<!--begin::Col-->
							<div class="col-md-6 fv-row fv-plugins-icon-container">
								<!--end::Label-->
								<label class="required fs-5 fw-semibold mb-2">Last Name</label>
								<!--end::Label-->
								<!--end::Input-->
								<input type="text" class="form-control form-control-solid" placeholder="" name="LastName" value="@Model.UserProfile?.LastName" readonly>
								<!--end::Input-->
								<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
							</div>
							<!--end::Col-->
						</div>
						<!--end::Input group-->
						<!--begin::Input group-->
						<div class="row mb-5">
							<!--begin::Col-->
							<div class="col-md-12 fv-row">
								<!--end::Label-->
								<label class="fs-5 fw-semibold mb-2">Mobile No</label>
								<!--end::Label-->
								<!--end::Input-->
								<input type="text" class="form-control form-control-solid" placeholder="" name="MobileNo" value="@Model.UserProfile?.MobileNo" readonly>
								<!--end::Input-->
							</div>
							<!--end::Col-->
						</div>
						<!--end::Input group-->
						<!--begin::Input group-->
						<div class="row mb-5">
							<!--begin::Col-->
							<div class="col-md-6 fv-row fv-plugins-icon-container">
								<!--begin::Label-->
								<label class="required fs-5 fw-semibold mb-2">Age</label>
