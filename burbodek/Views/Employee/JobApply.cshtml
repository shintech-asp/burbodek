								@{
									int? age = null;

									if (Model.UserProfile.Birthdate.HasValue)
									{
										var birthdate = Model.UserProfile.Birthdate.Value;
										var today = DateOnly.FromDateTime(DateTime.Today);

										age = today.Year - birthdate.Year;

										if (today < birthdate.AddYears(age.Value))
										{
											age--;
										}
									}
								}

								<input type="text" class="form-control form-control-solid" placeholder="" name="Age" value="@(age.HasValue? age: "")" readonly>
								<!--end::Input-->
								<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
							</div>
							<!--end::Col-->
							<!--begin::Col-->
							<div class="col-md-6 fv-row fv-plugins-icon-container">
								<!--end::Label-->
								<label class="required fs-5 fw-semibold mb-2">City</label>
								<!--end::Label-->
								<!--end::Input-->
								<input type="text" class="form-control form-control-solid" placeholder="" name="City" value="@Model.UserProfile?.City" readonly>
								<!--end::Input-->
								<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
							</div>
							<!--end::Col-->
						</div>
						<!--end::Input group-->
					}
					else
					{
