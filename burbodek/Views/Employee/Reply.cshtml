@using System.Web
@using System.IO
@using burbodek.Models.ViewModels
@{
    ViewData["Title"] = "Reply";
    Layout = "~/Views/Shared/_LayoutEmployee.cshtml";
}
@model ThreadViewModel

<div class="d-flex flex-column flex-lg-row">
    <!-- Sidebar (unchanged) -->
    <div class="d-none d-lg-flex flex-column flex-lg-row-auto w-100 w-lg-275px" data-kt-drawer="true" data-kt-drawer-name="inbox-aside" data-kt-drawer-activate="{default: true, lg: false}" data-kt-drawer-overlay="true" data-kt-drawer-width="225px" data-kt-drawer-direction="start" data-kt-drawer-toggle="#kt_inbox_aside_toggle">
        <div class="card card-flush mb-0" data-kt-sticky="true" data-kt-sticky-name="inbox-aside-sticky" data-kt-sticky-offset="{default: false, xl: '100px'}" data-kt-sticky-width="{lg: '275px'}" data-kt-sticky-left="auto" data-kt-sticky-top="100px" data-kt-sticky-animation="false" data-kt-sticky-zindex="95">
            <div class="card-body">
                <a asp-controller="Employee" asp-action="Compose" class="btn btn-primary fw-bold w-100 mb-8">New Message</a>

                <div class="menu menu-column menu-rounded menu-state-bg menu-state-title-primary menu-state-icon-primary menu-state-bullet-primary mb-10">
                    <div class="menu-item mb-3"><a asp-action="Message" class="menu-link active"><span class="menu-icon"><i class="ki-duotone ki-sms fs-2 me-3"><span class="path1"></span><span class="path2"></span></i></span><span class="menu-title fw-bold">Inbox</span><span class="badge badge-light-success">@ViewBag.InboxCount</span></a></div>
                    <div class="menu-item mb-3"><a asp-action="MarkedEmail" class="menu-link"><span class="menu-icon"><i class="ki-duotone ki-abstract-23 fs-2 me-3"><span class="path1"></span><span class="path2"></span></i></span><span class="menu-title fw-bold">Marked</span></a></div>
                    <div class="menu-item mb-3"><a asp-action="DraftEmail" span class="menu-link"><span class="menu-icon"><i class="ki-duotone ki-file fs-2 me-3"><span class="path1"></span><span class="path2"></span></i></span><span class="menu-title fw-bold">Draft</span><span class="badge badge-light-warning">@ViewBag.DraftCount</span></a></div>
                    <div class="menu-item mb-3"><a asp-action="EmailSent" class="menu-link"><span class="menu-icon"><i class="ki-duotone ki-send fs-2 me-3"><span class="path1"></span><span class="path2"></span></i></span><span class="menu-title fw-bold">Sent</span></a></div>
                    <div class="menu-item"><a asp-action="TrashedEmail" span class="menu-link"><span class="menu-icon"><i class="ki-duotone ki-trash fs-2 me-3"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span></i></span><span class="menu-title fw-bold">Trash</span></a></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-lg-row-fluid ms-lg-7 ms-xl-10">
        <div class="card">
            <div class="card-header align-items-center py-5 gap-5">
                <!-- Header actions -->
            </div>

            <div class="card-body">
                <h2 class="fw-semibold mb-8">@Model.Subject</h2>

                @foreach (var email in Model.Emails)
                {
                    @if (!email.IsTrashed)
                    {
                        <div data-kt-inbox-message="message_wrapper">
                            <div class="d-flex flex-wrap gap-2 flex-stack cursor-pointer" data-kt-inbox-message="header">
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-50 me-4">
                                        <div class="symbol symbol-35px me-3">
                                            <div class="symbol-label bg-light-primary">
                                                <span class="text-primary">@email.Sender.Username.Substring(0, 1)</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="pe-5">
                                        <div class="d-flex align-items-center flex-wrap gap-1">
                                            <a href="#" class="fw-bold text-gray-900 text-hover-primary">@email.Sender?.Email</a>
                                            <span class="text-muted fw-bold">@email.SentAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                        </div>
                                        <div class="text-muted fw-semibold">
                                            To: @string.Join(", ", email.Recipients.Where(r => r.RecipientType == RecipientType.TO).Select(r => r.Recipient.Email))
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="collapse fade show" data-kt-inbox-message="message">
                                <div class="py-5">@Html.Raw(email.Body)</div>

                                @* Display Attachments *@
                                @if (email.Attachments != null && email.Attachments.Any())
                                {
                                    <div class="mt-5">
                                        <div class="fw-bold text-gray-700 mb-3">
                                            <i class="ki-duotone ki-paper-clip fs-3 me-2">
                                                <span class="path1"></span>
                                                <span class="path2"></span>
                                            </i>
                                            Attachments (@email.Attachments.Count)
                                        </div>
                                        <div class="d-flex flex-wrap gap-3">
                                            @foreach (var attachment in email.Attachments)
                                            {
                                                var extension = System.IO.Path.GetExtension(attachment.FileName)?.ToLower() ?? "";
                                                var imageExtensions = new List<string> { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp" };
                                                var isImage = imageExtensions.Contains(extension);
                                                var fileSize = (attachment.FileSize / 1024.0).ToString("F2");

                                                <div class="border rounded p-3 d-flex align-items-center" style="min-width: 250px;">
                                                    @if (isImage)
                                                    {
                                                        <a href="@attachment.FilePath" target="_blank" class="d-flex align-items-center text-decoration-none flex-grow-1 gap-3">
                                                            <div style="width: 60px; height: 60px; flex-shrink: 0;">
                                                                <img src="@attachment.FilePath" alt="@attachment.FileName" class="w-100 h-100 object-fit-cover rounded" />
                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <div class="fw-bold text-gray-800">@attachment.FileName</div>
                                                                <div class="text-muted fs-7">@fileSize KB</div>
                                                            </div>
                                                            <div style="width: 30px; flex-shrink: 0;">
                                                                <i class="ki-duotone ki-eye fs-2 text-primary">
                                                                    <span class="path1"></span>
                                                                    <span class="path2"></span>
                                                                    <span class="path3"></span>
                                                                </i>
                                                            </div>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a href="@attachment.FilePath" download="@attachment.FileName" class="d-flex align-items-center text-decoration-none flex-grow-1">
                                                            <i class="ki-duotone ki-file fs-3x me-3 text-primary">
                                                                <span class="path1"></span>
                                                                <span class="path2"></span>
                                                            </i>
                                                            <div class="flex-grow-1">
                                                                <div class="fw-bold text-gray-800">@attachment.FileName</div>
                                                                <div class="text-muted fs-7">@fileSize KB</div>
                                                            </div>
                                                            <i class="ki-duotone ki-download fs-2 text-success">
                                                                <span class="path1"></span>
                                                                <span class="path2"></span>
                                                            </i>
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="separator my-6"></div>
                    }
                    
                }

                <!-- REPLY FORM -->
                <form id="kt_inbox_reply_form"
                      asp-action="ReplyEmail"
                      asp-controller="Employee"
                      method="post"
                      enctype="multipart/form-data">

                    <input type="hidden" name="Id" value="@Model.ThreadID" />
                    <input type="hidden" name="Subject" />
                    <input type="hidden" name="Body" />
                    <input type="hidden" name="ToRecipients" />
                    <input type="hidden" name="CcRecipients" />
                    <input type="hidden" name="BccRecipients" />

                    <div class="d-block">
                        <!-- To -->
                        <div class="d-flex align-items-center border-bottom px-8 min-h-50px">
                            <div class="text-gray-900 fw-bold w-75px">To:</div>
                            <input type="text"
                                   class="form-control border-0"
                                   name="compose_to"
                                   value="@(ViewBag.ReplyData?.ToRecipients != null ? string.Join(", ", ((IEnumerable<dynamic>)ViewBag.ReplyData.ToRecipients).Select(r => r.email)) : "")"
                                   data-kt-inbox-form="tagify"
                                   tabindex="-1">
                            <div class="ms-auto w-75px text-end">
                                <span class="text-muted fs-bold cursor-pointer text-hover-primary me-2" data-kt-inbox-form="cc_button">Cc</span>
                                <span class="text-muted fs-bold cursor-pointer text-hover-primary" data-kt-inbox-form="bcc_button">Bcc</span>
                            </div>
                        </div>

                        <!-- CC -->
                        @{
                            var hasCc = ViewBag.ReplyData?.CcRecipients != null && ((IEnumerable<dynamic>)ViewBag.ReplyData.CcRecipients).Any();
                        }
                        <div class="@(hasCc ? "d-flex" : "d-none") align-items-center border-bottom ps-8 pe-5 min-h-50px" data-kt-inbox-form="cc">
                            <div class="text-gray-900 fw-bold w-75px">Cc:</div>
                            <input type="text"
                                   class="form-control border-0"
                                   name="compose_cc"
                                   value="@(hasCc ? string.Join(", ", ((IEnumerable<dynamic>)ViewBag.ReplyData.CcRecipients).Select(r => r.email)) : "")"
                                   data-kt-inbox-form="tagify"
                                   tabindex="-1">
                            <span class="btn btn-clean btn-xs btn-icon" data-kt-inbox-form="cc_close">
                                <i class="ki-duotone ki-cross fs-5"><span class="path1"></span><span class="path2"></span></i>
                            </span>
                        </div>

                        <!-- BCC -->
                        @{
                            var hasBcc = ViewBag.ReplyData?.BccRecipients != null && ((IEnumerable<dynamic>)ViewBag.ReplyData.BccRecipients).Any();
                        }
                        <div class="@(hasBcc ? "d-flex" : "d-none") align-items-center border-bottom ps-8 pe-5 min-h-50px" data-kt-inbox-form="bcc">
                            <div class="text-gray-900 fw-bold w-75px">Bcc:</div>
                            <input type="text"
                                   class="form-control border-0"
                                   name="compose_bcc"
                                   value="@(hasBcc ? string.Join(", ", ((IEnumerable<dynamic>)ViewBag.ReplyData.BccRecipients).Select(r => r.email)) : "")"
                                   data-kt-inbox-form="tagify"
                                   tabindex="-1">
                            <span class="btn btn-clean btn-xs btn-icon" data-kt-inbox-form="bcc_close">
                                <i class="ki-duotone ki-cross fs-5"><span class="path1"></span><span class="path2"></span></i>
                            </span>
                        </div>

                        <!-- Subject -->
                        <div class="d-flex align-items-center border-bottom px-8 min-h-50px">
                            <input type="text"
                                   class="form-control border-0 px-0"
                                   name="compose_subject"
                                   placeholder="Subject"
                                   value="@ViewBag.ReplyData?.ReplySubject">
                        </div>

                        <!-- Quill Editor -->
                        <div id="kt_inbox_form_editor" class="h-300px"></div>

                        <!--begin::Attachments-->
                        <div class="dropzone dropzone-queue px-8 pt-4 pb-0" id="kt_inbox_reply_attachments" data-kt-inbox-form="dropzone">
                            <div class="dropzone-items pb-0"></div>
                        </div>
                        <!--end::Attachments-->
                    </div>

                    <!-- Footer -->
                    <div class="d-flex flex-stack flex-wrap gap-2 py-5 ps-8 pe-5 border-top">
                        <div class="d-flex align-items-center me-3">
                            <button type="submit" class="btn btn-primary fs-bold px-6" data-kt-inbox-form="send">
                                <span class="indicator-label">Send</span>
                                <span class="indicator-progress">Please wait... <span class="spinner-border spinner-border-sm align-middle ms-2"></span></span>
                            </button>
                            <span class="btn btn-icon btn-sm btn-clean btn-active-light-primary me-2" id="kt_inbox_reply_attachments_select" style="cursor: pointer;">
                                <i class="ki-duotone ki-paper-clip fs-2"></i>
                            </span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="btn btn-icon btn-sm btn-clean btn-active-light-primary" data-inbox="dismiss">
                                <i class="ki-duotone ki-trash fs-2"></i>
                            </span>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <!-- Tagify -->
    <script src="https://cdn.jsdelivr.net/npm/@@yaireo/tagify"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@yaireo/tagify/dist/tagify.css">

    <!-- Quill -->
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

    <!-- Dropzone -->
    <script src="https://cdn.jsdelivr.net/npm/dropzone@5/dist/min/dropzone.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/dropzone@5/dist/min/dropzone.min.css" rel="stylesheet">

    <script>
        $(function () {
            const data = @Html.Raw(Json.Serialize(ViewBag.ReplyData));

            // Initialize Quill
            var quill = new Quill('#kt_inbox_form_editor', { theme: 'snow' });

            // Add original email quote
            if (data && data.OriginalBody) {
                setTimeout(() => {
                    const quote = `<br><br><div style="border-left:3px solid #ccc;padding-left:12px;margin:16px 0;color:#666;font-size:0.9em;">
                        <p><strong>On ${data.OriginalSentAt}, ${data.OriginalSenderName} wrote:</strong></p>
                        <div>${data.OriginalBody}</div>
                    </div>`;
                    quill.clipboard.dangerouslyPasteHTML(quill.getLength(), quote);
                    quill.setSelection(0, 0);
                }, 300);
            }

            // Initialize Tagify with AJAX search
            function initTagify(selector) {
                const input = document.querySelector(selector);

                if (!input) return null;

                const tagify = new Tagify(input, {
                    whitelist: [],
                    enforceWhitelist: false,
                    maxTags: 30,
                    dropdown: {
                        maxItems: 20,
                        classname: "tags-look",
                        enabled: 0,
                        closeOnSelect: false
                    }
                });

                let controller;

                tagify.on('input', onInput);

                function onInput(e) {
                    const value = e.detail.value;
                    tagify.whitelist = null;

                    if (value.length < 2) return;

                    if (controller) controller.abort();
                    controller = new AbortController();

                    tagify.loading(true).dropdown.hide();

                    fetch('/Employee/SearchUsers?query=' + encodeURIComponent(value), {
                        signal: controller.signal
                    })
                    .then(RES => RES.json())
                    .then(function(newWhitelist) {
                        const transformedList = newWhitelist.map(item => ({
                            value: `${item.fullName} <${item.email}>`,
                            searchBy: `${item.fullName} ${item.email}`,
                            name: item.fullName,
                            email: item.email
                        }));

                        tagify.whitelist = transformedList;
                        tagify.loading(false).dropdown.show(value);
                    })
                    .catch(err => {
                        if (err.name !== 'AbortError') {
                            console.error('Search error:', err);
                        }
                        tagify.loading(false);
                    });
                }

                return tagify;
            }

            var toTagify = initTagify('input[name="compose_to"]');
            var ccTagify = initTagify('input[name="compose_cc"]');
            var bccTagify = initTagify('input[name="compose_bcc"]');

            // CC/BCC toggles
            $('[data-kt-inbox-form="cc_button"]').click(function(e) {
                e.preventDefault();
                $('[data-kt-inbox-form="cc"]').removeClass('d-none').addClass('d-flex');
            });

            $('[data-kt-inbox-form="bcc_button"]').click(function(e) {
                e.preventDefault();
                $('[data-kt-inbox-form="bcc"]').removeClass('d-none').addClass('d-flex');
            });

            $('[data-kt-inbox-form="cc_close"]').click(function(e) {
                e.preventDefault();
                $('[data-kt-inbox-form="cc"]').removeClass('d-flex').addClass('d-none');
                if (ccTagify) ccTagify.removeAllTags();
            });

            $('[data-kt-inbox-form="bcc_close"]').click(function(e) {
                e.preventDefault();
                $('[data-kt-inbox-form="bcc"]').removeClass('d-flex').addClass('d-none');
                if (bccTagify) bccTagify.removeAllTags();
            });

            // Dropzone setup - File upload handling
            Dropzone.autoDiscover = false;
            
            // Create a programmatic dropzone attached to the paperclip button
            const attachmentBtn = document.querySelector('#kt_inbox_reply_attachments_select');
            const form = document.querySelector('#kt_inbox_reply_form');
            
            // Create hidden file input
            const fileInput = document.createElement('input');
            fileInput.type = 'file';
            fileInput.multiple = true;
            fileInput.style.display = 'none';
            fileInput.name = 'files';
            form.appendChild(fileInput);
            
            // Store selected files
            let selectedFiles = [];
            
            // Click paperclip to open file selector
            if (attachmentBtn) {
                attachmentBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    fileInput.click();
                });
            }
            
            // Handle file selection
            fileInput.addEventListener('change', function(e) {
                const files = Array.from(e.target.files);
                selectedFiles = selectedFiles.concat(files);
                displayAttachments();
            });

            function displayAttachments() {
                let container = dropzoneContainer.querySelector('.dropzone-items');

                if (!container) return;

                container.innerHTML = ''; // Clear previous items

                selectedFiles.forEach((file, index) => {
                    const fileSize = (file.size / 1024).toFixed(1); // KB
                    const item = document.createElement('div');
                    item.classList.add('dropzone-item', 'border', 'rounded', 'mb-2', 'd-flex', 'align-items-center');
                    item.innerHTML = `
                        <i class="ki-duotone ki-file fs-2 me-3">
                            <span class="path1"></span><span class="path2"></span>
                        </i>
                        <div class="flex-grow-1">
                            <div class="fw-bold">${file.name}</div>
                            <div class="text-muted fs-7">${fileSize} KB</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-icon btn-light-danger remove-file" data-file-index="${index}">
                            <i class="ki-duotone ki-cross fs-2"><span class="path1"></span><span class="path2"></span></i>
                        </button>
                    `;
                    container.appendChild(item);
                });

                // Add remove handlers
                container.querySelectorAll('.remove-file').forEach(btn => {
                    btn.addEventListener('click', function () {
                        const index = parseInt(this.dataset.fileIndex);
                        selectedFiles.splice(index, 1);
                        displayAttachments();
                    });
                });
            }

            // Form Submit Handler
            $('#kt_inbox_reply_form').on('submit', function (e) {
                e.preventDefault();

                // Get Quill content
                $('input[name="Body"]').val(quill.root.innerHTML);

                // Parse Tagify data to extract emails only
                if (toTagify && toTagify.value.length > 0) {
                    const toEmails = toTagify.value.map(tag => {
                        const match = tag.value.match(/<(.+?)>/);
                        return match ? match[1] : tag.email || tag.value;
                    });
                    $('input[name="ToRecipients"]').val(toEmails.join(','));
                } else {
                    $('input[name="ToRecipients"]').val('');
                }

                if (ccTagify && ccTagify.value.length > 0) {
                    const ccEmails = ccTagify.value.map(tag => {
                        const match = tag.value.match(/<(.+?)>/);
                        return match ? match[1] : tag.email || tag.value;
                    });
                    $('input[name="CcRecipients"]').val(ccEmails.join(','));
                } else {
                    $('input[name="CcRecipients"]').val('');
                }

                if (bccTagify && bccTagify.value.length > 0) {
                    const bccEmails = bccTagify.value.map(tag => {
                        const match = tag.value.match(/<(.+?)>/);
                        return match ? match[1] : tag.email || tag.value;
                    });
                    $('input[name="BccRecipients"]').val(bccEmails.join(','));
                } else {
                    $('input[name="BccRecipients"]').val('');
                }

                // Get subject
                const subjectValue = $('input[name="compose_subject"]').val() || (data ? data.ReplySubject : '');
                $('input[name="Subject"]').val(subjectValue);

                // Debug log
                console.log('Form Data:', {
                    Id: $('input[name="Id"]').val(),
                    ToRecipients: $('input[name="ToRecipients"]').val(),
                    CcRecipients: $('input[name="CcRecipients"]').val(),
                    BccRecipients: $('input[name="BccRecipients"]').val(),
                    Subject: $('input[name="Subject"]').val(),
                    Body: $('input[name="Body"]').val().substring(0, 100),
                    Files: selectedFiles.length
                });

                // Validate
                if (!$('input[name="ToRecipients"]').val()) {
                    alert('Please add at least one recipient');
                    return false;
                }

                // If there are files, create FormData and submit via AJAX
                if (selectedFiles.length > 0) {
                    const formData = new FormData(this);
                    
                    // Remove the hidden file input files and add selected files
                    formData.delete('files');
                    selectedFiles.forEach(file => {
                        formData.append('files', file);
                    });

                    // Submit via AJAX
                    $.ajax({
                        url: $(this).attr('action'),
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function(response) {
                            window.location.href = '/Employee/Reply/' + $('input[name="Id"]').val();
                        },
                        error: function(xhr, status, error) {
                            alert('Error sending email: ' + error);
                            $('[data-kt-inbox-form="send"]')
                                .removeClass('disabled')
                                .find('.indicator-label').show()
                                .end()
                                .find('.indicator-progress').hide();
                        }
                    });
                } else {
                    // No files, submit normally
                    this.submit();
                }
            });

            // Send Button Loading State
            $('[data-kt-inbox-form="send"]').on('click', function () {
                $(this).addClass('disabled')
                       .find('.indicator-label').hide()
                       .end()
                       .find('.indicator-progress').show();
            });
        });
    </script>
}