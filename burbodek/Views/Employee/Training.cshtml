@using Humanizer
@model List<TrainingApplication>;
@{
    ViewData["Title"] = "My Training";
    Layout = "~/Views/Shared/_LayoutEmployee.cshtml";
    // int totalPending = Model.Count(a => a.Status == "Applied");
    // int totalApplication = Model.Count();
    // int totalInterview = Model.Count(a => a.Status == "Interview");
    // int totalRejected = Model.Count(a => a.Status == "Rejected");

}

<div class="container-xxl" id="kt_content_container">

    <!-- 🔹 Stats Section -->
    <div class="row mb-8">

        <!-- Total Applied -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h3 class="fw-bold">@ViewBag.TotalTraining</h3>
                    <p class="text-muted mb-0">Total Trainings</p>
                </div>
            </div>
        </div>

        <!-- Shortlisted -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h3 class="fw-bold text-primary">@ViewBag.TotalOngoing</h3>
                    <p class="text-muted mb-0">Ongoing</p>
                </div>
            </div>
        </div>

        <!-- Pending -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h3 class="fw-bold text-success">@ViewBag.TotalCompleted</h3>
                    <p class="text-muted mb-0">Completed</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 🔹 Applications Table -->
    <div class="card">
        <div class="card-header border-0 pt-6">
            <h2 class="fw-bold">My Applied Training</h2>
        </div>

        <div class="card-body pt-0">
            <div class="table-responsive">
                <table class="table align-middle table-row-dashed gy-5">
                    <thead>
                        <tr class="fw-bold text-muted">
                            <th class="min-w-200px">Training</th>
                            <th class="min-w-150px">Company</th>
                            <th class="min-w-120px">Applied Date</th>
                            <th class="min-w-100px">Status</th>
                            <th class="min-w-200px text-center">Actions</th>
                        </tr>
                    </thead>
                    @if (Model.Count > 0)
                    {
                        <tbody>
                            <!-- Row Example -->
                            @foreach (var data in Model)
                            {

                                <tr>
                                    <td><a asp-action="TrainingInfo" asp-route-Id="@data.TrainingId" class="text-dark fw-bold text-hover-primary fs-6">@data.Training.Name</a></td>
                                    <td>@data.Training.Users.Username</td>
                                    <td>
                                        @data.CreatedAt.ToString("MMMM dd yyyy")
                                    </td>
                                    @{
                                        string badge;
                                        string date;
                                        if (data.Training.StartDate == null)
                                        {
                                            badge = "badge-light-primary";
                                            date = "No start date yet";
                                        }
                                        else if (data.Training.StartDate > DateTime.Now)
                                        {
                                            badge = "badge-light-info";
                                            date = "Will start in " + data.Training.StartDate.Humanize();
                                        }
                                        else if (data.Training.StartDate <= DateTime.Now && data.Training.EndDate >= DateTime.Now)
                                        {
                                            badge = "badge-light-success";
                                            date = "Will end in " + data.Training.EndDate.Humanize();
                                        }
                                        else if (data.Training.EndDate < DateTime.Now)
                                        {
                                            badge = "badge-light-success";
                                            date = "Training ended! Check your certification under view details";
                                        }
                                        else
                                        {
                                            badge = "badge-light-danger";
                                            date = "No stated yet";
                                        }
                                    }
                                    <td><span class="badge @badge">@date</span></td>
                                    <td class="text-center">
                                        <a asp-action="TrainingApplicationDetails" asp-controller="Employee" asp-route-Id="@data.Training.Id" class="btn btn-sm btn-light btn-active-light-primary me-2">View Details</a>
                                    </td>
                                </tr>
                            }
                            <!-- Add more rows as needed -->
                        </tbody>
                    }
                    else
                    {
                        <tbody>
                            <tr>
                                <td class="text-center fst-italic" colspan="5">No jobs applied</td>
                            </tr>
                        </tbody>
                    }

                </table>
            </div>
        </div>
    </div>
</div>
