@{
	ViewData["Title"] = "Application Details";
	Layout = "~/Views/Shared/_LayoutEmployee.cshtml";
}
@using Humanizer
@model Training;
<div class="card">
	<!--begin::Body-->
	<div class="card-body p-lg-17">
		<!--begin::Hero-->
		@{
			string[] videoExtensions = new[] { ".mp4", ".webm", ".ogg", ".mov" };
		}

		<style>
			.job-media-item {
				width: 100%;
				height: 450px; /* fixed landscape height */
				object-fit: cover; /* crop & center */
				border-radius: 12px;
			}
		</style>

		<div class="position-relative mb-17">
			<div id="jobMediaCarousel" class="carousel slide card-rounded overflow-hidden" data-bs-ride="false">
				<div class="carousel-inner">
					@if (Model.TrainingMedia != null && Model.TrainingMedia.Any())
					{
						var index = 0;
						foreach (var media in Model.TrainingMedia)
						{
							var isActive = index == 0 ? "active" : "";
							var ext = System.IO.Path.GetExtension(media.FilePath)?.ToLower();

							<div class="carousel-item @isActive">
								@if (!string.IsNullOrEmpty(ext) && videoExtensions.Contains(ext))
								{
									<!-- Video -->
									<video class="d-block job-media-item"
										   loop playsinline muted>
										<source src="@Url.Content(media.FilePath)" type="video/mp4">
										Your browser does not support the video tag.
									</video>
								}
								else
								{
									<!-- Image -->
									<img src="@Url.Content(media.FilePath)" class="d-block job-media-item" alt="Job Media" />
								}
							</div>
							index++;
						}
					}
					else
					{
						<!-- Fallback if no media -->
						<div class="carousel-item active">
							<div class="job-media-item d-flex align-items-center justify-content-center bg-light text-muted">
								No media available
							</div>
						</div>
					}
				</div>

				<!-- Controls -->
				<button class="carousel-control-prev" type="button" data-bs-target="#jobMediaCarousel" data-bs-slide="prev">
					<span class="carousel-control-prev-icon"></span>
				</button>
				<button class="carousel-control-next" type="button" data-bs-target="#jobMediaCarousel" data-bs-slide="next">
					<span class="carousel-control-next-icon"></span>
				</button>
			</div>

			<!-- Overlay -->
			<div class="overlay-layer rounded bg-black position-absolute top-0 start-0 w-100 h-100" style="opacity: 0.4"></div>

			<!-- Business Info -->
			<div class="position-absolute text-white mb-8 ms-10 bottom-0">
				<h3 class="text-white fs-2qx fw-bold mb-3">@Model.Users.EmployerDetails?.BusinessName</h3>
				<div class="fs-5 fw-semibold">@Model.Users.EmployerDetails?.BusinessDescription</div>
			</div>
		</div>
		<!--begin::Layout-->
		<!--begin::Layout-->
		<div class="d-flex flex-column flex-lg-row mb-17">
			<!--begin::Content-->
			<div class="flex-lg-row-fluid me-0 me-lg-20">
				<!--begin::Form-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--begin::Label-->
						<label class="required fs-5 fw-semibold mb-2">First Name</label>
						<!--end::Label-->
						<!--begin::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="FirstName" value="@Model.TrainingApplication?.FirstOrDefault()?.FirstName" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--end::Label-->
						<label class="required fs-5 fw-semibold mb-2">Last Name</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="LastName" value="@Model.TrainingApplication?.FirstOrDefault()?.LastName" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-6 fv-row">
						<!--end::Label-->
						<label class="fs-5 fw-semibold mb-2">Mobile No</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="MobileNo" value="@Model.TrainingApplication?.FirstOrDefault()?.MobileNo" readonly>
						<!--end::Input-->
					</div>
					<!--end::Col-->
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--begin::Label-->
						<label class="required fs-5 fw-semibold mb-2">Age</label>
						<!--end::Label-->
						<!--begin::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="Age" value="@Model.TrainingApplication?.FirstOrDefault()?.Age" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--end::Label-->
						<label class="required fs-5 fw-semibold mb-2">City</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="City" value="@Model.TrainingApplication?.FirstOrDefault()?.City" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--end::Label-->
						<div class="mb-3">
							<label class="form-label">Start date status</label>
						</div>
						<!--end::Label-->
						<!--end::Input-->
						<span class="badge badge-info">
							<p>@(Model.StartDate != null ? Model.StartDate.Humanize() : "No start date yet")</p>
						</span>
					</div>
				</div>
				<!--end::Input group-->
				<!-- Upload Media -->
				@if (Model.Coe)
				{
					<div class="mb-5">
						<div>
							<label class="form-label fw-bold required">Certificate of Employment</label>
						</div>
						<div class="card">
							<div class="card-body">
								<input type="file" class="form-control filepond" name="CoeFile" accept="image/*,application/pdf" data-default-file="@Model.TrainingApplication?.FirstOrDefault()?.Coe" />
							</div>
						</div>
					</div>
				}
				@if (Model.Tor)
				{
					<div class="mb-5">
						<div>
							<label class="form-label fw-bold required">Transcript of Records</label>
						</div>
						<div class="card">
							<div class="card-body">
								<input type="file" class="form-control filepond" name="TorFile" accept="image/*,application/pdf" data-default-file="@Model.TrainingApplication?.FirstOrDefault()?.Tor" />
							</div>
						</div>
					</div>
				}
				@if (Model.Diploma)
				{
					<div class="mb-5">
						<div>
							<label class="form-label fw-bold required">Diploma</label>
						</div>
						<div class="card">
							<div class="card-body">
								<input type="file" class="form-control filepond" name="DiplomaFile" accept="image/*,application/pdf" data-default-file="@Model.TrainingApplication?.FirstOrDefault()?.Diploma" />
							</div>
						</div>
					</div>
				}
				@if (Model.PassportId)
				{
					<div class="mb-5">
						<div>
							<label class="form-label fw-bold required">Passport Id</label>
						</div>
						<div class="card">
							<div class="card-body">
								<input type="file" class="form-control filepond" name="PassportIdFile" accept="image/*,application/pdf" data-default-file="@Model.TrainingApplication?.FirstOrDefault()?.PassportId" />
							</div>
						</div>
					</div>
				}
				@if (Model.Resume)
				{
					<div class="mb-5">
						<div>
							<label class="form-label fw-bold required">Resume</label>
						</div>
						<div class="card">
							<div class="card-body">
								<input type="file" class="form-control filepond" name="ResumeFile" accept="image/*,application/pdf" data-default-file="@Model.TrainingApplication?.FirstOrDefault()?.Resume" />
							</div>
						</div>
					</div>
				}
				@if (Model.SeamansBook)
				{
					<div class="mb-5">
						<div>
							<label class="form-label fw-bold required">Seaman's Book</label>
						</div>
						<div class="card">
							<div class="card-body">
								<input type="file" class="form-control filepond" name="SeamansBookFile" accept="image/*,application/pdf" data-default-file="@Model.TrainingApplication?.FirstOrDefault()?.SeamansBook" />
							</div>
						</div>
					</div>
				}

					<!--begin::Separator-->
					<div class="separator mb-8"></div>
					<!--end::Separator-->
					<a class="btn btn-secondary" asp-controller="Employer" asp-action="JobDetails" asp-route-Id="@Model.Id">Back</a>
					@if (Model.TrainingApplication.Any())
					{
						@if(Model.TrainingApplication.FirstOrDefault().TrainingCertificate.Count > 0)
						{
							<button class="btn btn-info" data-bs-toggle="modal" data-bs-target="#fileUploadModal">View certificate</button>
						
						}
					}
			</div>
			<!--end::Content-->
		</div>
		<!--end::Layout-->
	</div>
	<!--end::Body-->
</div>
<div class="modal fade" id="fileUploadModal" tabindex="-1" aria-labelledby="fileUploadModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="fileUploadModalLabel">View or Download Certificate</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div class="mb-5">
					<div>
						<label class="form-label fw-bold required">Certificate of Completion</label>
					</div>
					<div class="card">
						<div class="card-body">
							@if (Model.TrainingApplication.Any())
							{
								var cert = Model.TrainingApplication.FirstOrDefault().TrainingCertificate.FirstOrDefault();
								if (cert != null)
								{
									<input type="file"
										   class="form-control filepond"
										   name="SeamansBookFile"
										   accept="image/*,application/pdf"
										   data-default-file="@cert.FilePath"
										   id="certificateFile"
										   data-filepath="@cert.FilePath"
										   disabled />
								}
								else
								{
									<p class="text-muted">No certificate uploaded yet.</p>
								}
							}
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
				<button type="button" class="btn btn-success" id="downloadCertificate">Download</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<style>
		.filepond--image-preview-wrapper {
			cursor: zoom-in;
			transition: transform 0.3s ease;
		}

			.filepond--image-preview-wrapper:hover img {
				transform: scale(1.1);
			}

		/* Full screen overlay for click */
		.image-zoom-overlay {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: rgba(0, 0, 0, 0.9);
			z-index: 9999;
			cursor: zoom-out;
			justify-content: center;
			align-items: center;
		}

			.image-zoom-overlay.active {
				display: flex;
			}

			.image-zoom-overlay img {
				max-width: 90%;
				max-height: 90%;
				object-fit: contain;
			}
	</style>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const fileInput = document.getElementById('certificateFile');
			const storedFilePath = fileInput?.dataset.filepath || fileInput?.getAttribute('data-filepath');

			$('#downloadCertificate').on('click', function () {
				// Use the stored filepath
				const filePath = storedFilePath;

				if (!filePath) {
					Swal.fire('No File', 'No certificate file available to download.', 'warning');
					return;
				}

				Swal.fire({
					title: 'Download Certificate?',
					text: 'Would you like to download this certificate?',
					icon: 'question',
					showCancelButton: true,
					confirmButtonText: 'Yes, download',
					cancelButtonText: 'Cancel'
				}).then((result) => {
					if (result.isConfirmed) {
						// Create a temporary link element
						const link = document.createElement('a');
						link.href = filePath;

						// Extract filename from path
						const fileName = filePath.split('/').pop() || 'certificate.pdf';
						link.download = fileName;

						// Force download by setting target
						link.target = '_blank';

						// Append to body, click, and remove
						document.body.appendChild(link);
						link.click();
						document.body.removeChild(link);

						Swal.fire('Started!', 'Your download has started.', 'success');
					}
				});
			});

			FilePond.registerPlugin(
				FilePondPluginImagePreview,
				FilePondPluginPdfPreview
			);

			FilePond.setOptions({
				allowMultiple: false,
				acceptedFileTypes: ['image/*', 'application/pdf'],
				fileValidateTypeLabelExpectedTypes: 'Expects an image or PDF',
				allowImagePreview: true,
				allowPdfPreview: true,
				pdfPreviewHeight: 240,
				pdfComponentExtraParams: 'toolbar=0&navpanes=0&scrollbar=0&view=fitH&page=1',
				server: null,
				storeAsFile: true,
				chunkUploads: false,
				allowReorder: false,
				allowRemove: false,
				allowReplace: false,
				instantUpload: false,
				allowRevert: false
			});

			// Create overlay element
			const overlay = document.createElement('div');
			overlay.className = 'image-zoom-overlay';
			overlay.innerHTML = '<img src="" alt="Zoomed image">';
			document.body.appendChild(overlay);

			overlay.addEventListener('click', () => {
				overlay.classList.remove('active');
			});

			const inputs = document.querySelectorAll('.filepond');
			inputs.forEach(input => {
				const pond = FilePond.create(input);
				const defaultFile = input.dataset.defaultFile;

				if (defaultFile) {
					pond.addFile(defaultFile);
				}

				pond.on('addfile', (error, file) => {
					if (error) {
						alert('Invalid file: Only images and PDFs allowed.');
					}

					// Add zoom for images
					if (!error && file.file.type.startsWith('image/')) {
						setTimeout(() => {
							const wrapper = pond.element.querySelector('.filepond--image-preview-wrapper');
							if (wrapper) {
								wrapper.addEventListener('click', (e) => {
									e.preventDefault();
									e.stopPropagation();

									const imgSrc = file.source || URL.createObjectURL(file.file);
									overlay.querySelector('img').src = imgSrc;
									overlay.classList.add('active');
								});
							}
						}, 100);
					}
				});
			});
		});
	</script>
}