@using Humanizer
@using System.Globalization
@using burbodek.Models.ViewModels
@{
	ViewData["Title"] = "Training Information";
	Layout = "~/Views/Shared/_LayoutEmployee.cshtml";
}
@model TrainingInfoViewModel
<div class="card">
	<!--begin::Body-->
	<div class="card-body p-lg-17">
		<!--begin::Hero-->
		@{
			string[] videoExtensions = new[] { ".mp4", ".webm", ".ogg", ".mov" };
		}

		<style>
			.job-media-item {
				width: 100%;
				height: 450px; /* fixed landscape height */
				object-fit: cover; /* crop & center */
				border-radius: 12px;
			}

			.line-clamp-3 {
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
		</style>

		<div class="position-relative mb-17">
			<div id="jobMediaCarousel" class="carousel slide card-rounded overflow-hidden" data-bs-ride="false">
				<div class="carousel-inner">
					@if (Model.Training.TrainingMedia != null && Model.Training.TrainingMedia.Any())
					{
						var index = 0;
						foreach (var media in Model.Training.TrainingMedia)
						{
							var isActive = index == 0 ? "active" : "";
							var ext = System.IO.Path.GetExtension(media.FilePath)?.ToLower();

							<div class="carousel-item @isActive">
								@if (!string.IsNullOrEmpty(ext) && videoExtensions.Contains(ext))
								{
									<!-- Video -->
									<video class="d-block job-media-item"
										   loop playsinline muted>
										<source src="@Url.Content(media.FilePath)" type="video/mp4">
										Your browser does not support the video tag.
									</video>
								}
								else
								{
									<!-- Image -->
									<img src="@Url.Content(media.FilePath)" class="d-block job-media-item" alt="Job Media" />
								}
							</div>
							index++;
						}
					}
					else
					{
						<!-- Fallback if no media -->
						<div class="carousel-item active">
							<div class="job-media-item d-flex align-items-center justify-content-center bg-light text-muted">
								No media available
							</div>
						</div>
					}
				</div>

				<!-- Controls -->
				<button class="carousel-control-prev" type="button" data-bs-target="#jobMediaCarousel" data-bs-slide="prev">
					<span class="carousel-control-prev-icon"></span>
				</button>
				<button class="carousel-control-next" type="button" data-bs-target="#jobMediaCarousel" data-bs-slide="next">
					<span class="carousel-control-next-icon"></span>
				</button>
			</div>

			<!-- Overlay -->
			<div class="overlay-layer rounded bg-black position-absolute top-0 start-0 w-100 h-100" style="opacity: 0.4"></div>

			<!-- Business Info -->
			<div class="position-absolute text-white mb-8 ms-10 bottom-0">
				<h3 class="text-white fs-2qx fw-bold mb-3">@Model.Training.Name</h3>
				<div class="fs-5 fw-semibold">@Model.Training.Users.EmployerDetails?.BusinessDescription</div>
			</div>
		</div>
		<!--begin::Layout-->
		<div class="d-flex flex-column flex-lg-row mb-17">
			<!--begin::Content-->
			<div class="flex-lg-row-fluid me-0 me-lg-20">
				<!--begin::Job-->
				<div class="mb-17">
					<!--begin::Description-->
					<div class="m-0">
						<!--begin::Title-->
						<h4 class="fs-1 text-gray-800 w-bolder mb-6">@Model.Training.Name</h4>
						<!--end::Title-->
						<!--begin::Text-->
						<p class="fw-semibold fs-4 text-gray-600 mb-2">Come work with us!</p>
						<!--end::Text-->
					</div>
					<!--end::Description-->
					<!--begin::Accordion-->
					<!--begin::Section-->
					<div class="m-0">
						<!--begin::Heading-->
						<div class="d-flex align-items-center collapsible py-3 toggle mb-0" data-bs-toggle="collapse" data-bs-target="#kt_job_1_1">
							<!--begin::Icon-->
							<div class="btn btn-sm btn-icon mw-20px btn-active-color-primary me-5">
								<i class="ki-duotone ki-minus-square toggle-on text-primary fs-1">
									<span class="path1"></span>
									<span class="path2"></span>
								</i>
								<i class="ki-duotone ki-plus-square toggle-off fs-1">
									<span class="path1"></span>
									<span class="path2"></span>
									<span class="path3"></span>
								</i>
							</div>
							<!--end::Icon-->
							<!--begin::Title-->
							<h4 class="text-gray-700 fw-bold cursor-pointer mb-0">Criteria</h4>
							<!--end::Title-->
						</div>
						<!--end::Heading-->
						<!--begin::Body-->
						<div id="kt_job_1_1" class="collapse show fs-6 ms-1">
							@foreach (var data in Model.Training.TrainingRequirements)
							{
								<!--begin::Item-->
								<div class="mb-4">
									<!--begin::Item-->
									<div class="d-flex align-items-center ps-10 mb-n1">
										<!--begin::Bullet-->
										<span class="bullet me-3"></span>
										<!--end::Bullet-->
										<!--begin::Label-->
										<div class="text-gray-600 fw-semibold fs-6">@data.Requirement</div>
										<!--end::Label-->
									</div>
									<!--end::Item-->
								</div>
								<!--end::Item-->
							}
						</div>
						<!--end::Content-->
						<!--begin::Separator-->
						<div class="separator separator-dashed"></div>
						<!--end::Separator-->
					</div>
					<!--end::Section-->
					<!--begin::Section-->
					<div class="m-0">
						<!--begin::Heading-->
						<div class="d-flex align-items-center collapsible py-3 toggle collapsed mb-0" data-bs-toggle="collapse" data-bs-target="#kt_job_1_3">
							<!--begin::Icon-->
							<div class="btn btn-sm btn-icon mw-20px btn-active-color-primary me-5">
								<i class="ki-duotone ki-minus-square toggle-on text-primary fs-1">
									<span class="path1"></span>
									<span class="path2"></span>
								</i>
								<i class="ki-duotone ki-plus-square toggle-off fs-1">
									<span class="path1"></span>
									<span class="path2"></span>
									<span class="path3"></span>
								</i>
							</div>
							<!--end::Icon-->
							<!--begin::Title-->
							<h4 class="text-gray-700 fw-bold cursor-pointer mb-0">Training Benefits</h4>
							<!--end::Title-->
						</div>
						<!--end::Heading-->
						<!--begin::Body-->
						<div id="kt_job_1_3" class="collapse fs-6 ms-1">
							@foreach (var data in Model.Training.TrainingBenefits)
							{
								<!--begin::Item-->
								<div class="mb-4">
									<!--begin::Item-->
									<div class="d-flex align-items-center ps-10 mb-n1">
										<!--begin::Bullet-->
										<span class="bullet me-3"></span>
										<!--end::Bullet-->
										<!--begin::Label-->
										<div class="text-gray-600 fw-semibold fs-6">@data.Benefit</div>
										<!--end::Label-->
									</div>
									<!--end::Item-->
								</div>
								<!--end::Item-->
							}
						</div>
						<!--end::Content-->
						<!--begin::Separator-->
						<div class="separator separator-dashed"></div>
						<!--end::Separator-->
					</div>
					<!--end::Section-->
					<!--end::Accordion-->
					<!--begin::Apply-->
					@if (Model.Training.TrainingApplication.Any())
					{
						<button class="btn btn-sm btn-light-success mt-5" disabled>
							Applied <i class="ki-duotone ki-double-check">
								<span class="path1"></span>
								<span class="path2"></span>
							</i>
						</button>
					}
					else
					{
						<a asp-controller="Employee" asp-action="TrainingApply" asp-route-Id="@Model.Training.Id" class="btn btn-sm btn-primary mt-5">Apply Now</a>
					}
					<button class="btn btn-sm btn-light-danger mt-5"
							data-bs-toggle="modal"
							data-bs-target="#reportModal">
						<i class="bi bi-exclamation-triangle-fill me-1"></i>
						Report this Training
					</button>
					<!--end::Apply-->
					<div class="modal fade" id="reportModal" tabindex="-1">
						<div class="modal-dialog">
							<div class="modal-content">

								<div class="modal-header bg-light-danger">
									<h5 class="modal-title text-danger">
										<i class="bi bi-exclamation-triangle-fill me-1"></i>
										Report Job / Training Post
									</h5>
									<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
								</div>

								<form method="post" asp-controller="Employee" asp-action="SubmitReport">
									<div class="modal-body">

										<p class="text-muted small">
											Please select the reason why you are reporting this job/training post.
										</p>

										<!-- Radio Options -->
										<div class="form-check mb-2">
											<input class="form-check-input" type="radio" name="Reason" value="Not related to Sea Jobs" required>
											<label class="form-check-label">
												This job/training is NOT related to Sea Jobs / Maritime Industry
											</label>
										</div>

										<div class="form-check mb-2">
											<input class="form-check-input" type="radio" name="Reason" value="Fake or Scam Post">
											<label class="form-check-label">
												Fake or Scam Job/Training Posting
											</label>
										</div>

										<div class="form-check mb-2">
											<input class="form-check-input" type="radio" name="Reason" value="Misleading Information">
											<label class="form-check-label">
												Misleading or Incorrect Information
											</label>
										</div>

										<div class="form-check mb-2">
											<input class="form-check-input" type="radio" name="Reason" value="Duplicate Post">
											<label class="form-check-label">
												Duplicate Posting
											</label>
										</div>

										<div class="form-check mb-3">
											<input class="form-check-input" type="radio" name="Reason" value="Other">
											<label class="form-check-label">
												Other (Please specify below)
											</label>
										</div>

										<!-- Additional Details -->
										<div class="mb-3">
											<label class="form-label">Additional Details</label>
											<textarea class="form-control"
													  name="Description"
													  rows="3"
													  placeholder="Provide more details if necessary..."></textarea>
										</div>

										<!-- Hidden ID (if needed) -->
										<input type="hidden" name="TrainingId" value="@Model.Training.Id" />

									</div>

									<div class="modal-footer">
										<button type="button" class="btn btn-light" data-bs-dismiss="modal">
											Cancel
										</button>
										<button type="submit" class="btn btn-danger">
											Submit Report
										</button>
									</div>
								</form>

							</div>
						</div>
					</div>
				</div>
				<!--end::Job-->
			</div>
			<!--end::Content-->
			<!--begin::Sidebar-->
			<div class="flex-lg-row-auto w-100 w-lg-275px w-xxl-350px">
				<!--begin::Careers about-->
				<div class="card bg-light">
					<!--begin::Body-->
					<div class="card-body">
						<!--begin::Top-->
						<div class="mb-7">
							<!--begin::Title-->
							<h2 class="fs-1 text-gray-800 w-bolder mb-6">About Us</h2>
							<!--end::Title-->
							<!--begin::Text-->
							<p class="fw-semibold fs-6 text-gray-600">@Model.Training.Users.EmployerDetails.BusinessName</p>
							<!--end::Text-->
						</div>
						<!--end::Top-->
						<!--begin::Item-->
						<div class="mb-8">
							<!--begin::Title-->
							<h4 class="text-gray-700 w-bolder mb-0">Badge</h4>
							<!--end::Title-->
							<!--begin::Section-->
							<div class="my-2">
								<!--begin::Row-->
								<div class="d-flex align-items-center mb-3">
									<!--begin::Bullet-->
									<span class="bullet me-3"></span>
									<!--end::Bullet-->
									<!--begin::Label-->
									@if (Model.Training.TrainingBadge == null)
									{

										<div class="fw-semibold fs-6"><span class="badge badge-primary">Nothing</span></div>
									}
									else
									{

										<div class="fw-semibold fs-6"><span class="badge badge-primary">@Model.Training.TrainingBadge.Badge</span></div>
									}

									<!--end::Label-->
								</div>
							</div>
							<!--end::Section-->
						</div>
						<!--end::Item-->
						<!--begin::Item-->
						<div class="mb-8">
							<!--begin::Title-->
							<h4 class="text-gray-700 w-bolder mb-0">Price</h4>
							<!--end::Title-->
							<!--begin::Section-->
							<div class="my-2">
								<!--begin::Row-->
								<div class="d-flex align-items-center mb-3">
									<!--begin::Bullet-->
									<span class="bullet me-3"></span>
									<!--end::Bullet-->
									<!--begin::Label-->
									<div class="text-gray-600 fw-semibold fs-6">₱@Model.Training.Price.ToString("N0") / pesos</div>

									<!--end::Label-->
								</div>
								<!--end::Row-->
								<div class="d-flex align-items-center mb-3">
									<!--begin::Bullet-->
									<span class="bullet me-3"></span>
									<!--end::Bullet-->
									<!--begin::Label-->
									<div class="text-gray-600 fw-semibold fs-6">Training</div>
								</div>
							</div>
							<!--end::Section-->
						</div>
						<!--end::Item-->
						<!--begin::Item-->
						<div class="mb-8">
							<!--begin::Title-->
							<h4 class="text-gray-700 w-bolder mb-0">Payment Method</h4>
							<!--end::Title-->
							<!--begin::Section-->
							<div class="my-2">
								<!--begin::Row-->
								<div class="d-flex align-items-center mb-3">
									<!--begin::Bullet-->
									<span class="bullet me-3"></span>
									<!--end::Bullet-->
									<!--begin::Label-->
									@{
										string paymentOption;
										@if (Model.Training.PaymentOption == "Down")
										{
											paymentOption = "With down payment";
										}
										else
										{
											paymentOption = "Full payment";
										}
									}
									
									<div class="text-gray-600 fw-semibold fs-6">@paymentOption</div>
									<!--end::Label-->
								</div>
								<div class="d-flex align-items-center mb-3">
									<!--begin::Bullet-->
									<span class="bullet me-3"></span>
									<!--end::Bullet-->
									<!--begin::Label-->
									<div class="text-gray-600 fw-semibold fs-6">@Model.Training.ModeOfPayment</div>
									<!--end::Label-->
								</div>
								@if (Model.Training.DownPayment != null)
								{
									@if (Model.Training.Unit == "PHP" || Model.Training.Unit == null)
									{
										<div class="d-flex align-items-center mb-3">
											<!--begin::Bullet-->
											<span class="bullet me-3"></span>
											<!--end::Bullet-->
											<!--begin::Label-->

											<div class=" fw-semibold fs-6 required text-danger fst-italic">It requires a minimum downpayment of ₱@Model.Training.DownPayment</div>
											<!--end::Label-->
										</div>
									}else if(Model.Training.Unit == "Percentage")
									{
										<div class="d-flex align-items-center mb-3">
											<!--begin::Bullet-->
											<span class="bullet me-3"></span>
											<!--end::Bullet-->
											<!--begin::Label-->

											<div class=" fw-semibold fs-6 required text-danger fst-italic">
												It requires a minimum downpayment of ₱@(((Model.Training.DownPayment ?? 0) / 100m * Model.Training.Price).ToString("N2"))
											</div>
											<!--end::Label-->
										</div>
									}
								}
								<!--end::Row-->
								<div class="d-flex align-items-center mb-3">
									<!--begin::Bullet-->
									<span class="bullet me-3"></span>
									<!--end::Bullet-->
									<!--begin::Label-->
									<div class="text-gray-600 fw-semibold fs-6">Training</div>
								</div>
							</div>
							<!--end::Section-->
						</div>
						<!--end::Item-->
						<!--begin::Item-->
						<div class="mb-8">
							<!--begin::Title-->
							<h4 class="text-gray-700 w-bolder mb-0">Will Expire In</h4>
							<!--end::Title-->
							<!--begin::Section-->
							<div class="my-2">
								<!--begin::Row-->
								<div class="d-flex align-items-center mb-3">
									<!--begin::Bullet-->
									<span class="bullet me-3"></span>
									<!--end::Bullet-->
									<!--begin::Label-->
									<div class="text-gray-600 fw-semibold fs-6">@Model.Training.Expiration.Humanize()</div>
									<!--end::Label-->
								</div>
								<!--end::Row-->
							</div>
							<!--end::Section-->
						</div>
						<!--end::Item-->
					</div>
					<!--end::Body-->
				</div>
				<!--end::Careers about-->
			</div>
			<!--end::Sidebar-->
		</div>
		<!--end::Layout-->
		<!--begin::Section-->
		<div class="mb-19">
			<!--begin::Top-->
			<div class="text-center mb-12">
				<!--begin::Title-->
				<h3 class="fs-2hx text-dark mb-5">Job opportunities ahead!</h3>
				<!--end::Title-->
				@if (Model.Jobs.Count > 0)
				{
					<!--begin::Text-->
					<div class="fs-5 text-muted fw-semibold">
						Job recommendation
						<br>based on badge obtained after this training!
					</div>
					<!--end::Text-->
				}
				else
				{

					<!--begin::Text-->
					<div class="fs-5 text-muted fw-semibold">
						<div class="fs-5 text-muted fw-semibold mb-2">
							No jobs related to this
						</div>

						<!-- SVG Frown -->
						<svg xmlns="http://www.w3.org/2000/svg"
							 width="70"
							 height="70"
							 viewBox="0 0 24 24"
							 fill="none"
							 stroke="currentColor"
							 stroke-width="1.5"
							 stroke-linecap="round"
							 stroke-linejoin="round"
							 class="text-muted">

							<!-- Face -->
							<circle cx="12" cy="12" r="10" />

							<!-- Eyes -->
							<line x1="9" y1="9" x2="9.01" y2="9" />
							<line x1="15" y1="9" x2="15.01" y2="9" />

							<!-- Frown -->
							<path d="M8 15s1.5-2 4-2 4 2 4 2" />
						</svg>
					</div>
					<!--end::Text-->
				}
			</div>
			<!--end::Top-->
			<!--begin::Row-->
			@if (Model.Jobs.Count > 0)
			{
				var count = Model.Jobs.Count;
				var showEmpty = count < 3;

				<div class="row g-10 justify-content-center">

					@foreach (var data in Model.Jobs)
					{
						<div class="@(count == 1 ? "col-md-6" : "col-md-4")">
							<div class="card-xl-stretch me-md-6 border-2 hover-elevate-up">

								<!-- IMAGE -->
								<a class="d-block overlay card-rounded-top"
								   asp-controller="Employee"
								   asp-action="JobInfo"
								   asp-route-id="@data.Id">

									<div class="overlay-wrapper bgi-no-repeat bgi-position-center bgi-size-cover card-rounded min-h-175px"
										 style="background-image:url('@data.JobMedia.FirstOrDefault()?.FilePath')">
									</div>

									<div class="overlay-layer bg-dark bg-opacity-25 card-rounded">
										<i class="ki-duotone ki-eye fs-2x text-white"></i>
									</div>
								</a>

								<!-- BODY -->
								<div class="card-body d-flex flex-column">

									<!-- BADGE -->
									@if (data.JobRequiredBadge != null)
									{
										@foreach(var badge in data.JobRequiredBadge)
										{
											<div class="mb-2">
												<span class="badge badge-light-success fw-bold">
													<i class="ki-duotone ki-shield-check me-1"></i>
													@badge.Badge
												</span>
											</div>
										}
									}

									<!-- TITLE -->
									<span class="fs-4 fw-bold text-dark mb-2">
										@data.JobTitle
									</span>

									<!-- DESCRIPTION -->
									<div class="text-gray-600 fw-semibold mb-4 line-clamp-3">
										@data.JobDescription
									</div>

									<!-- FOOTER -->
									<div class="mt-auto d-flex justify-content-between align-items-center">
										<span class="text-gray-700 fw-bold">@data.Users.Username</span>
										<span class="text-muted fs-7">
											Expires @data.ExpirationDate.Humanize()
										</span>
									</div>

								</div>
							</div>
						</div>
					}

					@* EMPTY STATE (ONLY ONCE) *@
					@if (showEmpty)
					{
						<div class="col-md-4 d-flex align-items-center justify-content-center">
							<div class="text-center">
								<div class="fs-5 text-muted fw-semibold mb-2">
									No more jobs related to the training
								</div>

								<!-- SVG Frown -->
								<svg xmlns="http://www.w3.org/2000/svg"
									 width="70"
									 height="70"
									 viewBox="0 0 24 24"
									 fill="none"
									 stroke="currentColor"
									 stroke-width="1.5"
									 stroke-linecap="round"
									 stroke-linejoin="round"
									 class="text-muted">

									<!-- Face -->
									<circle cx="12" cy="12" r="10" />

									<!-- Eyes -->
									<line x1="9" y1="9" x2="9.01" y2="9" />
									<line x1="15" y1="9" x2="15.01" y2="9" />

									<!-- Frown -->
									<path d="M8 15s1.5-2 4-2 4 2 4 2" />
								</svg>
							</div>
						</div>

					}

				</div>
			}

		</div>
		<!--end::Section-->
	</div>
	<!--end::Body-->
</div>
@section Scripts {
	<script>
		const carousel = document.getElementById('jobMediaCarousel');

		function handleVideoPlayback() {
			const videos = carousel.querySelectorAll('video');
			videos.forEach(v => {
				v.pause();
				v.muted = true;
			});

			const activeVideo = carousel.querySelector('.carousel-item.active video');
			if (activeVideo) {
				activeVideo.muted = false;
				activeVideo.play();
			}
		}

		// Run on slide change
		carousel.addEventListener('slid.bs.carousel', handleVideoPlayback);

		// Run on page load
		window.addEventListener('load', handleVideoPlayback);
	</script>
}