@{
    ViewData["Title"] = "Applicant Information";
    Layout = "~/Views/Shared/_LayoutEmployer.cshtml";
}
@using Humanizer
@model Jobs;
<div class="card">
	<!--begin::Body-->
	<div class="card-body p-lg-17">
		<!--begin::Hero-->
		@{
			string[] videoExtensions = new[] { ".mp4", ".webm", ".ogg", ".mov" };
		}

		<style>
			.job-media-item {
				width: 100%;
				height: 450px; /* fixed landscape height */
				object-fit: cover; /* crop & center */
				border-radius: 12px;
			}
		</style>

		<div class="position-relative mb-17">
			<div id="jobMediaCarousel" class="carousel slide card-rounded overflow-hidden" data-bs-ride="false">
				<div class="carousel-inner">
					@if (Model.JobMedia != null && Model.JobMedia.Any())
					{
						var index = 0;
						foreach (var media in Model.JobMedia)
						{
							var isActive = index == 0 ? "active" : "";
							var ext = System.IO.Path.GetExtension(media.FilePath)?.ToLower();

							<div class="carousel-item @isActive">
								@if (!string.IsNullOrEmpty(ext) && videoExtensions.Contains(ext))
								{
									<!-- Video -->
									<video class="d-block job-media-item"
										   loop playsinline muted>
										<source src="@Url.Content(media.FilePath)" type="video/mp4">
										Your browser does not support the video tag.
									</video>
								}
								else
								{
									<!-- Image -->
									<img src="@Url.Content(media.FilePath)" class="d-block job-media-item" alt="Job Media" />
								}
							</div>
							index++;
						}
					}
					else
					{
						<!-- Fallback if no media -->
						<div class="carousel-item active">
							<div class="job-media-item d-flex align-items-center justify-content-center bg-light text-muted">
								No media available
							</div>
						</div>
					}
				</div>

				<!-- Controls -->
				<button class="carousel-control-prev" type="button" data-bs-target="#jobMediaCarousel" data-bs-slide="prev">
					<span class="carousel-control-prev-icon"></span>
				</button>
				<button class="carousel-control-next" type="button" data-bs-target="#jobMediaCarousel" data-bs-slide="next">
					<span class="carousel-control-next-icon"></span>
				</button>
			</div>

			<!-- Overlay -->
			<div class="overlay-layer rounded bg-black position-absolute top-0 start-0 w-100 h-100" style="opacity: 0.4"></div>

			<!-- Business Info -->
			<div class="position-absolute text-white mb-8 ms-10 bottom-0">
				<h3 class="text-white fs-2qx fw-bold mb-3">@Model.Users.EmployerDetails?.BusinessName</h3>
				<div class="fs-5 fw-semibold">@Model.Users.EmployerDetails?.BusinessDescription</div>
			</div>
		</div>
		<!--begin::Layout-->
		<!--begin::Layout-->
		<div class="d-flex flex-column flex-lg-row mb-17">
			<!--begin::Content-->
			<div class="flex-lg-row-fluid me-0 me-lg-20">
				<!--begin::Form-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--begin::Label-->
						<label class="required fs-5 fw-semibold mb-2">First Name</label>
						<!--end::Label-->
						<!--begin::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="FirstName" value="@Model.JobApplication?.FirstOrDefault()?.FirstName" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--end::Label-->
						<label class="required fs-5 fw-semibold mb-2">Last Name</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="LastName" value="@Model.JobApplication?.FirstOrDefault()?.LastName" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-12 fv-row">
						<!--end::Label-->
						<label class="fs-5 fw-semibold mb-2">Mobile No</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="MobileNo" value="@Model.JobApplication?.FirstOrDefault()?.MobileNo" readonly>
						<!--end::Input-->
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--begin::Label-->
						<label class="required fs-5 fw-semibold mb-2">Age</label>
						<!--end::Label-->
						<!--begin::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="Age" value="@Model.JobApplication?.FirstOrDefault()?.Age" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--end::Label-->
						<label class="required fs-5 fw-semibold mb-2">City</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="City" value="@Model.JobApplication?.FirstOrDefault()?.City" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--begin::Label-->
						<label class="required fs-5 fw-semibold mb-2">Expected Salary</label>
						<!--end::Label-->
						<!--begin::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="ExpectedSalary" value="@Model.JobApplication?.FirstOrDefault()?.ExpectedSalary" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--end::Label-->
						<label class="required fs-5 fw-semibold mb-2">Start Date</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="date" class="form-control" value="@Model.JobApplication?.FirstOrDefault()?.StartDate.ToString("yyyy-MM-dd")" name="StartDate" readonly />
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="d-flex flex-column mb-5">
					<label class="fs-6 fw-semibold mb-2">Experience (Optional)</label>
					<textarea class="form-control form-control-solid" rows="2" name="Experience" placeholder="" readonly>@Model.JobApplication?.FirstOrDefault()?.Experience</textarea>
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="d-flex flex-column mb-8">
					<label class="fs-6 fw-semibold mb-2">Application</label>
					<textarea class="form-control form-control-solid" rows="4" name="ApplicationLetter" placeholder="" readonly>@Model.JobApplication?.FirstOrDefault()?.ApplicationLetter</textarea>
				</div>
				<!--end::Input group-->
				<!-- Upload Media -->
				@if (Model.Coe)
				{
					<div class="mb-5">
						<div>
							<label class="form-label fw-bold required">Certificate of Employment</label>
						</div>
						<div class="card">
							<div class="card-body">
								<input type="file" class="form-control filepond" name="CoeFile" accept="image/*,application/pdf" data-default-file="@Model.JobApplication?.FirstOrDefault()?.Coe" />
							</div>
						</div>
					</div>
				}
				@if (Model.Tor)
				{
					<div class="mb-5">
						<div>
							<label class="form-label fw-bold required">Transcript of Records</label>
						</div>
						<div class="card">
							<div class="card-body">
								<input type="file" class="form-control filepond" name="TorFile" accept="image/*,application/pdf" data-default-file="@Model.JobApplication?.FirstOrDefault()?.Tor" />
							</div>
						</div>
					</div>
				}
				@if (Model.Diploma)
				{
					<div class="mb-5">
						<div>
							<label class="form-label fw-bold required">Diploma</label>
						</div>
						<div class="card">
							<div class="card-body">
								<input type="file" class="form-control filepond" name="DiplomaFile" accept="image/*,application/pdf" data-default-file="@Model.JobApplication?.FirstOrDefault()?.Diploma" />
							</div>
						</div>
					</div>
				}
				@if (Model.PassportId)
				{
					<div class="mb-5">
						<div>
							<label class="form-label fw-bold required">Passport Id</label>
						</div>
						<div class="card">
							<div class="card-body">
								<input type="file" class="form-control filepond" name="PassportIdFile" accept="image/*,application/pdf" data-default-file="@Model.JobApplication?.FirstOrDefault()?.PassportId" />
							</div>
						</div>
					</div>
				}
				@if (Model.Resume)
				{
					<div class="mb-5">
						<div>
							<label class="form-label fw-bold required">Resume</label>
						</div>
						<div class="card">
							<div class="card-body">
								<input type="file" class="form-control filepond" name="ResumeFile" accept="image/*,application/pdf" data-default-file="@Model.JobApplication?.FirstOrDefault()?.Resume" />
							</div>
						</div>
					</div>
				}
				@if (Model.SeamansBook)
				{
					<div class="mb-5">
						<div>
							<label class="form-label fw-bold required">Seaman's Book</label>
						</div>
						<div class="card">
							<div class="card-body">
								<input type="file" class="form-control filepond" name="SeamansBookFile" accept="image/*,application/pdf" data-default-file="@Model.JobApplication?.FirstOrDefault()?.SeamansBook" />
							</div>
						</div>
					</div>
				}

				<form asp-controller="Employer" asp-action="ApplicantInfo" class="form mb-15 fv-plugins-bootstrap5 fv-plugins-framework" method="post" asp-route-Id="@Model.Id" asp-route-ApplicantId="@Model.JobApplication?.FirstOrDefault()?.AppliedBy">
					<div class="mb-5">
						<select class="form-select" name="Status">
							<option value="@Model.JobApplication.FirstOrDefault()?.Status" hidden selected>@Model.JobApplication.FirstOrDefault()?.Status</option>
							<option value="Applied">Applied</option>
							<option value="Interview">Interview</option>
							<option value="Interview">Hired</option>
							<option value="Interview">Reject</option>
						</select>
					</div>
					<!--begin::Separator-->
					<div class="separator mb-8"></div>
					<!--end::Separator-->
					<!--begin::Submit-->
					<a class="btn btn-danger" asp-controller="Employer" asp-action="JobDetails" asp-route-Id="@Model.Id">Back</a>
					<button type="submit" class="btn btn-primary" id="kt_careers_submit_button">
						<!--begin::Indicator label-->
						<span class="indicator-label">Submit Changes</span>
						<!--end::Indicator label-->
						<!--begin::Indicator progress-->
						<span class="indicator-progress">
							Please wait...
							<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
						</span>
						<!--end::Indicator progress-->
					</button>
					<!--end::Submit-->
				</form>
				<!--end::Form-->
			</div>
			<!--end::Content-->
		</div>
		<!--end::Layout-->
	</div>
	<!--end::Body-->
</div>
@section Scripts {
	<style>
		.filepond--image-preview-wrapper {
			cursor: zoom-in;
			transition: transform 0.3s ease;
		}

			.filepond--image-preview-wrapper:hover img {
				transform: scale(1.1);
			}

		/* Full screen overlay for click */
		.image-zoom-overlay {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: rgba(0, 0, 0, 0.9);
			z-index: 9999;
			cursor: zoom-out;
			justify-content: center;
			align-items: center;
		}

			.image-zoom-overlay.active {
				display: flex;
			}

			.image-zoom-overlay img {
				max-width: 90%;
				max-height: 90%;
				object-fit: contain;
			}
	</style>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			FilePond.registerPlugin(
				FilePondPluginImagePreview,
				FilePondPluginPdfPreview
			);

			FilePond.setOptions({
				allowMultiple: false,
				acceptedFileTypes: ['image/*', 'application/pdf'],
				fileValidateTypeLabelExpectedTypes: 'Expects an image or PDF',
				allowImagePreview: true,
				allowPdfPreview: true,
				pdfPreviewHeight: 240,
				pdfComponentExtraParams: 'toolbar=0&navpanes=0&scrollbar=0&view=fitH&page=1',
				server: null,
				storeAsFile: true,
				chunkUploads: false,
				allowReorder: false,
				allowRemove: false,
				allowReplace: false,
				instantUpload: false,
				allowRevert: false
			});

			// Create overlay element
			const overlay = document.createElement('div');
			overlay.className = 'image-zoom-overlay';
			overlay.innerHTML = '<img src="" alt="Zoomed image">';
			document.body.appendChild(overlay);

			overlay.addEventListener('click', () => {
				overlay.classList.remove('active');
			});

			const inputs = document.querySelectorAll('.filepond');
			inputs.forEach(input => {
				const pond = FilePond.create(input);
				const defaultFile = input.dataset.defaultFile;

				if (defaultFile) {
					pond.addFile(defaultFile);
				}

				pond.on('addfile', (error, file) => {
					if (error) {
						alert('Invalid file: Only images and PDFs allowed.');
					}

					// Add zoom for images
					if (!error && file.file.type.startsWith('image/')) {
						setTimeout(() => {
							const wrapper = pond.element.querySelector('.filepond--image-preview-wrapper');
							if (wrapper) {
								wrapper.addEventListener('click', (e) => {
									e.preventDefault();
									e.stopPropagation();

									const imgSrc = file.source || URL.createObjectURL(file.file);
									overlay.querySelector('img').src = imgSrc;
									overlay.classList.add('active');
								});
							}
						}, 100);
					}
				});
			});
		});
	</script>
}