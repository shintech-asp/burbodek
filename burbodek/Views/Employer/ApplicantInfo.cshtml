@{
    ViewData["Title"] = "Applicant Information";
    Layout = "~/Views/Shared/_LayoutEmployer.cshtml";
}
@using Humanizer
@model ApplicantInfoViewModel;
@using System.Text.Json
@using burbodek.Models.ViewModels
<div class="card">
	<!--begin::Body-->
	<div class="card-body p-lg-17">
		<!--begin::Hero-->
		@{
			string[] videoExtensions = new[] { ".mp4", ".webm", ".ogg", ".mov" };
		}

		<style>
			.job-media-item {
				width: 100%;
				height: 450px; /* fixed landscape height */
				object-fit: cover; /* crop & center */
				border-radius: 12px;
			}
		</style>

		<div class="position-relative mb-17">
			<div id="jobMediaCarousel" class="carousel slide card-rounded overflow-hidden" data-bs-ride="false">
				<div class="carousel-inner">
					@if (Model.Jobs.JobMedia != null && Model.Jobs.JobMedia.Any())
					{
						var index = 0;
						foreach (var media in Model.Jobs.JobMedia)
						{
							var isActive = index == 0 ? "active" : "";
							var ext = System.IO.Path.GetExtension(media.FilePath)?.ToLower();

							<div class="carousel-item @isActive">
								@if (!string.IsNullOrEmpty(ext) && videoExtensions.Contains(ext))
								{
									<!-- Video -->
									<video class="d-block job-media-item"
										   loop playsinline muted>
										<source src="@Url.Content(media.FilePath)" type="video/mp4">
										Your browser does not support the video tag.
									</video>
								}
								else
								{
									<!-- Image -->
									<img src="@Url.Content(media.FilePath)" class="d-block job-media-item" alt="Job Media" />
								}
							</div>
							index++;
						}
					}
					else
					{
						<!-- Fallback if no media -->
						<div class="carousel-item active">
							<div class="job-media-item d-flex align-items-center justify-content-center bg-light text-muted">
								No media available
							</div>
						</div>
					}
				</div>

				<!-- Controls -->
				<button class="carousel-control-prev" type="button" data-bs-target="#jobMediaCarousel" data-bs-slide="prev">
					<span class="carousel-control-prev-icon"></span>
				</button>
				<button class="carousel-control-next" type="button" data-bs-target="#jobMediaCarousel" data-bs-slide="next">
					<span class="carousel-control-next-icon"></span>
				</button>
			</div>

			<!-- Overlay -->
			<div class="overlay-layer rounded bg-black position-absolute top-0 start-0 w-100 h-100" style="opacity: 0.4"></div>

			<!-- Business Info -->
			<div class="position-absolute text-white mb-8 ms-10 bottom-0">
				<h3 class="text-white fs-2qx fw-bold mb-3">@Model.Jobs.Users.EmployerDetails?.BusinessName</h3>
				<div class="fs-5 fw-semibold">@Model.Jobs.Users.EmployerDetails?.BusinessDescription</div>
			</div>
		</div>
		<!--begin::Layout-->
		<!--begin::Layout-->
		<div class="d-flex flex-column flex-lg-row mb-17">
			<!--begin::Content-->
			<div class="flex-lg-row-fluid me-0 me-lg-20">
				<!--begin::Form-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--begin::Label-->
						<label class="required fs-5 fw-semibold mb-2">First Name</label>
						<!--end::Label-->
						<!--begin::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="FirstName" value="@Model.Jobs.JobApplication?.FirstOrDefault()?.FirstName" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--end::Label-->
						<label class="required fs-5 fw-semibold mb-2">Last Name</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="LastName" value="@Model.Jobs.JobApplication?.FirstOrDefault()?.LastName" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-12 fv-row">
						<!--end::Label-->
						<label class="fs-5 fw-semibold mb-2">Mobile No</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="MobileNo" value="@Model.Jobs.JobApplication?.FirstOrDefault()?.MobileNo" readonly>
						<!--end::Input-->
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--begin::Label-->
						<label class="required fs-5 fw-semibold mb-2">Age</label>
						<!--end::Label-->
						<!--begin::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="Age" value="@Model.Jobs.JobApplication?.FirstOrDefault()?.Age" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--end::Label-->
						<label class="required fs-5 fw-semibold mb-2">City</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="City" value="@Model.Jobs.JobApplication?.FirstOrDefault()?.City" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--begin::Label-->
						<label class="required fs-5 fw-semibold mb-2">Expected Salary</label>
						<!--end::Label-->
						<!--begin::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="ExpectedSalary" value="@Model.Jobs.JobApplication?.FirstOrDefault()?.ExpectedSalary" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--end::Label-->
						<label class="required fs-5 fw-semibold mb-2">Start Date</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="date" class="form-control" value="@Model.Jobs.JobApplication?.FirstOrDefault()?.StartDate.ToString("yyyy-MM-dd")" name="StartDate" readonly />
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="d-flex flex-column mb-5">
					<label class="fs-6 fw-semibold mb-2">Experience (Optional)</label>
					<textarea class="form-control form-control-solid" rows="2" name="Experience" placeholder="" readonly>@Model.Jobs.JobApplication?.FirstOrDefault()?.Experience</textarea>
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="d-flex flex-column mb-8">
					<label class="fs-6 fw-semibold mb-2">Application</label>
					<textarea class="form-control form-control-solid" rows="4" name="ApplicationLetter" placeholder="" readonly>@Model.Jobs.JobApplication?.FirstOrDefault()?.ApplicationLetter</textarea>
				</div>
				<!--end::Input group-->
				<!-- Upload Media -->
				@if (Model.Jobs.JobUploads != null)
				{
					@foreach (var data in Model.Jobs.JobUploads)
					{
						<div class="mb-5">
							<div>
								<label class="form-label fw-bold required">@data.Name</label>
							</div>
							<div class="card">
								<div class="card-body">
									<input type="file" class="form-control filepond" name="CoeFile" accept="image/*,application/pdf" data-default-file="@data.ApplicantJobUpload.FirstOrDefault().Upload" />
								</div>
							</div>
						</div>
					}
				}
				<form asp-controller="Employer" asp-action="ApplicantInfo" class="form mb-15 fv-plugins-bootstrap5 fv-plugins-framework" method="post" asp-route-Id="@Model.Jobs.Id" asp-route-ApplicantId="@Model.Jobs.JobApplication?.FirstOrDefault()?.AppliedBy">
					<div class="mb-5">
						<select class="form-select" name="Status">
							<option value="@Model.Jobs.JobApplication.FirstOrDefault()?.Status" hidden selected>@Model.Jobs.JobApplication.FirstOrDefault()?.Status</option>
							<option value="Applied">Applied</option>
							<option value="For Interview">Interview</option>
							<option value="Hired">Hired</option>
							<option value="Rejected">Reject</option>
						</select>
					</div>
					<!--begin::Separator-->
					<div class="separator mb-8"></div>
					<!--end::Separator-->
					<!--begin::Submit-->
					<a class="btn btn-danger" asp-controller="Employer" asp-action="JobDetails" asp-route-Id="@Model.Jobs.Id">Back</a>
					<button type="button" class="btn btn-primary" id="previewEmailBtn">
						<span class="indicator-label">Submit Changes</span>
					</button>
					<!-- Email Preview Modal -->
					<div class="modal fade" id="emailPreviewModal" tabindex="-1">
						<div class="modal-dialog modal-xl modal-dialog-scrollable">
							<div class="modal-content">

								<div class="modal-header">
									<h5 class="modal-title">Review & Edit Email</h5>
									<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
								</div>

								<div class="modal-body">

									<div class="mb-3">
										<label class="form-label">Subject</label>
										<input type="text" id="emailSubject" class="form-control">
									</div>

									<div class="mb-3">
										<label class="form-label">Email Body</label>
										<div id="emailBody" style="height: 500px;"></div>
									</div>

								</div>

								<div class="modal-footer">
									<button type="button" class="btn btn-secondary"
											data-bs-dismiss="modal">
										Cancel
									</button>
									<button type="button" class="btn btn-success"
											id="confirmSubmitBtn">
										Confirm & Send
									</button>
								</div>

							</div>
						</div>
					</div>


				</form>
				<!--end::Form-->
			</div>
			<!--end::Content-->
		</div>
		<!--end::Layout-->
	</div>
	<!--end::Body-->
</div>
@section Scripts {
	<style>
		.filepond--image-preview-wrapper {
			cursor: zoom-in;
			transition: transform 0.3s ease;
		}

			.filepond--image-preview-wrapper:hover img {
				transform: scale(1.1);
			}

		/* Full screen overlay for click */
		.image-zoom-overlay {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: rgba(0, 0, 0, 0.9);
			z-index: 9999;
			cursor: zoom-out;
			justify-content: center;
			align-items: center;
		}

			.image-zoom-overlay.active {
				display: flex;
			}

			.image-zoom-overlay img {
				max-width: 90%;
				max-height: 90%;
				object-fit: contain;
			}
	</style>

	<script>
				var emailTemplates = @Html.Raw(JsonSerializer.Serialize(Model.EmailTemplate));

		document.addEventListener('DOMContentLoaded', function () {

			// ==============================
			// INIT GRAPESJS EDITOR
			// ==============================
			const editor = grapesjs.init({
				container: '#emailBody',
				height: '500px',
				width: 'auto',
				storageManager: false,
				panels: { defaults: [] }, // Remove unnecessary panels
				blockManager: { blocks: [] },
				plugins: [],
				canvas: {
					styles: [],
				},
				deviceManager: {
					devices: [
						{ name: 'Desktop', width: '' }
					]
				},
			});

			// Hide GrapesJS toolbar except what we need
			editor.Panels.removePanel('views');
			editor.Panels.removePanel('devices-c');

			// ==============================
			// PREVIEW BUTTON
			// ==============================
			document.getElementById("previewEmailBtn").addEventListener("click", function () {

				var selectedStatus = document.querySelector("select[name='Status']").value;
				var template = emailTemplates.find(t => t.TypeOfEmail === selectedStatus);

				if (!template) {
					alert("No email template found for this status.");
					return;
				}

				// Replace placeholders
				var applicantName = "@Model.Jobs.JobApplication?.FirstOrDefault()?.LastName, @Model.Jobs.JobApplication?.FirstOrDefault()?.FirstName";
				var jobTitle = "@Model.Jobs.JobTitle";
				var companyName = "@Model.Jobs.Users.Username";

				var body = template.Body
					.replaceAll("{{ApplicantName}}", applicantName)
					.replaceAll("{{JobTitle}}", jobTitle)
					.replaceAll("{{CompanyName}}", companyName);

				var subject = template.Subject
					.replaceAll("{{JobTitle}}", jobTitle)
					.replaceAll("{{CompanyName}}", companyName);

				// Set subject
				document.getElementById("emailSubject").value = subject;

				// Load full HTML into GrapesJS (renders with styles!)
				editor.setComponents(body);

				// Show modal — wait for modal to be visible before rendering
				const modalEl = document.getElementById('emailPreviewModal');
				const modal = new bootstrap.Modal(modalEl);

				modalEl.addEventListener('shown.bs.modal', function () {
					editor.refresh(); // Re-render inside modal
				}, { once: true });

				modal.show();
			});

			// ==============================
			// CONFIRM SUBMIT
			// ==============================
		document.getElementById("confirmSubmitBtn").addEventListener("click", function () {

			const form = document.querySelector("form");
			const editedSubject = document.getElementById("emailSubject").value;

			// Get the full HTML with styles properly combined
			const css = editor.getCss();
			const html = editor.getHtml();

			const fullHtml = `<!DOCTYPE html>
		<html>
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<style>${css}</style>
		</head>
		${html}
		</html>`;

			// Remove old hidden inputs (avoid duplicates)
			document.querySelectorAll("input[name='EmailSubject'], input[name='EmailBody']")
				.forEach(e => e.remove());

			let subjectInput = document.createElement("input");
			subjectInput.type = "hidden";
			subjectInput.name = "EmailSubject";
			subjectInput.value = editedSubject;

			let bodyInput = document.createElement("input");
			bodyInput.type = "hidden";
			bodyInput.name = "EmailBody";
			bodyInput.value = fullHtml;

			form.appendChild(subjectInput);
			form.appendChild(bodyInput);

			form.submit();
		});

			// ==============================
			// FILEPOND INIT
			// ==============================
			FilePond.registerPlugin(
				FilePondPluginImagePreview,
				FilePondPluginPdfPreview
			);

			FilePond.setOptions({
				allowMultiple: false,
				acceptedFileTypes: ['image/*', 'application/pdf'],
				fileValidateTypeLabelExpectedTypes: 'Expects an image or PDF',
				allowImagePreview: true,
				allowPdfPreview: true,
				pdfPreviewHeight: 240,
				pdfComponentExtraParams: 'toolbar=0&navpanes=0&scrollbar=0&view=fitH&page=1',
				server: null,
				storeAsFile: true,
				chunkUploads: false,
				allowReorder: false,
				allowRemove: false,
				allowReplace: false,
				instantUpload: false,
				allowRevert: false
			});

			// ==============================
			// IMAGE ZOOM OVERLAY
			// ==============================
			const overlay = document.createElement('div');
			overlay.className = 'image-zoom-overlay';
			overlay.innerHTML = '<img src="" alt="Zoomed image">';
			document.body.appendChild(overlay);

			overlay.addEventListener('click', () => {
				overlay.classList.remove('active');
			});

			// ==============================
			// FILEPOND INSTANCES
			// ==============================
			const inputs = document.querySelectorAll('.filepond');
			inputs.forEach(input => {
				const pond = FilePond.create(input);
				const defaultFile = input.dataset.defaultFile;

				if (defaultFile) {
					pond.addFile(defaultFile);
				}

				pond.on('addfile', (error, file) => {
					if (error) {
						alert('Invalid file: Only images and PDFs allowed.');
						return;
					}

					if (file.file.type.startsWith('image/')) {
						setTimeout(() => {
							const wrapper = pond.element.querySelector('.filepond--image-preview-wrapper');
							if (wrapper) {
								wrapper.addEventListener('click', (e) => {
									e.preventDefault();
									e.stopPropagation();
									const imgSrc = file.source || URL.createObjectURL(file.file);
									overlay.querySelector('img').src = imgSrc;
									overlay.classList.add('active');
								});
							}
						}, 100);
					}
				});
			});

		}); // END DOMContentLoaded
	</script>
}