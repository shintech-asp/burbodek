@{
    ViewData["Title"] = "Applicant Information";
    Layout = "~/Views/Shared/_LayoutEmployer.cshtml";
}
@using Humanizer
@model Jobs;
<div class="card">
	<!--begin::Body-->
	<div class="card-body p-lg-17">
		<!--begin::Hero-->
		@{
			string[] videoExtensions = new[] { ".mp4", ".webm", ".ogg", ".mov" };
		}

		<style>
			.job-media-item {
				width: 100%;
				height: 450px; /* fixed landscape height */
				object-fit: cover; /* crop & center */
				border-radius: 12px;
			}
		</style>

		<div class="position-relative mb-17">
			<div id="jobMediaCarousel" class="carousel slide card-rounded overflow-hidden" data-bs-ride="false">
				<div class="carousel-inner">
					@if (Model.JobMedia != null && Model.JobMedia.Any())
					{
						var index = 0;
						foreach (var media in Model.JobMedia)
						{
							var isActive = index == 0 ? "active" : "";
							var ext = System.IO.Path.GetExtension(media.FilePath)?.ToLower();

							<div class="carousel-item @isActive">
								@if (!string.IsNullOrEmpty(ext) && videoExtensions.Contains(ext))
								{
									<!-- Video -->
									<video class="d-block job-media-item"
										   loop playsinline muted>
										<source src="@Url.Content(media.FilePath)" type="video/mp4">
										Your browser does not support the video tag.
									</video>
								}
								else
								{
									<!-- Image -->
									<img src="@Url.Content(media.FilePath)" class="d-block job-media-item" alt="Job Media" />
								}
							</div>
							index++;
						}
					}
					else
					{
						<!-- Fallback if no media -->
						<div class="carousel-item active">
							<div class="job-media-item d-flex align-items-center justify-content-center bg-light text-muted">
								No media available
							</div>
						</div>
					}
				</div>

				<!-- Controls -->
				<button class="carousel-control-prev" type="button" data-bs-target="#jobMediaCarousel" data-bs-slide="prev">
					<span class="carousel-control-prev-icon"></span>
				</button>
				<button class="carousel-control-next" type="button" data-bs-target="#jobMediaCarousel" data-bs-slide="next">
					<span class="carousel-control-next-icon"></span>
				</button>
			</div>

			<!-- Overlay -->
			<div class="overlay-layer rounded bg-black position-absolute top-0 start-0 w-100 h-100" style="opacity: 0.4"></div>

			<!-- Business Info -->
			<div class="position-absolute text-white mb-8 ms-10 bottom-0">
				<h3 class="text-white fs-2qx fw-bold mb-3">@Model.Users.EmployerDetails?.BusinessName</h3>
				<div class="fs-5 fw-semibold">@Model.Users.EmployerDetails?.BusinessDescription</div>
			</div>
		</div>
		<!--begin::Layout-->
		<!--begin::Layout-->
		<div class="d-flex flex-column flex-lg-row mb-17">
			<!--begin::Content-->
			<div class="flex-lg-row-fluid me-0 me-lg-20">
				<!--begin::Form-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--begin::Label-->
						<label class="required fs-5 fw-semibold mb-2">First Name</label>
						<!--end::Label-->
						<!--begin::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="FirstName" value="@Model.JobApplication?.FirstOrDefault()?.FirstName" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--end::Label-->
						<label class="required fs-5 fw-semibold mb-2">Last Name</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="LastName" value="@Model.JobApplication?.FirstOrDefault()?.LastName" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-12 fv-row">
						<!--end::Label-->
						<label class="fs-5 fw-semibold mb-2">Mobile No</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="MobileNo" value="@Model.JobApplication?.FirstOrDefault()?.MobileNo" readonly>
						<!--end::Input-->
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--begin::Label-->
						<label class="required fs-5 fw-semibold mb-2">Age</label>
						<!--end::Label-->
						<!--begin::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="Age" value="@Model.JobApplication?.FirstOrDefault()?.Age" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--end::Label-->
						<label class="required fs-5 fw-semibold mb-2">City</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="City" value="@Model.JobApplication?.FirstOrDefault()?.City" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="row mb-5">
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--begin::Label-->
						<label class="required fs-5 fw-semibold mb-2">Expected Salary</label>
						<!--end::Label-->
						<!--begin::Input-->
						<input type="text" class="form-control form-control-solid" placeholder="" name="ExpectedSalary" value="@Model.JobApplication?.FirstOrDefault()?.ExpectedSalary" readonly>
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
					<!--begin::Col-->
					<div class="col-md-6 fv-row fv-plugins-icon-container">
						<!--end::Label-->
						<label class="required fs-5 fw-semibold mb-2">Start Date</label>
						<!--end::Label-->
						<!--end::Input-->
						<input type="date" class="form-control" value="@Model.JobApplication?.FirstOrDefault()?.StartDate.ToString("yyyy-MM-dd")" name="StartDate" readonly />
						<!--end::Input-->
						<div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
					</div>
					<!--end::Col-->
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="d-flex flex-column mb-5">
					<label class="fs-6 fw-semibold mb-2">Experience (Optional)</label>
					<textarea class="form-control form-control-solid" rows="2" name="Experience" placeholder="" readonly>@Model.JobApplication?.FirstOrDefault()?.Experience</textarea>
				</div>
				<!--end::Input group-->
				<!--begin::Input group-->
				<div class="d-flex flex-column mb-8">
					<label class="fs-6 fw-semibold mb-2">Application</label>
					<textarea class="form-control form-control-solid" rows="4" name="ApplicationLetter" placeholder="" readonly>@Model.JobApplication?.FirstOrDefault()?.ApplicationLetter</textarea>
				</div>
				<!--end::Input group-->
				<!-- Upload Media -->
				<div class="mb-5">
					<div>
						<label class="form-label fw-bold">Upload CV</label>
					</div>
					<a href="@Model.JobApplication?.FirstOrDefault()?.CV" target="_blank">Applicant CV</a>
				</div>

				<form asp-controller="Employer" asp-action="ApplicantInfo" class="form mb-15 fv-plugins-bootstrap5 fv-plugins-framework" method="post" asp-route-Id="@Model.Id" asp-route-ApplicantId="@Model.JobApplication?.FirstOrDefault()?.AppliedBy">
					<div class="mb-5">
						<select class="form-select" name="Status">
							<option value="@Model.JobApplication.FirstOrDefault()?.Status" hidden selected>@Model.JobApplication.FirstOrDefault()?.Status</option>
							<option value="Applied">Applied</option>
							<option value="Interview">Interview</option>
							<option value="Interview">Hired</option>
							<option value="Interview">Reject</option>
						</select>
					</div>
					<!--begin::Separator-->
					<div class="separator mb-8"></div>
					<!--end::Separator-->
					<!--begin::Submit-->
					<a class="btn btn-danger" asp-controller="Employer" asp-action="JobDetails" asp-route-Id="@Model.Id">Back</a>
					<button type="submit" class="btn btn-primary" id="kt_careers_submit_button">
						<!--begin::Indicator label-->
						<span class="indicator-label">Submit Changes</span>
						<!--end::Indicator label-->
						<!--begin::Indicator progress-->
						<span class="indicator-progress">
							Please wait...
							<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
						</span>
						<!--end::Indicator progress-->
					</button>
					<!--end::Submit-->
				</form>
				<!--end::Form-->
			</div>
			<!--end::Content-->
		</div>
		<!--end::Layout-->
	</div>
	<!--end::Body-->
</div>