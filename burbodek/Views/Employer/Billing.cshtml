@using Humanizer
@{
    ViewData["Title"] = "Statement of Account";
    Layout = "~/Views/Shared/_LayoutEmployer.cshtml";
}
@model Users;
<div class="card">
    <!--begin::Body-->
    <div class="card-body p-lg-20">
        <!--begin::Layout-->
        <div class="d-flex flex-column flex-xl-row">
            <!--begin::Content-->
            <div class="flex-lg-row-fluid me-xl-18 mb-10 mb-xl-0">
                <!--begin::Invoice 2 content-->
                <div class="mt-n1">
                    <!--begin::Top-->
                    <div class="d-flex flex-stack pb-10">
                        <!--begin::Logo-->
                        <a href="#">
                            <img alt="Logo" src="~/assets/media/logos/nav-icon.png">
                        </a>
                        <!--end::Logo-->
                    </div>
                    <!--end::Top-->
                    <!--begin::Wrapper-->
                    <div class="m-0">
                        <!--begin::Label-->
                        @{
                            var sub = Model?.Subscription?
                            .FirstOrDefault(u => u.Status == "Current");

                            var invoiceNumber = sub != null
                            ? $"INV-{DateTime.Now:yyyyMMdd}-{sub.Id:D6}"
                            : "INV-NA";
                        }
                        <div class="fw-bold fs-3 text-gray-800 mb-8">Invoice #@invoiceNumber</div>
                        <!--end::Label-->
                        <!--begin::Row-->
                        <div class="row g-5 mb-11">
                            <!--end::Col-->
                            <div class="col-sm-6">
                                <!--end::Label-->
                                <div class="fw-semibold fs-7 text-gray-600 mb-1">Issue Date:</div>
                                <!--end::Label-->
                                <!--end::Col-->
                                <div class="fw-bold fs-6 text-gray-800">@Model.Subscription.FirstOrDefault(u => u.Status == "Current").CreatedAt.ToString("MMMM d, yyyy")</div>
                                <!--end::Col-->
                            </div>
                            <!--end::Col-->
                            <!--end::Col-->
                            <div class="col-sm-6">
                                <!--end::Label-->
                                <div class="fw-semibold fs-7 text-gray-600 mb-1">Due Date:</div>
                                <!--end::Label-->
                                <!--end::Info-->
                                <div class="fw-bold fs-6 text-gray-800 d-flex align-items-center flex-wrap">
                                    <span class="pe-2">
                                        @(Model.Subscription.FirstOrDefault(u => u.Status == "Current")?.Expiration?.ToString("MMMM d, yyyy") ?? "No Expiration yet")
                                    </span>
                                </div>
                                <!--end::Info-->
                            </div>
                            <!--end::Col-->
                        </div>
                        <!--end::Row-->
                        <!--begin::Row-->
                        <div class="row g-5 mb-12">
                            <!--end::Col-->
                            <div class="col-sm-6">
                                <!--end::Label-->
                                <div class="fw-semibold fs-7 text-gray-600 mb-1">Issue For:</div>
                                <!--end::Label-->
                                <!--end::Text-->
                                <div class="fw-bold fs-6 text-gray-800">@Model.Username</div>
                                <!--end::Text-->
                                <!--end::Description-->
                                <div class="fw-semibold fs-7 text-gray-600">
                                    @Model.Email
                                </div>
                                <!--end::Description-->
                            </div>
                            <!--end::Col-->
                            <!--end::Col-->
                            <div class="col-sm-6">
                                <!--end::Label-->
                                <div class="fw-semibold fs-7 text-gray-600 mb-1">Issued By:</div>
                                <!--end::Label-->
                                <!--end::Text-->
                                <div class="fw-bold fs-6 text-gray-800">Cruise Ship Jobs</div>
                                <!--end::Text-->
                                <!--end::Description-->
                                <div class="fw-semibold fs-7 text-gray-600">
                                    Dasmariñas Cavite
                                </div>
                                <!--end::Description-->
                            </div>
                            <!--end::Col-->
                        </div>
                        <!--end::Row-->
                        <!--begin::Content-->
                        <div class="flex-grow-1">
                            <!--begin::Table-->
                            <div class="table-responsive border-bottom mb-9">
                                <table class="table mb-3">
                                    <thead>
                                        <tr class="border-bottom fs-6 fw-bold text-muted">
                                            <th class="min-w-175px pb-2">Description</th>
                                            <th class="min-w-80px text-end pb-2">Rate</th>
                                            <th class="min-w-100px text-end pb-2">Amount</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <tr class="fw-bold text-gray-700 fs-5 text-end">
                                            <td class="d-flex align-items-center pt-6">
                                                <i class="fa fa-genderless text-success fs-2 me-2"></i>
                                                @Model.Subscription.FirstOrDefault(u => u.Status == "Current").Plans.PlanName
                                                <span>Subscription</span>
                                            </td>
                                            @{
                                                var data = Model.Subscription.FirstOrDefault(u => u.Status == "Current");
                                                double? price;
                                                double? discount = data.Plans.Price * (data.Plans.Discount / 100.0);
                                                string? term = data.Plans.PlanName;
                                                if (term == "Annual")
                                                {
                                                    term = "1 Year";
                                                }else if(term == "Monthly")
                                                {
                                                    term = "1 Month";
                                                }
                                                else
                                                {
                                                    term = "No limit";
                                                }
                                                if(data.Plans.PlanName == "Annual")
                                                {
                                                    price = data.Plans.Price / 12;
                                                }
                                                else
                                                {
                                                    price = data.Plans.Price;
                                                }

                                            }
                                            <td class="pt-6">₱@price</td>
                                            <td class="pt-6 text-gray-900 fw-bolder">₱@data.Plans.Price</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <!--end::Table-->
                            <!--begin::Container-->
                            <div class="d-flex justify-content-end">
                                <!--begin::Section-->
                                <div class="mw-300px">
                                    <!--begin::Item-->
                                    <div class="d-flex flex-stack mb-3">
                                        <!--begin::Accountname-->
                                        <div class="fw-semibold pe-10 text-gray-600 fs-7">Subtotal:</div>
                                        <!--end::Accountname-->
                                        <!--begin::Label-->
                                        <div class="text-end fw-bold fs-6 text-gray-800">₱ @data.Plans.Price</div>
                                        <!--end::Label-->
                                    </div>
                                    <!--end::Item-->
                                    <!--begin::Item-->
                                    <div class="d-flex flex-stack mb-3">
                                        <!--begin::Accountname-->
                                        <div class="fw-semibold pe-10 text-gray-600 fs-7">Discount @data.Plans.Discount%</div>
                                        <!--end::Accountname-->
                                        <!--begin::Label-->
                                        <div class="text-end fw-bold fs-6 text-gray-800">₱ @discount</div>
                                        <!--end::Label-->
                                    </div>
                                    <!--end::Item-->
                                    <!--begin::Item-->
                                    <div class="d-flex flex-stack mb-3">
                                        <!--begin::Accountnumber-->
                                        <div class="fw-semibold pe-10 text-gray-600 fs-7">Subtotal - Discount</div>
                                        <!--end::Accountnumber-->
                                        <!--begin::Number-->
                                        <div class="text-end fw-bold fs-6 text-gray-800">₱ @(data.Plans.Price - discount)</div>
                                        <!--end::Number-->
                                    </div>
                                    <!--end::Item-->
                                    <!--begin::Item-->
                                    <div class="d-flex flex-stack">
                                        <!--begin::Code-->
                                        <div class="fw-semibold pe-10 text-gray-600 fs-7">Total</div>
                                        <!--end::Code-->
                                        <!--begin::Label-->
                                        <div class="text-end fw-bold fs-6 text-gray-800">₱ @(data.Plans.Price - discount)</div>
                                        <!--end::Label-->
                                    </div>
                                    <!--end::Item-->
                                </div>
                                <!--end::Section-->
                            </div>
                            <!--end::Container-->
                        </div>
                        <!--end::Content-->
                    </div>
                    <!--end::Wrapper-->
                </div>
                <!--end::Invoice 2 content-->
            </div>
            <!--end::Content-->
            <!--begin::Sidebar-->
            <div class="m-0">
                <!--begin::Invoice 2 sidebar-->
                <div class="d-print-none border border-dashed border-gray-300 card-rounded h-lg-100 min-w-md-350px p-9 bg-lighten">
                    <!--begin::Labels-->
                    <div class="mb-8">
                        <span class="badge badge-light-success me-2">Approved</span>

                        <span class="badge badge-light-success">Paid</span>
                    </div>
                    <!--end::Labels-->
                    <!--begin::Title-->
                    <h6 class="mb-8 fw-bolder text-gray-600 text-hover-primary">PAYMENT DETAILS</h6>
                    <!--end::Title-->
                    <!--begin::Item-->
                    @if (Model.PaymentDetails?.Count != 0)
                    {
                    <div class="mb-6">
                        <div class="fw-semibold text-gray-600 fs-7">Gcash:</div>
                        @{

                            string maskedPhone = "N/A";

                            // More defensive approach
                            if (Model?.PaymentDetails != null && Model.PaymentDetails.Any())
                            {
                                var paymentDetail = Model.PaymentDetails.FirstOrDefault();
                                if (paymentDetail != null)
                                {
                                    var phone = paymentDetail.PhoneNumber;
                                    if (!string.IsNullOrEmpty(phone))
                                    {
                                        if (phone.Length > 5)
                                        {
                                            maskedPhone = phone.Substring(0, phone.Length - 5) + new string('*', 5);
                                        }
                                        else
                                        {
                                            maskedPhone = phone;
                                        }
                                    }
                                }
                                }
                         }
                            <div class="fw-bold text-gray-800 fs-6">@maskedPhone</div>


                    </div>
                    <!--end::Item-->
                    <!--begin::Item-->
                    <div class="mb-6">
                        <div class="fw-semibold text-gray-600 fs-7">Account Name:</div>

                        <div class="fw-bold text-gray-800 fs-6">
                            @Model.PaymentDetails.FirstOrDefault().Name
                        </div>
                    </div>

                    }
                    <!--end::Item-->
                    <!--begin::Item-->
                    <div class="mb-15">
                        <div class="fw-semibold text-gray-600 fs-7">Payment Term:</div>

                        <div class="fw-bold fs-6 text-gray-800 d-flex align-items-center">
                            @term

                            <span class="fs-7 text-danger d-flex align-items-center">
                                <span class="bullet bullet-dot bg-info mx-2"></span>

                                @data.Expiration.Humanize()
                            </span>
                        </div>
                    </div>
                    <!--end::Item-->
                    <!--begin::Action-->
                    <a asp-action="Subscription" asp-controller="Employer" class="btn btn-sm btn-success">Renew</a>
                    <!--end::Action-->
                </div>
                <!--end::Invoice 2 sidebar-->
            </div>
            <!--end::Sidebar-->
        </div>
        <!--end::Layout-->
    </div>
    <!--end::Body-->
</div>
