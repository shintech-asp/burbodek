					});
					 const campaignData = [
			@foreach (var campaign in Model.Campaign.OrderByDescending(u => u.TotalClicks).Take(6))
			{
					<text>
					{
						label: "@campaign.CampaignName",
						data: [{
							x: @campaign.TotalClicks, // X-axis = Total Clicks
