			}).then((result) => {
				if (result.isConfirmed) {
					$.ajax({
						url: '/Employer/ActivateCampaing', // replace with your controller name
						type: 'POST',
						data: { id: id },
						success: function(response) {
							if(response.success) {
								Swal.fire(
									'Deleted!',
									response.message,
									'success'
								).then(() => {
									location.reload(); // reload page to update UI
								});
							} else {
								Swal.fire(
									'Error!',
									response.message,
									'error'
