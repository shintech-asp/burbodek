						}],
						backgroundColor: getRandomColor()
					},
					</text>
			}
		];

		// Generate soft random colors
		function getRandomColor() {
			const colors = [
				'rgba(59,130,246,0.8)', // blue
				'rgba(34,197,94,0.8)',  // green
				'rgba(168,85,247,0.8)', // purple
				'rgba(239,68,68,0.8)',  // red
				'rgba(250,204,21,0.8)', // yellow
				'rgba(45,212,191,0.8)'  // teal
			];
			return colors[Math.floor(Math.random() * colors.length)];
		}

		// Render chart
		const ctx = document.getElementById('campaignBubbleChart').getContext('2d');
		new Chart(ctx, {
			type: 'bubble',
			data: { datasets: campaignData },
			options: {
				responsive: true,
				plugins: {
					legend: { position: 'bottom' },
					title: {
						display: true,
						text: 'Performance Overview - Total Clicks per Campaign'
					}
				},
				scales: {
					x: {
						title: { display: true, text: 'Total Clicks' },
						beginAtZero: true
					},
					y: {
						title: { display: true, text: 'Engagement Metric (Sample)' },
						beginAtZero: true
					}
				}
			}
		});
			console.log('Campaign form script loaded');

			// Store selected listing info
			let selectedListingId = null;
			let selectedListingType = null;
			let selectedListingTitle = null;

			// Handle listing selection
		$(document).on('change', 'input[name="SelectedListingId"]', function () {
			selectedListingId    = $(this).val();
			selectedListingType  = $(this).data('list');               // already "Job" or "Training"
			selectedListingTitle = $(this).closest('.d-flex')
										 .find('.fw-bold.text-gray-900')
										 .text().trim();

			updateReviewPreview();
		});

			// Handle form submit button click
			$(document).on('click', '#submit', function (e) {
				e.preventDefault();               // stop any default action
				submitCampaignForm();
			});

			// Main submit function
			function submitCampaignForm() {
				console.log('Starting form submission...');

				// Get all form values
				const campaignName = $('input[name="CampaignName"]').val();
				const campaignDescription = $('textarea[name="CampaignDescription"]').val();
				const city = $('input[name="City"]').val();
				const province = $('input[name="Province"]').val();
				const fullAddress = $('input[name="FullAddress"]').val();
				const latitude = $('input[name="Latitude"]').val();
				const longitude = $('input[name="Longitude"]').val();
				const logoFile = $('input[name="CampaignLogo"]')[0]?.files[0];
				const PaymentDetails = $('#PaymentMethod').val
				const plan = "@User.FindFirst("Plan")?.Value";
				console.log('Form Values:', {
					campaignName,
					campaignDescription,
					selectedListingId,
					selectedListingType,
					city,
					province,
					fullAddress,
					latitude,
					longitude,
					PaymentDetails
				});

				// Validation
				if (!campaignName || campaignName.trim() === '') {
					Swal.fire('Validation Error', 'Please enter campaign name', 'warning');
					return;
				}

				if ((!PaymentDetails) && plan == "Basic") {
					Swal.fire('Validation Error', 'Please enter payment details', 'warning');
					return;
				}

				if (!campaignDescription || campaignDescription.trim() === '') {
					Swal.fire('Validation Error', 'Please enter campaign description', 'warning');
					return;
				}
				if (!selectedListingId) {
					Swal.fire('Validation Error', 'Please select a job or training', 'warning');
					return;
				}

				if (!city || !province || !fullAddress) {
					Swal.fire('Validation Error', 'Please set all location details', 'warning');
					return;
				}

				if (latitude === '0' || longitude === '0') {
					Swal.fire('Validation Error', 'Please pin your location on the map', 'warning');
					return;
				}

				// Create FormData
				const formData = new FormData();
				formData.append('CampaignName', campaignName);
				formData.append('CampaignDescription', campaignDescription);
				formData.append('SelectedListingId', selectedListingId);
				formData.append('ListingType', selectedListingType);
				formData.append('City', city);
				formData.append('Province', province);
				formData.append('FullAddress', fullAddress);
				formData.append('Latitude', latitude);
				formData.append('Longitude', longitude);

				if (!PaymentDetails && plan === "Basic") {
					formData.append('PaymentDetailsId', PaymentDetails);
				}

				// Add logo if exists
				if (logoFile) {
					formData.append('CampaignLogo', logoFile);
				}

				// Show loading
				const submitBtn = $('#submit');
				submitBtn.prop('disabled', true);
				submitBtn.find('.indicator-label').hide();
				submitBtn.find('.indicator-progress').show();

				// Submit via AJAX
						$.ajax({
			url: '/Employer/SubmitCampaign',
			type: 'POST',
			data: formData,
			contentType: false,
			processData: false,
			success: function (response) {
				// Always re-enable the button
				submitBtn.prop('disabled', false)
						 .find('.indicator-label').show()
						 .end()
						 .find('.indicator-progress').hide();

				if (response.success) {
					// ---- SUCCESS ----
					 if (response.redirectUrl) {
						window.location.href = response.redirectUrl; // 🔥 Do redirect here
					}else{

						Swal.fire({
							title: 'Success!',
							text: response.message,
							icon: 'success',
							showConfirmButton: true,          // show OK button
							confirmButtonText: 'OK',
							timer: false                      // no auto-close
						}).then((result) => {
							if (result.isConfirmed) {
								// Reset form
								$('#kt_modal_create_campaign_stepper_form')[0].reset();
								selectedListingId = null;

								// Reload the page
								location.reload();
							}
						});
					}
				} else {
					// ---- SERVER-SIDE FAILURE ----
					Swal.fire({
						title: 'Error',
						text: response.message || 'Failed to create campaign',
						icon: 'error',
						showConfirmButton: true,
						confirmButtonText: 'OK'
					}).then(() => location.reload());   // reload on OK
				}
			},
			error: function (xhr) {
				// ---- NETWORK / UNEXPECTED ERROR ----
				submitBtn.prop('disabled', false)
						 .find('.indicator-label').show()
						 .end()
						 .find('.indicator-progress').hide();

				const errorMessage = xhr.responseJSON?.message || 'An unexpected error occurred';

				Swal.fire({
					title: 'Error!',
					text: errorMessage,
					icon: 'error',
					showConfirmButton: true,
					confirmButtonText: 'OK'
				}).then(() => location.reload());       // reload on OK
			}
		});
			}

			// Update review preview when data changes
			$(document).on('change keyup', 'input[name="CampaignName"], textarea[name="CampaignDescription"], input[name="City"], input[name="Province"]', function() {
				updateReviewPreview();
			});

			// Update preview on logo change
			$('input[name="CampaignLogo"]').on('change', function() {
				updateReviewPreview();
			});

			function updateReviewPreview() {
				const campaignName = $('input[name="CampaignName"]').val() || 'Campaign Name';
				const campaignDescription = $('textarea[name="CampaignDescription"]').val() || 'Campaign description goes here.';
				const city = $('input[name="City"]').val() || 'City';
				const province = $('input[name="Province"]').val() || 'Province';
				const fullAddress = $('input[name="FullAddress"]').val() || 'Full Address';

				$('#reviewCampaignName').text(campaignName);
				$('#reviewCampaignDescription').text(campaignDescription);
				$('#reviewLocation').text(city + ', ' + province + ' • 2 hours ago');
				$('#reviewFullLocation').text(city + ', ' + province + ' - ' + fullAddress);

				if (selectedListingTitle) {
					$('#reviewListing').text(selectedListingTitle);
				}

				// Update logo preview if changed
				const logoInput = $('input[name="CampaignLogo"]')[0];
				if (logoInput && logoInput.files && logoInput.files[0]) {
					const reader = new FileReader();
					reader.onload = function(e) {
						$('#reviewLogoPreview').attr('src', e.target.result);
						$('#reviewCampaignImage').attr('src', e.target.result);
					};
					reader.readAsDataURL(logoInput.files[0]);
				}
			}
		});

		$(window).on('load', function () {
			console.log('Window loaded, initializing map...');

			// Ensure map container has proper styling
			$('#locationMap').css({
				'height': '400px',
				'width': '100%',
				'position': 'relative',
				'display': 'block',
				'border': '1px solid #e0e0e0',
				'border-radius': '8px',
				'z-index': '1'
			});

			// Small delay to ensure Bootstrap layout is complete
			setTimeout(function() {
				try {
					console.log('Creating map instance...');

					// Create map instance - Center on Philippines
					map = L.map('locationMap', {
						center: [12.8797, 121.7740],
						zoom: 6,
						scrollWheelZoom: true
					});

					console.log('Map created successfully');

					// Add OpenStreetMap tile layer
					L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
						maxZoom: 19,
						attribution: '&copy; OpenStreetMap contributors'
					}).addTo(map);

					console.log('Tile layer added');

					// Force multiple redraws to fix Bootstrap container issues
					setTimeout(() => {
						map.invalidateSize();
						console.log('First invalidateSize');
					}, 100);
					setTimeout(() => {
						map.invalidateSize();
						console.log('Second invalidateSize');
					}, 300);
					setTimeout(() => {
						map.invalidateSize();
						console.log('Third invalidateSize');
					}, 600);

					// Handle window resize
					$(window).on('resize', function() {
						map.invalidateSize();
					});

					// Handle map click - Set location
					map.on('click', async function (e) {
						console.log('Map clicked at:', e.latlng);
						
						const lat = e.latlng.lat.toFixed(6);
						const lng = e.latlng.lng.toFixed(6);

						// Update or create marker
						if (marker) {
							marker.setLatLng([lat, lng]);
						} else {
							marker = L.marker([lat, lng]).addTo(map);
						}

						// Update hidden input fields
						$('#locationLatitude').val(lat);
						$('#locationLongitude').val(lng);

						// Show loading state
						$('#locationCity').val('Loading...');
						$('#locationProvince').val('Loading...');
						$('#locationFullAddress').val('Loading address...');

						// Reverse Geocode using Nominatim
						try {
							const url = 'https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lng;
							const response = await fetch(url);
							
							if (!response.ok) {
								throw new Error('Geocoding service unavailable');
							}
							
							const data = await response.json();
							console.log('Geocoding data:', data);

							// Safely extract address data
							const address = data.address || {};
							const city = address.city || address.town || address.county || 'N/A';
							const province = address.state || address.province || address.region || 'N/A';
							const fullAddress = data.display_name || 'Address not found';

							$('#locationCity').val(city);
							$('#locationProvince').val(province);
							$('#locationFullAddress').val(fullAddress);
							$('#locationAddress').val(fullAddress);

							// Show marker popup
							marker.bindPopup('<strong>' + city + ', ' + province + '</strong><br>' + fullAddress).openPopup();

							// Center map on marker
							map.setView([lat, lng], 13);
						} catch (err) {
							console.error('Reverse geocoding failed:', err);
							$('#locationCity').val('N/A');
							$('#locationProvince').val('N/A');
							$('#locationFullAddress').val('Unable to fetch address');
						}
					});

					// Search by address button
					$('#searchLocationBtn').on('click', function() {
						searchAddress();
					});

					// Search by address on Enter key
					$('#locationAddress').on('keypress', function(e) {
						if (e.key === 'Enter') {
							e.preventDefault();
							searchAddress();
						}
					});

					console.log('Map initialization complete!');

				} catch (error) {
					console.error('Map initialization error:', error);
				}

			}, 250); // Initial delay for Bootstrap layout
		});

		// Search location by address
		function searchAddress() {
			const address = $('#locationAddress').val().trim();

			if (!address) {
				alert('Please enter an address');
				return;
			}

			console.log('Searching for address:', address);

			// Show loading state on button
			const btn = $('#searchLocationBtn');
			const originalText = btn.html();
			btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Searching...');

			// Search using Nominatim
			const url = 'https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(address) + '&limit=1';
			
			fetch(url)
				.then(response => response.json())
				.then(data => {
					console.log('Search results:', data);
					
					if (data.length === 0) {
						alert('Location not found. Please try a different address.');
						btn.prop('disabled', false).html(originalText);
						return;
					}

					const result = data[0];
					const lat = parseFloat(result.lat).toFixed(6);
					const lng = parseFloat(result.lon).toFixed(6);

					console.log('Found location:', lat, lng);

					// Simulate map click to trigger the geocoding flow
					const clickEvent = {
						latlng: {
							lat: parseFloat(lat),
							lng: parseFloat(lng)
						}
					};

					// Trigger the map click handler logic manually
					map.fire('click', clickEvent);

					btn.prop('disabled', false).html(originalText);
				})
				.catch(error => {
					console.error('Search error:', error);
					alert('Error searching location. Please try again.');
					btn.prop('disabled', false).html(originalText);
				});
		}
	</script>
}