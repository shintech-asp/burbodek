@{
    ViewData["Title"] = "Create Job";
    Layout = "~/Views/Shared/_LayoutEmployer.cshtml";
}
@model List<TrainingBadge>;
<!-- Job Listing Form -->
<div class="card mb-10">
    <div class="card-header">
        <h3 class="card-title">Create Job Listing</h3>
    </div>

    <div class="card-body">
        <form asp-controller="Employer" asp-action="JobCreate" method="post" enctype="multipart/form-data">
            <!-- Job Title -->
            <div class="mb-5">
                <label class="form-label fw-bold">Job Title</label>
                <input type="text" class="form-control" name="JobTitle" placeholder="e.g. Cruise Ship Chef" required />
            </div>

            <!-- Salary Range -->
            <div class="row mb-5">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Minimum Salary</label>
                    <input type="number" class="form-control" name="SalaryMin" placeholder="e.g. 2000" required min="0" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Maximum Salary</label>
                    <input type="number" class="form-control" name="SalaryMax" placeholder="e.g. 4000" required min="0" />
                </div>
            </div>

            <!-- Expiration Date -->
            <div class="row mb-5">
                <div class="col">
                    <label class="form-label fw-bold">Expiration Date</label>
                    <input type="date" class="form-control" name="ExpirationDate" required min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
                </div>
                <div class="col">
                    <label class="form-label fw-bold">Job Type</label>
                    <select class="form-select" name="JobType" required>
                        <option hidden selected>Select job type</option>
                        <option value="Full-time">Full-time</option>
                        <option value="Part-time">Part-time</option>
                        <option value="Contract">Contract</option>
                        <option value="Temporary">Temporary</option>
                        <option value="Internship">Internship</option>
                        <option value="Volunteer">Volunteer</option>
                        </select>
                </div>
            </div>

            <!-- Job Description -->
            <div class="mb-5">
                <label class="form-label fw-bold">Job Description</label>
                <textarea class="form-control" rows="4" name="JobDescription" placeholder="Write a detailed job description..." required></textarea>
            </div>

            <!-- Requirements -->
            <div class="mb-5">
                <label class="form-label fw-bold">Requirements</label>
                <select id="requirementSelect" name="Requirement[]" multiple placeholder="Add or select roles...">
                    <option value="Curriculum Vitae">Curriculum Vitae</option>
                    <option value="Diploma">Diploma</option>
                    <option value="5 Years Experience">5 Years Experience</option>
                </select>
            </div>

            <!-- Role -->
            <div class="mb-5">
                <label class="form-label fw-bold">Roles</label>
                <select id="rolesSelect" name="Role[]" multiple placeholder="Add or select roles...">
                    <option value="Responsible for database maintainability">Responsible for database maintainability</option>
                    <option value="Responsible for ship direction">Responsible for ship direction</option>
                    <option value="Responsible for the engine">Responsible for the engine</option>
                </select>
            </div>
            <!-- Requirements -->
            <div class="mb-5">
                <label class="form-label fw-bold">Benefits</label>
                <select id="benefitSelect" name="Benefit[]" multiple placeholder="Add or select roles...">
                    <option value="Bonus">Bonus</option>
                    <option value="13th month pay">13th month pay</option>
                    <option value="Paid leaves">Paid leaves</option>
                </select>
            </div>
                <!-- Requirements -->
            <div class="mb-5">
                <label class="form-label fw-bold">Required Badge</label>
                <select id="badgeSelect" name="Badge[]" multiple placeholder="Add or select roles...">
                    @foreach (var data in Model)
                    {
                        <option value="@data.Badge">@data.Badge</option>
                    }
                </select>
            </div>
            <!-- Upload Media -->
            <div class="mb-5">
                <label class="form-label fw-bold">Upload Media (Max 10)</label>
                <input type="file" class="form-control" name="JobMedia" id="mediaInput" accept="image/*,video/*" multiple />
                <small class="text-muted">You can upload up to 10 pictures/videos.</small>
                <div id="mediaPreview" class="d-flex flex-wrap gap-3 mt-3"></div>
            </div>
            <div class="my-5">
                <hr />
                <h5>Upload settings</h5>
            </div>

            <div class="row">
                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input type="hidden" name="Uploads[0].Name" value="Resume" />
                        <input class="form-check-input" type="checkbox" name="Uploads[0].IsActive" value="true">
                        <input type="hidden" name="Uploads[0].IsActive" value="false" />
                        <label class="form-check-label fw-bold">Resume</label>
                    </div>
                </div>

                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input type="hidden" name="Uploads[1].Name" value="Passport ID" />
                        <input class="form-check-input" type="checkbox" name="Uploads[1].IsActive" value="true">
                        <input type="hidden" name="Uploads[1].IsActive" value="false" />
                        <label class="form-check-label fw-bold">Passport ID</label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input type="hidden" name="Uploads[2].Name" value="Seaman's Book" />
                        <input class="form-check-input" type="checkbox" name="Uploads[2].IsActive" value="true">
                        <input type="hidden" name="Uploads[2].IsActive" value="false" />
                        <label class="form-check-label fw-bold">Seaman's Book</label>
                    </div>
                </div>

                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input type="hidden" name="Uploads[3].Name" value="Transcript of Records" />
                        <input class="form-check-input" type="checkbox" name="Uploads[3].IsActive" value="true">
                        <input type="hidden" name="Uploads[3].IsActive" value="false" />
                        <label class="form-check-label fw-bold">Transcript of Records</label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input type="hidden" name="Uploads[4].Name" value="Diploma" />
                        <input class="form-check-input" type="checkbox" name="Uploads[4].IsActive" value="true">
                        <input type="hidden" name="Uploads[4].IsActive" value="false" />
                        <label class="form-check-label fw-bold">Diploma</label>
                    </div>
                </div>

                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input type="hidden" name="Uploads[5].Name" value="Certificate of Employment" />
                        <input class="form-check-input" type="checkbox" name="Uploads[5].IsActive" value="true">
                        <input type="hidden" name="Uploads[5].IsActive" value="false" />
                        <label class="form-check-label fw-bold">Certificate of Employment</label>
                    </div>
                </div>
            </div>

            <div id="dynamicSwitchContainer" class="row"></div>

            <div class="row">
                <div class="col">
                    <button class="btn btn-primary" id="newSwitch">+ Add More</button>
                </div>
            </div>



            <!-- Submit -->
            <div class="text-end">
                <button type="submit" class="btn btn-primary">Create Job</button>
            </div>
        </form>
    </div>
</div>
@section Scripts{
    <script>
               let index = 6;

        $("#newSwitch").click(function (e) {
            e.preventDefault();

            let html = `
            <div class="col-6 dynamic-switch-item">
                <div class="form-check form-switch mb-4">
                    <input class="form-check-input"
                           type="checkbox"
                           name="Uploads[${index}].IsActive"
                           value="true">
                    <input type="hidden" name="Uploads[${index}].IsActive" value="false">
                    <div class="d-flex gap-2 mt-2">
                        <input type="text"
                               class="form-control"
                               name="Uploads[${index}].Name"
                               placeholder="Upload name" required>
                        <button type="button" class="btn btn-danger btn-sm remove-switch">
                            <i class="bi bi-dash-lg"></i>
                        </button>
                    </div>
                </div>
            </div>`;

            $("#dynamicSwitchContainer").append(html);
            index++;
        });

        // Remove button handler
        $(document).on("click", ".remove-switch", function () {
            $(this).closest(".dynamic-switch-item").remove();
        });
        new TomSelect("#rolesSelect", {
          plugins: ['remove_button'],
          persist: false,
          create: true,
          delimiter: ',',
          placeholder: 'Select or add roles...'
        });
        new TomSelect("#requirementSelect", {
          plugins: ['remove_button'],
          persist: false,
          create: true,
          delimiter: ',',
          placeholder: 'Select or add requirements...'
        });
        new TomSelect("#benefitSelect", {
          plugins: ['remove_button'],
          persist: false,
          create: true,
          delimiter: ',',
          placeholder: 'Select or add benefits...'
        });

           const existingBadges = Array.from(
            document.querySelectorAll("#badgeSelect option")
        ).map(o => o.value.toLowerCase());

        const badgeSelect = new TomSelect("#badgeSelect", {
            plugins: ['remove_button'],
            persist: false,
            create: function (input, callback) {

                // If badge already exists → allow immediately
                if (existingBadges.includes(input.toLowerCase())) {
                    callback({ value: input, text: input });
                    return;
                }

                // Otherwise show confirmation
                Swal.fire({
                    title: 'Create new badge?',
                    text: `The badge "${input}" does not exist in Training available. Do you want to create it?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, create it',
                    cancelButtonText: 'Cancel'
                }).then(result => {
                    if (result.isConfirmed) {
                        existingBadges.push(input.toLowerCase()); // prevent future warnings
                        callback({ value: input, text: input });
                    } else {
                        callback(); // cancel creation
                    }
                });
            },
            delimiter: ',',
            placeholder: 'Select or add badge...'
        });
        // Media Upload Preview (limit 10)
        document.getElementById("mediaInput").addEventListener("change", function () {
          const preview = document.getElementById("mediaPreview");
          preview.innerHTML = "";
          const files = Array.from(this.files).slice(0, 10); // limit 10 files

          files.forEach(file => {
            const reader = new FileReader();
            reader.onload = function (e) {
              let element;
              if (file.type.startsWith("image/")) {
                element = document.createElement("img");
                element.src = e.target.result;
                element.className = "rounded border";
                element.style.width = "120px";
                element.style.height = "80px";
                element.style.objectFit = "cover";
              } else if (file.type.startsWith("video/")) {
                element = document.createElement("video");
                element.src = e.target.result;
                element.controls = true;
                element.className = "rounded border";
                element.style.width = "120px";
                element.style.height = "80px";
              }
              preview.appendChild(element);
            };
            reader.readAsDataURL(file);
          });
        });
         document.querySelector("form").addEventListener("submit", function(e) {
            const minSalary = parseFloat(document.querySelector("input[name='SalaryMin']").value);
            const maxSalary = parseFloat(document.querySelector("input[name='SalaryMax']").value);
            const expDate = new Date(document.querySelector("input[name='ExpirationDate']").value);
            const today = new Date();
            today.setHours(0,0,0,0);

            let errors = [];

            // Salary check
            if (minSalary > maxSalary) {
                errors.push("Minimum salary cannot be greater than maximum salary.");
            }

            // Expiration date check
            if (expDate < today) {
                errors.push("Expiration date cannot be in the past.");
            }

            if(errors.length > 0) {
                e.preventDefault(); // prevent form submission
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Error',
                    html: errors.join("<br/>")
                });
            }
        });

    </script>
}

