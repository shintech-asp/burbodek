@using Humanizer
@{
    Layout = "~/Views/Shared/_LayoutEmployer.cshtml";
    ViewData["Title"] = "Job Details";
}
@model Jobs
<div class="card">
	<!--begin::Body-->
	<div class="card-body p-lg-17">
		<!--begin::Hero-->
@{
	string[] videoExtensions = new[] { ".mp4", ".webm", ".ogg", ".mov" };
}

		<style>
			.job-media-item {
				width: 100%;
				height: 450px; /* fixed landscape height */
				object-fit: cover; /* crop & center */
				border-radius: 12px;
			}
		</style>

		@if (Model.isDeleted == true && (Model.isFinal == null || Model.isFinal == false))
		{
			<div class="alert alert-danger">
				<p><span class="fw-bold">Note: </span> This job is deleted</p>
				@if(Model.Appeal == null)
				{
					<button class="btn btn-success btn-sm" id="appeal"
							data-bs-toggle="modal"
							data-bs-target="#appealModal">
						Appeal
					</button>
				}
				else
				{
					<button class="btn btn-success btn-sm" disabled>
						Appeal submitted
					</button>
					
				}
			</div>
		}
		@if(Model.isFinal == true)
		{
			<div class="alert alert-danger">
				<p><span class="fw-bold">Note: </span> This job is permanently deleted by the admin</p>
			</div>
		}
		<div class="position-relative mb-17">
			<div id="jobMediaCarousel" class="carousel slide card-rounded overflow-hidden" data-bs-ride="false">
				<div class="carousel-inner">
					@if (Model?.JobMedia != null && Model.JobMedia.Any())
					{
						var index = 0;
						foreach (var media in Model.JobMedia)
						{
							var isActive = index == 0 ? "active" : "";
							var ext = System.IO.Path.GetExtension(media.FilePath)?.ToLower();

							<div class="carousel-item @isActive">
								@if (!string.IsNullOrEmpty(ext) && videoExtensions.Contains(ext))
								{
									<!-- Video -->
									<video class="d-block job-media-item"
										   loop playsinline muted>
										<source src="@Url.Content(media.FilePath)" type="video/mp4">
										Your browser does not support the video tag.
									</video>
								}
								else
								{
									<!-- Image -->
									<img src="@Url.Content(media.FilePath)" class="d-block job-media-item" alt="Job Media" />
								}
							</div>
							index++;
						}
					}
					else
					{
						<!-- Fallback if no media -->
						<div class="carousel-item active">
							<div class="job-media-item d-flex align-items-center justify-content-center bg-light text-muted">
								No media available
							</div>
						</div>
					}
				</div>

				<!-- Controls -->
				<button class="carousel-control-prev" type="button" data-bs-target="#jobMediaCarousel" data-bs-slide="prev">
					<span class="carousel-control-prev-icon"></span>
				</button>
				<button class="carousel-control-next" type="button" data-bs-target="#jobMediaCarousel" data-bs-slide="next">
					<span class="carousel-control-next-icon"></span>
				</button>
			</div>

			<!-- Overlay -->
			<div class="overlay-layer rounded bg-black position-absolute top-0 start-0 w-100 h-100" style="opacity: 0.4"></div>

			<!-- Business Info -->
			<div class="position-absolute text-white mb-8 ms-10 bottom-0">
				<h3 class="text-white fs-2qx fw-bold mb-3">@Model.JobTitle</h3>
				<div class="fs-5 fw-semibold">@Model.Users.EmployerDetails?.BusinessDescription</div>
			</div>
		</div>
		<!--begin::Layout-->
		<div class="d-flex flex-column flex-lg-row mb-17">
			<!--begin::Content-->
			<div class="flex-lg-row-fluid me-0 me-lg-20">
				<div class="mb-17">
					<div class="card bg-light">
						<!--begin::Top-->
						<div class="p-5">
							<!--begin::Title-->
							<h2 class="fs-1 text-gray-800 w-bolder">Applicants</h2>
							<!--end::Title-->
						</div>
						<!--end::Top-->
						<div class="card-body">
							<div >
								<div class="table-responsive">
									<table class="table table-row-dashed table-row-gray-300 gy-7">
										<thead>
											<tr class="fw-bold fs-6 text-gray-800">
												<th>Name</th>
												<th>Status</th>
												<th>Actions</th>
											</tr>
										</thead>
										<tbody>
											@if(Model.isDeleted == null || Model.isDeleted == false)
											{
												@if (Model?.JobApplication?.Count > 0)
												{
													@foreach (var data in Model.JobApplication)
													{
														@if (data.Status != "Hired")
														{
															<tr>
																<td>@data.FirstName, @data.LastName</td>

																<td>
																	<span class="badge badge-primary">@data.Status</span>
																</td>
																<td class="text-center">
																	<a class="btn btn-sm btn-primary" asp-action="ApplicantInfo" asp-controller="Employer" asp-route-ApplicantId="@data.AppliedBy" asp-route-Id="@Model.Id">
																		View
																	</a>
																</td>
															</tr>
														}
													}
												}
												else
												{
													
												}
											}
											else
											{
												@if (Model.isDeleted == true)
												{
													<tr>
														<td colspan="4" class="fst-italic text-danger">This job is deleted by the admin.</td>
													</tr>
												}
											}
											
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!--end::Content-->
			<!--begin::Sidebar-->
			<div class="flex-lg-row-auto w-100 w-lg-275px w-xxl-350px">
				<!--begin::Careers about-->
				<div class="card bg-light">
					<!--begin::Body-->
					<div class="card-body">
						<!--begin::Top-->
						<div class="mb-7">
							<!--begin::Title-->
							<h2 class="fs-1 text-gray-800 w-bolder mb-6">About Us</h2>
							<!--end::Title-->
							<!--begin::Text-->
							<p class="fw-semibold fs-6 text-gray-600">@Model.Users.EmployerDetails.BusinessDescription</p>
							<!--end::Text-->
						</div>
						<!--end::Top-->
						@if(Model.JobRequiredBadge.Count > 0)
						{
							<!--begin::Item-->
							<div class="mb-8">
								<!--begin::Title-->
								<h4 class="text-gray-700 w-bolder mb-0">Badge requirements</h4>
								<!--end::Title-->
								<!--begin::Section-->
								<div class="my-2">
									<!--begin::Row-->
									<div class="d-flex align-items-center mb-3">
										<!--begin::Bullet-->
										<span class="bullet me-3"></span>
										<!--end::Bullet-->
										<!--begin::Label-->
										<div class="text-gray-600 fw-semibold fs-6">
											@foreach(var data in Model.JobRequiredBadge)
											{
												<span class="badge badge-light-primary">@data.Badge</span>
											}
										</div>

										<!--end::Label-->
									</div>
								</div>
								<!--end::Section-->
							</div>
							<!--end::Item-->
						}
						<!--begin::Item-->
						<div class="mb-8">
							<!--begin::Title-->
							<h4 class="text-gray-700 w-bolder mb-0">Salary</h4>
							<!--end::Title-->
							<!--begin::Section-->
							<div class="my-2">
								<!--begin::Row-->
								<div class="d-flex align-items-center mb-3">
									<!--begin::Bullet-->
									<span class="bullet me-3"></span>
									<!--end::Bullet-->
									<!--begin::Label-->
									<div class="text-gray-600 fw-semibold fs-6">₱@Model.SalaryMin.ToString("N0") - ₱@Model.SalaryMax.ToString("N0") / month</div>

									<!--end::Label-->
								</div>
								<!--end::Row-->
								<div class="d-flex align-items-center mb-3">
									<!--begin::Bullet-->
									<span class="bullet me-3"></span>
									<!--end::Bullet-->
									<!--begin::Label-->
									<div class="text-gray-600 fw-semibold fs-6">@Model.JobType</div>
								</div>
							</div>
							<!--end::Section-->
						</div>
						<!--end::Item-->
						<!--begin::Item-->
						<div class="mb-8">
							<!--begin::Title-->
							<h4 class="text-gray-700 w-bolder mb-0">Will Expire In</h4>
							<!--end::Title-->
							<!--begin::Section-->
							<div class="my-2">
								<!--begin::Row-->
								<div class="d-flex align-items-center mb-3">
									<!--begin::Bullet-->
									<span class="bullet me-3"></span>
									<!--end::Bullet-->
									<!--begin::Label-->
									<div class="text-gray-600 fw-semibold fs-6">@Model.ExpirationDate.Humanize()</div>
									<!--end::Label-->
								</div>
								<!--end::Row-->
							</div>
							<!--end::Section-->
						</div>
						<!--end::Item-->
						<!--begin::Item-->
						<div class="mb-8">
							<!--begin::Title-->
							<h4 class="text-gray-700 w-bolder mb-0">Looking for</h4>
							<!--end::Title-->
							<!--begin::Section-->
							<div class="my-2">
								<!--begin::Row-->
								<div class="d-flex align-items-center mb-3">
									<!--begin::Bullet-->
									<span class="bullet me-3"></span>
									<!--end::Bullet-->
									<!--begin::Label-->
									<div class="text-gray-600 fw-semibold fs-6">@(Model.WillHire != null ? Model.WillHire : "Potential") Employees</div>
									<!--end::Label-->
								</div>
								<!--end::Row-->
							</div>
							<!--end::Section-->
						</div>
						<!--end::Item-->
					</div>
					<!--end::Body-->
				</div>
				<!--end::Careers about-->
			</div>
			<!--end::Sidebar-->
		</div>
		<!--end::Layout-->

		<div class="modal fade" id="appealModal" tabindex="-1" aria-labelledby="appealModalLabel" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered modal-lg">
				<div class="modal-content">
					<div class="modal-header border-0 pb-0">
						<h5 class="modal-title fw-bold" id="appealModalLabel">⚠️ Reports Against This Post</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<p class="text-muted" style="font-size:13px;">
							The following reports were submitted against your post. Review each reason before submitting your appeal.
						</p>

						<!-- Reports List -->
						<div class="table-responsive mb-4">
							<table class="table table-bordered table-sm align-middle">
								<thead class="table-light">
									<tr>
										<th>#</th>
										<th>Reason</th>
										<th>Description</th>
										<th>Date Reported</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var (report, i) in Model.PostReport.Select((r, i) => (r, i + 1)))
									{
										<tr>
											<td>@i</td>
											<td><span class="badge bg-danger">@report.Reason</span></td>
											<td>@report.Description</td>
											<td>@report.DateReported.ToString("MMM dd, yyyy")</td>
										</tr>
									}
								</tbody>
							</table>
						</div>

						<div class="alert alert-warning" role="alert" style="font-size:13px;">
							<strong>⚠️ Note:</strong> Submitting a false or invalid appeal may result in permanent removal of your post.
						</div>
					</div>
					<div class="modal-footer border-0 pt-0">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
						<button type="button" class="btn btn-success" id="submitAppealBtn">
							<i class="bi bi-send"></i> Appeal This Post
						</button>
					</div>
				</div>
			</div>
		</div>
		@if(Model.isDeleted != true)
		{
			<form asp-controller="Employer" asp-action="JobDelete" asp-route-Id="@Model.Id">
				<div class="text-center mt-5">
					<a class="btn btn-sm btn-warning w-25" asp-action="JobEdit" asp-controller="Employer" asp-route-Id="@Model.Id">
						Edit Job
					</a>
					<button type="submit" id="deleteJobBtn" class="btn btn-sm btn-danger w-25">
						Delete this Job
					</button>
				</div>
			</form>
		}
	</div>
</div>

@section Scripts {
	<script>

				document.getElementById("submitAppealBtn").addEventListener("click", function () {
				$("#appealModal").modal('hide');
					Swal.fire({
			title: 'Submit Appeal',
			html: `
				<p style="font-size:13px; color:#666; margin-bottom:12px; text-align:left;">
					Please provide a detailed explanation for your appeal. Be honest and specific.
				</p>
				<textarea id="appealDescription"
					style="width:100%;
						   height:120px;
						   font-size:13px;
						   resize:vertical;
						   padding: 10px;
						   border: 1px solid #ced4da;
						   border-radius: 6px;
						   font-family: inherit;
						   outline: none;
						   box-sizing: border-box;">
				</textarea>
			`,
			icon: 'question',
			showCancelButton: true,
			confirmButtonText: 'Submit Appeal',
			cancelButtonText: 'Cancel',
			confirmButtonColor: '#28a745',
			didOpen: () => {
				document.getElementById('appealDescription').focus();

				// Focus ring on click
				const ta = document.getElementById('appealDescription');
				ta.addEventListener('focus', () => ta.style.borderColor = '#28a745');
				ta.addEventListener('blur', () => ta.style.borderColor = '#ced4da');
			},
			preConfirm: () => {
				const description = document.getElementById("appealDescription").value.trim();
				if (!description) {
					Swal.showValidationMessage("Please provide a description for your appeal.");
					return false;
				}
				if (description.length < 20) {
					Swal.showValidationMessage("Appeal description must be at least 20 characters.");
					return false;
				}
				return { description };
			}
		}).then((result) => {
				if (result.isConfirmed) {

					// Show loading
					Swal.fire({
						title: 'Submitting Appeal...',
						allowOutsideClick: false,
						didOpen: () => Swal.showLoading()
					});

					$.ajax({
						url: '/Employer/SubmitJobAppeal',
						type: 'POST',
						data: {
							JobId: @Model.Id,
							Description: result.value.description
						},
						success: function (res) {
							if (res.success) {
								Swal.fire({
									title: 'Appeal Submitted!',
									text: 'Your appeal has been submitted and is now under review.',
									icon: 'success',
									confirmButtonColor: '#28a745'
								}).then(() => {
									location.reload();
								});
							} else {
								Swal.fire({
									title: 'Failed',
									text: res.message,
									icon: 'error'
								});
							}
						},
						error: function () {
							Swal.fire({
								title: 'Error',
								text: 'Something went wrong. Please try again.',
								icon: 'error'
							});
						}
					});
				}
			});
		});
		document.getElementById("deleteJobBtn").addEventListener("click", function (e) {
			Swal.fire({
				title: 'Are you sure?',
				text: "This action cannot be undone. The job will be permanently deleted.",
				icon: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#d33',
				cancelButtonColor: '#3085d6',
				confirmButtonText: 'Yes, delete it!'
			}).then((result) => {
				if (result.isConfirmed) {
					document.getElementById("deleteJobForm").submit();
				}
			});
		});
		const carousel = document.getElementById('jobMediaCarousel');

		function handleVideoPlayback() {
			const videos = carousel.querySelectorAll('video');
			videos.forEach(v => {
				v.pause();
				v.muted = true;
			});

			const activeVideo = carousel.querySelector('.carousel-item.active video');
			if (activeVideo) {
				activeVideo.muted = false;
				activeVideo.play();
			}
		}

		// Run on slide change
		carousel.addEventListener('slid.bs.carousel', handleVideoPlayback);

		// Run on page load
		window.addEventListener('load', handleVideoPlayback);
	</script>
}