@using burbodek.Models.ViewModels
@{
    ViewData["Title"] = "Subscription";
    Layout = "_LayoutEmployer";
}
@model SubscriptionViewModel
<!--begin::Layout-->
<div class="d-flex flex-column flex-lg-row">
    <!--begin::Content-->
    <div class="flex-lg-row-fluid me-lg-15 order-2 order-lg-1 mb-10 mb-lg-0">
        <!--begin::Customer-->
        <div class="card card-flush pt-3 mb-5 mb-lg-10">
            <!--begin::Card header-->
            <div class="card-header">
                <!--begin::Card title-->
                <div class="card-title">
                    <h2 class="fw-bold">Customer</h2>
                </div>
                <!--begin::Card title-->
            </div>
            <!--end::Card header-->
            <!--begin::Card body-->
            <div class="card-body pt-0">
                <!--begin::Selected customer-->
                <div class="d-flex align-items-center p-3 mb-2">
                    <!--begin::Avatar-->
                    <div class="symbol symbol-60px symbol-circle me-3">
                        <img alt="Pic" src="~/assets/media/avatars/300-5.jpg">
                    </div>
                    <!--end::Avatar-->
                    <!--begin::Info-->
                    <div class="d-flex flex-column">
                        <!--begin::Name-->
                        <a href="#" class="fs-4 fw-bold text-gray-900 text-hover-primary me-2">@Model.UserDetails.Username</a>
                        <!--end::Name-->
                        <!--begin::Email-->
                        <a href="#" class="fw-semibold text-gray-600 text-hover-primary">@Model.UserDetails.Email</a>
                        <!--end::Email-->
                    </div>
                    <!--end::Info-->
                </div>
                <!--end::Selected customer-->
                <!--begin::Customer add buttons-->
                <div class="mb-7 d-none">
                    <a href="#" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#kt_modal_customer_search">Select Customer</a>

                    <span class="fw-bold text-gray-500 mx-2">or</span>

                    <a href="~/apps/customers/list.html" class="btn btn-light-primary">Add New Customer</a>
                </div>
                <!--end::Customer add buttons-->
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Customer-->
        <!--begin::Pricing-->
        <div class="card card-flush pt-3 mb-5 mb-lg-10">
            <!--begin::Card header-->
            <div class="card-header">
                <!--begin::Card title-->
                <div class="card-title">
                    <span class="fw-bold required">Select Subscription</span>

                    <span class="ms-1" data-bs-toggle="tooltip" aria-label="Please select a subscription" data-bs-original-title="Please select a subscription" data-kt-initialized="1">
                        <i class="ki-duotone ki-information fs-7"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                    </span>
                </div>
                <!--begin::Card title-->
            </div>
            <!--end::Card header-->
            <!--begin::Card body-->
            <div class="card-body pt-0">
                <!--begin::Table wrapper-->
                <div class="table-responsive">
                    <!--begin::Table-->
                    <div id="kt_subscription_products_table_wrapper" class="dt-container dt-bootstrap5 dt-empty-footer">
                        <!--begin::Scroll-->
                        <div class="scroll-y mh-300px me-n7 pe-7">
                            <!--begin::Product-->
                            <div class="fv-row">
                                <!--begin::Subscription-->
                                @foreach (var data in Model.PlansDetails)
                                {
                                    var discountedPrice = data.Discount > 0
                                        ? data.Price - (data.Price * data.Discount / 100)
                                        : data.Price;

                                    <label class="d-flex align-items-center mb-5">
                                        <span class="form-check form-check-custom form-check-solid me-5">
                                            <input class="form-check-input subscription-option"
                                                    type="radio"
                                                    name="product"
                                                    value="@data.Id"
                                                   data-plan-name="@data.PlanName"
                                                   data-plan-amount="@discountedPrice"
                                                    data-plan-price="₱@(((decimal)discountedPrice).ToString("N2"))"
                                                    data-plan-frequency="Month"
                                                    required>
                                        </span>
                                        <span class="d-flex flex-column me-3">
                                            <span class="fw-bold">@data.PlanName</span>
                                            <span class="text-gray-500 fw-semibold fs-6">@data.PlanDetails</span>
                                        </span>
                                        <span class="fw-bold ms-auto">
                                            @if (data.Discount > 0)
                                            {
                                                <span class="text-muted text-decoration-line-through me-2">
                                                    ₱@(((decimal)data.Price).ToString("N2"))
                                                </span>
                                                <span class="text-danger fw-bold">
                                                    ₱@(((decimal)discountedPrice).ToString("N2"))
                                                </span>
                                                <span class="badge badge-light-danger ms-2">-@data.Discount%</span>
                                            }
                                            else
                                            {
                                                <span>₱@(((decimal)data.Price).ToString("N2"))</span>
                                            }
                                            /<span class="text-gray-500 fs-6 fw-semibold">@data.PlanName</span>
                                        </span>
                                    </label>
                                }
                                <!--end::Subscription-->
                            </div>
                            <!--end::Input group-->
                        </div>
                        <!--end::Scroll-->
                    </div>
                    <!--end::Table-->
                </div>
                <!--end::Table wrapper-->
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Pricing-->
        <!--begin::Payment method-->
        <div class="card card-flush pt-3 mb-5 mb-lg-10" data-kt-subscriptions-form="pricing">
            <!--begin::Card header-->
            <div class="card-header">
                <!--begin::Card title-->
                <div class="card-title">
                    <h2 class="fw-bold">Payment Method</h2>
                </div>
                <!--begin::Card title-->
                <!--begin::Card toolbar-->
                <div class="card-toolbar">
                    <a asp-controller="Employer" asp-action="PaymentDetails" class="btn btn-light-primary">
                        New Method
                    </a>
                </div>
                <!--end::Card toolbar-->
            </div>
            <!--end::Card header-->
            <!--begin::Card body-->
            <div class="card-body pt-0">
                <!--begin::Options-->
                    @if (Model.UserDetails.PaymentDetails.Count != 0)
                    {
                    @foreach (var data in Model.UserDetails.PaymentDetails.Select((value, index) => new { value, index }))
                    {
                        var collapseId = $"kt_create_new_payment_method_{data.index}";
                        <div class="py-1">
                            <!--begin::Header-->
                            <div class="py-3 d-flex flex-stack flex-wrap">
                                <!--begin::Toggle-->
                                <div class="d-flex align-items-center collapsible toggle"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId">
                                    <!--begin::Arrow-->
                                    <div class="btn btn-sm btn-icon btn-active-color-primary ms-n3 me-2">
                                        <i class="ki-duotone ki-minus-square toggle-on text-primary fs-2"><span class="path1"></span><span class="path2"></span></i>
                                        <i class="ki-duotone ki-plus-square toggle-off fs-2"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                                    </div>
                                    <!--end::Arrow-->
                                    <!--begin::Logo-->
                                    <img src="~/assets/media/svg/card-logos/gcash.jpeg" class="w-40px me-3" alt="">
                                    <!--end::Logo-->
                                    <!--begin::Summary-->
                                    <div class="me-3">
                                        <div class="d-flex align-items-center fw-bold">
                                            Gcash
                                        </div>
                                    </div>
                                    <!--end::Summary-->
                                </div>
                                <!--end::Toggle-->
                                <!--begin::Input-->
                                @{
                                    string maskedPhone = data.value.PhoneNumber;
                                    if (!string.IsNullOrEmpty(maskedPhone) && maskedPhone.Length > 5)
                                    {
                                        maskedPhone = maskedPhone.Substring(0, maskedPhone.Length - 5) + new string('*', 5);
                                    }
                                }
                                <div class="d-flex my-3 ms-9">
                                    <label class="form-check form-check-custom form-check-solid me-5">
                                        <input class="form-check-input payment-option"
                                               type="radio"
                                               name="payment_method"
                                               value="@data.value.Id"
                                               data-payment-type="Gcash"
                                               data-payment-name="@data.value.Name"
                                               data-payment-number="@maskedPhone"
                                               data-payment-real-number="@data.value.PhoneNumber"
                                               required> 


                                    </label>
                                </div>
                                <!--end::Input-->
                            </div>
                            <!--end::Header-->
                            <!--begin::Body-->
                            <div id="@collapseId" class="collapse @(data.index == 0 ? "show" : "") fs-6 ps-10">
                                <div class="d-flex flex-wrap py-5">
                                    <div class="flex-equal me-5">
                                        <table class="table table-flush fw-semibold gy-1">
                                            <tbody>
                                                <tr>
                                                    <td class="text-muted min-w-125px w-125px">Name</td>
                                                    <td class="text-gray-800">@data.value.Name</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted min-w-125px w-125px">Number</td>
                                                    <td class="text-gray-800">@maskedPhone</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted min-w-125px w-125px">Type</td>
                                                    <td class="text-gray-800">Gcash</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <!--end::Body-->
                        </div>

                        @if (Model.UserDetails.PaymentDetails.Count > 1 && data.index < Model.UserDetails.PaymentDetails.Count - 1)
                        {
                            <div class="separator separator-dashed"></div>
                        }
                    }
                }
                else
                {
                    <div class="text-center py-1">
                        <p class="fst-italic">Please add payment method</p>
                    </div>
                }
                <!--end::Options-->
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Payment method-->
    </div>
    <!--end::Content-->
    <!--begin::Sidebar-->
    <div class="flex-column flex-lg-row-auto w-100 w-lg-250px w-xl-300px mb-10 order-1 order-lg-2">
        <!--begin::Card-->
        <div class="card card-flush pt-3 mb-0" data-kt-sticky="true" data-kt-sticky-name="subscription-summary" data-kt-sticky-offset="{default: false, lg: '200px'}" data-kt-sticky-width="{lg: '250px', xl: '300px'}" data-kt-sticky-left="auto" data-kt-sticky-top="150px" data-kt-sticky-animation="false" data-kt-sticky-zindex="95" style="">
            <!--begin::Card header-->
            <div class="card-header">
                <!--begin::Card title-->
                <div class="card-title">
                    <h2>Summary</h2>
                </div>
                <!--end::Card title-->
            </div>
            <!--end::Card header-->
            <!--begin::Card body-->
            <div class="card-body pt-0 fs-6">
                <!--begin::Section-->
                <div class="mb-7">

                    <!--begin::Title-->
                    <h5 class="mb-3">Customer details</h5>
                    <!--end::Title-->
                    <!--begin::Details-->
                    <div class="d-flex align-items-center mb-1">
                        <!--begin::Name-->
                        <span class="fw-bold text-gray-800 text-hover-primary me-2">
                            @Model.UserDetails.Username
                        </span>
                        <!--end::Name-->
                        <!--begin::Status-->
                        <span class="badge badge-light-success">Active</span>
                        <!--end::Status-->
                    </div>
                    <!--end::Details-->
                    <!--begin::Email-->
                    <span class="fw-semibold text-gray-600 text-hover-primary">@Model.UserDetails.Email</span>
                    <!--end::Email-->
                </div>
                <!--end::Section-->
                <!--begin::Seperator-->
                <div class="separator separator-dashed mb-7"></div>
                <!--end::Seperator-->
                <div class="mb-7">
                    <h5 class="mb-3">Product details</h5>
                    <div class="mb-0" id="summary-plan">
                        <span class="badge badge-light-info me-2">No Plan Selected</span>
                    </div>
                </div>

                <div class="separator separator-dashed mb-7"></div>

                <div class="mb-10">
                    <h5 class="mb-3">Payment Details</h5>
                    <div class="mb-0" id="summary-payment">
                        <p class="text-muted fst-italic">No Payment Method Selected</p>
                    </div>
                </div>
                <!--begin::Actions-->
                <div class="mb-0">
                    <form asp-controller="Employer" asp-action="Checkout" method="post" id="checkoutForm">
                        <input type="hidden" name="amount" id="amountInput" />
                        <input type="hidden" name="planName" id="planNameInput" />
                        <input type="hidden" name="email" value="@Model.UserDetails.Email" />
                        <input type="hidden" name="contact" id="paymentNumberInput" />
                        <input type="hidden" name="username" value="@Model.UserDetails.Username" />
                        <button type="submit" class="btn btn-primary" id="kt_subscriptions_create_button">
                            <span class="indicator-label">Avail Subscription</span>
                            <span class="indicator-progress">
                                Please wait... <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                        </button>
                    </form>
                </div>
                <!--end::Actions-->
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
    <!--end::Sidebar-->
</div>
<!--end::Layout-->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
               // Subscription
        document.querySelectorAll(".subscription-option").forEach(radio => {
            radio.addEventListener("change", function () {
                let planName = this.getAttribute("data-plan-name");
                let planPrice = this.getAttribute("data-plan-price");
                let planFreq = this.getAttribute("data-plan-frequency");
                let planAmount = this.getAttribute("data-plan-amount");

                // ✅ Update summary
                document.getElementById("summary-plan").innerHTML = `
                    <span class="badge badge-light-info me-2">${planName}</span>
                    <span class="fw-semibold text-gray-600">${planPrice} / ${planFreq}</span>
                `;

                // ✅ Update hidden form inputs
                document.getElementById("planNameInput").value = planName;
                document.getElementById("amountInput").value = planAmount;
            });
        });

                    // Payment
        document.querySelectorAll(".payment-option").forEach(radio => {
            radio.addEventListener("change", function () {
                let type = this.getAttribute("data-payment-type");
                let name = this.getAttribute("data-payment-name");
                let masked = this.getAttribute("data-payment-number");
                let real = this.getAttribute("data-payment-real-number");

                // ✅ Show masked in summary
                document.getElementById("summary-payment").innerHTML = `
                    <div class="fw-semibold text-gray-600 d-flex flex-column">
                        <span>${type}</span>
                        <span>${name} (${masked})</span>
                    </div>
                `;

                // ✅ Store real number in hidden input for backend
                document.getElementById("paymentNumberInput").value = real;
            });
        });


        });
    </script>
}
