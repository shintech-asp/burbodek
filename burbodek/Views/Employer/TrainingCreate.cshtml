@{
    ViewData["Title"] = "Training Posting";
    Layout = "~/Views/Shared/_LayoutEmployer.cshtml";
}
<!-- Job Listing Form -->
<div class="card mb-10">
    <div class="card-header">
        <h3 class="card-title">Create Training</h3>
    </div>

    <div class="card-body">
        <form asp-controller="Employer" asp-action="TrainingCreate" method="POST" enctype="multipart/form-data">
            <!-- Job Title -->
            <div class="mb-5">
                <label class="form-label fw-bold">Training Title</label>
                <input type="text" class="form-control" name="Name" placeholder="e.g. Tesda certification" required />
            </div>

            <!-- Salary Range -->
            <div class="row mb-5">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Price</label>
                    <input type="number" class="form-control" name="Price" placeholder="e.g. 2000" min="0" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Expiration Date</label>
                    <input type="date" class="form-control" name="Expiration" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
            </div>

            <!-- Job Description -->
            <div class="mb-5">
                <label class="form-label fw-bold">Training Description</label>
                <textarea class="form-control" rows="4" name="TrainingDescription" placeholder="Write a detailed training description..." required></textarea>
            </div>

            <!-- Job Description -->
            <div class="mb-5">
                <label class="form-label fw-bold">Training Duration</label>
                <div class="input-group input-group-solid mb-5">
                    <input type="text" class="form-control" name="Duration" placeholder="30" min="1" aria-describedby="basic-addon2">
                    <span class="input-group-text" id="basic-addon2">/days</span>
                </div>
            </div>

            <!-- Requirements -->
            <div class="mb-5">
                <label class="form-label fw-bold">Requirements</label>
                <select id="requirementSelectTraining" name="Requirement[]" multiple placeholder="Add or select requirements...">
                    <option value="Curriculum Vitae">Curriculum Vitae</option>
                    <option value="Payment">Payment</option>
                    <option value="Proof of payment">Proof of payment</option>
                </select>
            </div>

            <!-- Benefits -->
            <div class="mb-5">
                <label class="form-label fw-bold">Benefits</label>
                <select id="benefitSelectTraining" name="Benefit[]" multiple placeholder="Add or select benefits...">
                    <option value="Bonus">Bonus</option>
                    <option value="13th month pay">13th month pay</option>
                    <option value="Paid leaves">Paid leaves</option>
                </select>
            </div>

            <!-- Upload Media -->
            <div class="mb-5">
                <div>
                    <label class="form-label fw-bold required">Upload Media</label>
                </div>
                <div class="card">
                    <div class="card-body">
                        <input type="file"
                               class="filepond"
                               name="TrainingMedia"
                               accept="image/*,video/mp4,video/webm,video/ogg"
                               multiple
                               data-allow-reorder="true"
                               data-max-file-size="50MB" />
                    </div>
                </div>
            </div>
            <div class="my-5">
                <hr />
                <h5>Mode of Payment</h5>
            </div>
            <div class="row" id="PaymentForm">
                <div class="col-12 mb-5">
                    <label class="form-label">Payment Option</label>
                    <select class="form-select" name="PaymentOption" id="PaymentOption">
                        <option hidden selected>-- Select --</option>
                        <option value="Full">Full Payment</option>
                        <option value="Down">Down Payment</option>
                    </select>
                </div>
                <div class="col-12 mb-5">
                    <label class="form-label">Mode of Payment</label>
                    <select class="form-select" name="ModeOfPayment" id="ModeOfPayment">
                        <option hidden selected>-- Select --</option>
                        <option value="Cash">Cash</option>
                        <option value="E-wallet">E-Wallet</option>
                    </select>
                </div>
            </div>
            <div class="my-5">
                <hr />
                <h5>Upload settings</h5>
            </div>
            <div class="row">
                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" value="true" name="Resume">
                        <label class="form-check-label fw-bold" for="resumeSwitch">Resume</label>
                    </div>
                </div>
                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" value="true" name="PassportId">
                        <label class="form-check-label fw-bold" for="passportSwitch">Passport ID</label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" value="true" name="SeamansBook">
                        <label class="form-check-label fw-bold" for="seamansSwitch">Seaman's Book</label>
                    </div>
                </div>
                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" value="true" name="Tor">
                        <label class="form-check-label fw-bold" for="torSwitch">Transcript of Records</label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" value="true" name="Diploma">
                        <label class="form-check-label fw-bold" for="diplomaSwitch">Diploma</label>
                    </div>
                </div>
                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" value="true" name="Coe">
                        <label class="form-check-label fw-bold" for="coeSwitch">Certificate of Employment</label>
                    </div>
                </div>
            </div>
            <!-- Submit -->
            <div class="text-end">
                <button type="submit" class="btn btn-primary">Create Training</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <!-- FilePond CSS -->
    <link href="https://unpkg.com/filepond/dist/filepond.css" rel="stylesheet" />
    <link href="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.css" rel="stylesheet" />

    <!-- FilePond JS -->
    <script src="https://unpkg.com/filepond/dist/filepond.js"></script>
    <script src="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.js"></script>
    <script src="https://unpkg.com/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            $("#PaymentOption").on('change', function(){
                if($(this).val() == "Down"){
                    $("#PaymentForm").append(`
                    <div class="row" id="DPForm">
                        <div class="col">
                            <label class="form-label">Down payment</label>
                            <div class="input-group input-group-solid mb-5">
                                <input type="text" class="form-control" name="DownPayment" placeholder="5000" aria-describedby="basic-addon2">
                                <span class="input-group-text" id="basic-addon2">₱/Peso</span>
                            </div>
                        </div>
                    </div>`)
                }else{
                    $("#DPForm").remove()
                }
            })
            // ✅ Register FilePond plugins
            FilePond.registerPlugin(
                FilePondPluginImagePreview,
                FilePondPluginFileValidateType
            );

            // ✅ Initialize FilePond
            const inputElement = document.querySelector('.filepond');
            const pond = FilePond.create(inputElement, {
                allowMultiple: true,
                maxFiles: 10,
                acceptedFileTypes: ['image/*', 'video/mp4', 'video/webm', 'video/ogg', 'video/mov'],
                fileValidateTypeLabelExpectedTypes: 'Expects images or videos',
                labelIdle: 'Drag & Drop your images/videos or <span class="filepond--label-action">Browse</span>',
                allowImagePreview: true,
                imagePreviewMaxHeight: 200,
                allowVideoPreview: true,
                allowRevert: true,
                allowRemove: true,
                allowReorder: true,
                storeAsFile: true,
                credits: false
            });

            // ✅ Enhanced video preview handler
            pond.on('addfile', (error, fileItem) => {
                if (error) {
                    console.error('Error adding file:', error);
                    return;
                }

                const fileType = fileItem.file.type;

                // Add custom video preview for better display
                if (fileType.startsWith('video/')) {
                    setTimeout(() => {
                        const fileItemElement = fileItem.element;
                        const existingVideo = fileItemElement.querySelector('video');

                        if (!existingVideo) {
                            const videoURL = URL.createObjectURL(fileItem.file);
                            const videoEl = document.createElement('video');
                            videoEl.src = videoURL;
                            videoEl.controls = true;
                            videoEl.style.width = '100%';
                            videoEl.style.maxHeight = '200px';
                            videoEl.style.marginTop = '8px';
                            videoEl.style.borderRadius = '8px';
                            videoEl.style.backgroundColor = '#000';

                            const previewContainer = fileItemElement.querySelector('.filepond--file-info');
                            if (previewContainer) {
                                previewContainer.appendChild(videoEl);
                            }
                        }
                    }, 100);
                }
            });

            // ✅ Clean up video URLs when files are removed
            pond.on('removefile', (error, fileItem) => {
                if (!error && fileItem.file.type.startsWith('video/')) {
                    const videoEl = fileItem.element.querySelector('video');
                    if (videoEl && videoEl.src) {
                        URL.revokeObjectURL(videoEl.src);
                    }
                }
            });
        });

        // ✅ Initialize TomSelect for Requirements
        new TomSelect("#requirementSelectTraining", {
            plugins: ['remove_button'],
            persist: false,
            create: true,
            delimiter: ',',
            placeholder: 'Select or add requirements...'
        });

        // ✅ Initialize TomSelect for Benefits
        new TomSelect("#benefitSelectTraining", {
            plugins: ['remove_button'],
            persist: false,
            create: true,
            delimiter: ',',
            placeholder: 'Select or add benefits...'
        });
                document.querySelector("form").addEventListener("submit", function(e) {
            const price = parseFloat(document.querySelector("input[name='Price']").value);
            const expDate = new Date(document.querySelector("input[name='Expiration']").value);
            const today = new Date();
            today.setHours(0,0,0,0);

            let errors = [];

            // Price validation
            if(price <= 0) {
                errors.push("Price must be greater than 0.");
            }

            // Expiration date validation
            if(expDate < today) {
                errors.push("Expiration date cannot be in the past.");
            }

            // Down Payment validation (if DPForm exists)
            const dpInput = document.querySelector("input[name='DownPayment']");
            if(dpInput) {
                const dpValue = parseFloat(dpInput.value);
                if(isNaN(dpValue) || dpValue <= 0) {
                    errors.push("Down payment must be a positive number.");
                } else if(dpValue >= price) {
                    errors.push("Down payment must be less than the full price.");
                }
            }

            if(errors.length > 0) {
                e.preventDefault(); // stop form submission
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Error',
                    html: errors.join("<br/>")
                });
            }
        });

    </script>
}