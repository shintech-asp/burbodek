@{
    ViewData["Title"] = "Training Posting";
    Layout = "~/Views/Shared/_LayoutEmployer.cshtml";
}
<!-- Job Listing Form -->
<form asp-controller="Employer" asp-action="TrainingCreate" method="POST" enctype="multipart/form-data">
    <div class="card mb-10">
        <div class="card-header">
            <h3 class="card-title">Create Training</h3>
        </div>

        <div class="card-body">
            <!-- Job Title -->
            <div class="mb-5">
                <label class="form-label fw-bold">Training Title</label>
                <input type="text" class="form-control" name="Name" placeholder="e.g. Tesda certification" required />
            </div>

            <!-- Salary Range -->
            <div class="row mb-5">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Price</label>
                    <input type="number" class="form-control" name="Price" placeholder="e.g. 2000" id="Price" min="0" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Expiration Date</label>
                    <input type="datetime-local"
                                                                                    class="form-control"
                                                                                    name="Expiration"
                                                                                    required
                                                                                    min="@DateTime.Now.AddDays(1).Date.AddMinutes(1).ToString("yyyy-MM-ddTHH:mm")" />
                </div>
            </div>

            <!-- Job Description -->
            <div class="mb-5">
                <label class="form-label fw-bold">Training Description</label>
                <textarea class="form-control" rows="4" name="TrainingDescription" placeholder="Write a detailed training description..." required></textarea>
            </div>

            <!-- Job Description -->
            <div class="mb-5">
                <label class="form-label fw-bold">Training Duration</label>
                <div class="input-group input-group-solid mb-5">
                    <input type="number" class="form-control" name="Duration" placeholder="30" min="1" aria-describedby="basic-addon2">
                    <span class="input-group-text" id="basic-addon2">/days</span>
                </div>
            </div>

            <!-- Requirements -->
            <div class="mb-5">
                <label class="form-label fw-bold">Requirements</label>
                <select id="requirementSelectTraining" name="Requirement[]" multiple placeholder="Add or select requirements...">
                    <option value="Curriculum Vitae">Curriculum Vitae</option>
                    <option value="Payment">Payment</option>
                    <option value="Proof of payment">Proof of payment</option>
                </select>
            </div>

            <!-- Benefits -->
            <div class="mb-5">
                <label class="form-label fw-bold">Benefits</label>
                <select id="benefitSelectTraining" name="Benefit[]" multiple placeholder="Add or select benefits...">
                    <option value="Bonus">Bonus</option>
                    <option value="13th month pay">13th month pay</option>
                    <option value="Paid leaves">Paid leaves</option>
                </select>
            </div>

            <!-- Upload Media -->
            <div class="mb-5">
                <div>
                    <label class="form-label fw-bold required">Upload Media</label>
                </div>
                <div class="card">
                    <div class="card-body">
                        <input type="file"
                               class="filepond"
                               name="TrainingMedia"
                               accept="image/*,video/mp4,video/webm,video/ogg"
                               multiple
                               data-allow-reorder="true"
                               data-max-file-size="50MB" />
                    </div>
                </div>
            </div>
            <div class="my-5">
                <hr />
                <h5>Mode of Payment</h5>
            </div>
            <div class="row" id="PaymentForm">
                <div class="col-12 mb-5">
                    <label class="form-label">Payment Option</label>
                    <select class="form-select" name="PaymentOption" id="PaymentOption">
                        <option hidden selected>-- Select --</option>
                        <option value="Full">Full Payment</option>
                        <option value="Down">Down Payment</option>
                    </select>
                </div>
                <div class="col-12 mb-5">
                    <label class="form-label">Mode of Payment</label>
                    <select class="form-select" name="ModeOfPayment" id="ModeOfPayment">
                        <option hidden selected>-- Select --</option>
                        <option value="Cash">Cash</option>
                        <option value="E-wallet">E-Wallet</option>
                    </select>
                </div>
            </div>
            <div class="my-5">
                <hr />
                <h5>Upload settings</h5>
            </div>

            <div class="row">
                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input type="hidden" name="Uploads[0].Name" value="Resume" />
                        <input class="form-check-input" type="checkbox" name="Uploads[0].IsActive" value="true">
                        <input type="hidden" name="Uploads[0].IsActive" value="false" />
                        <label class="form-check-label fw-bold">Resume</label>
                    </div>
                </div>

                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input type="hidden" name="Uploads[1].Name" value="Passport ID" />
                        <input class="form-check-input" type="checkbox" name="Uploads[1].IsActive" value="true">
                        <input type="hidden" name="Uploads[1].IsActive" value="false" />
                        <label class="form-check-label fw-bold">Passport ID</label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input type="hidden" name="Uploads[2].Name" value="Seaman's Book" />
                        <input class="form-check-input" type="checkbox" name="Uploads[2].IsActive" value="true">
                        <input type="hidden" name="Uploads[2].IsActive" value="false" />
                        <label class="form-check-label fw-bold">Seaman's Book</label>
                    </div>
                </div>

                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input type="hidden" name="Uploads[3].Name" value="Transcript of Records" />
                        <input class="form-check-input" type="checkbox" name="Uploads[3].IsActive" value="true">
                        <input type="hidden" name="Uploads[3].IsActive" value="false" />
                        <label class="form-check-label fw-bold">Transcript of Records</label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input type="hidden" name="Uploads[4].Name" value="Diploma" />
                        <input class="form-check-input" type="checkbox" name="Uploads[4].IsActive" value="true">
                        <input type="hidden" name="Uploads[4].IsActive" value="false" />
                        <label class="form-check-label fw-bold">Diploma</label>
                    </div>
                </div>

                <div class="col">
                    <div class="form-check form-switch mb-4">
                        <input type="hidden" name="Uploads[5].Name" value="Certificate of Employment" />
                        <input class="form-check-input" type="checkbox" name="Uploads[5].IsActive" value="true">
                        <input type="hidden" name="Uploads[5].IsActive" value="false" />
                        <label class="form-check-label fw-bold">Certificate of Employment</label>
                    </div>
                </div>
            </div>

            <div id="dynamicSwitchContainer" class="row"></div>

            <div class="row">
                <div class="col">
                    <button class="btn btn-primary" id="newSwitch">+ Add More</button>
                </div>
            </div>

            <!-- Submit -->
        </div>
    </div>
    <div class="card mb-10">
        <div class="card-body">
            <h5 class="card-title mb-5">
                Badge settings
            </h5>
            <div class="row mb-3">
                <div class="col">
                    <label class="form-label fw-bold">Badge name</label>
                    <input type="text" class="form-control" name="Badge.Badge" placeholder="NC2 Certified"/>
                </div>
                @* <div class="col">
                    <label class="form-label fw-bold">Badge Validity Duration</label>
                    <div class="input-group input-group-solid mb-5">
                        <input type="text" class="form-control" name="Badge.Validity" placeholder="30" min="1" max="30" aria-describedby="basic-addon2">
                        <span class="input-group-text" id="basic-addon2">/days</span>
                    </div>
                </div> *@
            </div>
            <div class="row mb-5">
                <div class="col">
                    <label class="form-label fw-bold">Badge Description</label>
                    <textarea class="form-control" name="Badge.Description" rows="3"></textarea>
                </div>
            </div>
            <div class="text-end">
                <button type="submit" class="btn btn-primary">Create Training</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <!-- FilePond CSS -->
    <link href="https://unpkg.com/filepond/dist/filepond.css" rel="stylesheet" />
    <link href="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.css" rel="stylesheet" />

    <!-- FilePond JS -->
    <script src="https://unpkg.com/filepond/dist/filepond.js"></script>
    <script src="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.js"></script>
    <script src="https://unpkg.com/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

               let index = 6;

        $("#newSwitch").click(function (e) {
            e.preventDefault();

            let html = `
            <div class="col-6 dynamic-switch-item">
                <div class="form-check form-switch mb-4">
                    <input class="form-check-input"
                           type="checkbox"
                           name="Uploads[${index}].IsActive"
                           value="true">
                    <input type="hidden" name="Uploads[${index}].IsActive" value="false">
                    <div class="d-flex gap-2 mt-2">
                        <input type="text"
                               class="form-control"
                               name="Uploads[${index}].Name"
                               placeholder="Upload name" required>
                        <button type="button" class="btn btn-danger btn-sm remove-switch">
                            <i class="bi bi-dash-lg"></i>
                        </button>
                    </div>
                </div>
            </div>`;

            $("#dynamicSwitchContainer").append(html);
            index++;
        });

        // Remove button handler
        $(document).on("click", ".remove-switch", function () {
            $(this).closest(".dynamic-switch-item").remove();
        });
        $("#PaymentOption").on('change', function () {
            if ($(this).val() == "Down") {
                $("#PaymentForm").append(`
                <div class="row" id="DPForm">
                    <div class="col">
                        <label class="form-label">Down Payment</label>
                        <div class="input-group input-group-solid mb-2">
                            <input type="number"
                                   class="form-control"
                                   name="DownPayment"
                                   id="DownPayment"
                                   placeholder="Enter amount"
                                   min="0">
                            <select class="form-select input-group-text"
                                    name="Unit"
                                    id="DPUnit"
                                    style="max-width:140px">
                                <option value="PHP" selected>₱ PHP</option>
                                <option value="Percentage">% PERCENT</option>
                            </select>
                        </div>
                        <div id="DPError" style="color: #dc3545; font-size: 13px; display:none; margin-bottom: 10px;"></div>
                    </div>
                </div>`);

                // Validate on input change
                $(document).on("input", "#DownPayment", validateDownPayment);
                $(document).on("change", "#DPUnit", validateDownPayment);

            } else {
                $("#DPForm").remove();
                $(document).off("input", "#DownPayment", validateDownPayment);
                $(document).off("change", "#DPUnit", validateDownPayment);
            }
        });

        function validateDownPayment() {
            const value = parseFloat($("#DownPayment").val());
            const unit = $("#DPUnit").val();
            const price = parseFloat($("#Price").val());
            const errorBox = $("#DPError");

            if (isNaN(value) || value < 0) {
                showDPError("Please enter a valid amount.");
                return;
            }

            if (unit === "Percentage") {
                if (value > 99) {
                    showDPError("Percentage cannot exceed 99%.");
                    $("#DownPayment").val(99);
                } else {
                    clearDPError();
                }
            } else if (unit === "PHP") {
                if (!price || isNaN(price)) {
                    showDPError("Please set a Price first before entering a down payment.");
                    $("#DownPayment").val("");
                } else if (value > price) {
                    showDPError(`Down payment cannot exceed the price of ₱${price.toLocaleString()}.`);
                    $("#DownPayment").val(price);
                } else {
                    clearDPError();
                }
            }
        }

        function showDPError(msg) {
            $("#DPError").text(msg).show();
            $("#DownPayment").css("border-color", "#dc3545");
        }

        function clearDPError() {
            $("#DPError").hide().text("");
            $("#DownPayment").css("border-color", "");
        }
            // ✅ Register FilePond plugins
            FilePond.registerPlugin(
                FilePondPluginImagePreview,
                FilePondPluginFileValidateType
            );

            // ✅ Initialize FilePond
            const inputElement = document.querySelector('.filepond');
            const pond = FilePond.create(inputElement, {
                allowMultiple: true,
                maxFiles: 10,
                acceptedFileTypes: ['image/*', 'video/mp4', 'video/webm', 'video/ogg', 'video/mov'],
                fileValidateTypeLabelExpectedTypes: 'Expects images or videos',
                labelIdle: 'Drag & Drop your images/videos or <span class="filepond--label-action">Browse</span>',
                allowImagePreview: true,
                imagePreviewMaxHeight: 200,
                allowVideoPreview: true,
                allowRevert: true,
                allowRemove: true,
                allowReorder: true,
                storeAsFile: true,
                credits: false
            });

            // ✅ Enhanced video preview handler
            pond.on('addfile', (error, fileItem) => {
                if (error) {
                    console.error('Error adding file:', error);
                    return;
                }

                const fileType = fileItem.file.type;

                // Add custom video preview for better display
                if (fileType.startsWith('video/')) {
                    setTimeout(() => {
                        const fileItemElement = fileItem.element;
                        const existingVideo = fileItemElement.querySelector('video');

                        if (!existingVideo) {
                            const videoURL = URL.createObjectURL(fileItem.file);
                            const videoEl = document.createElement('video');
                            videoEl.src = videoURL;
                            videoEl.controls = true;
                            videoEl.style.width = '100%';
                            videoEl.style.maxHeight = '200px';
                            videoEl.style.marginTop = '8px';
                            videoEl.style.borderRadius = '8px';
                            videoEl.style.backgroundColor = '#000';

                            const previewContainer = fileItemElement.querySelector('.filepond--file-info');
                            if (previewContainer) {
                                previewContainer.appendChild(videoEl);
                            }
                        }
                    }, 100);
                }
            });

            // ✅ Clean up video URLs when files are removed
            pond.on('removefile', (error, fileItem) => {
                if (!error && fileItem.file.type.startsWith('video/')) {
                    const videoEl = fileItem.element.querySelector('video');
                    if (videoEl && videoEl.src) {
                        URL.revokeObjectURL(videoEl.src);
                    }
                }
            });
        });

        // ✅ Initialize TomSelect for Requirements
        new TomSelect("#requirementSelectTraining", {
            plugins: ['remove_button'],
            persist: false,
            create: true,
            delimiter: ',',
            placeholder: 'Select or add requirements...'
        });

        // ✅ Initialize TomSelect for Benefits
        new TomSelect("#benefitSelectTraining", {
            plugins: ['remove_button'],
            persist: false,
            create: true,
            delimiter: ',',
            placeholder: 'Select or add benefits...'
        });
                document.querySelector("form").addEventListener("submit", function(e) {
            const price = parseFloat(document.querySelector("input[name='Price']").value);
            const expDate = new Date(document.querySelector("input[name='Expiration']").value);
            const today = new Date();
            today.setHours(0,0,0,0);

            let errors = [];

            // Price validation
            if(price <= 0) {
                errors.push("Price must be greater than 0.");
            }

            // Expiration date validation
            if(expDate < today) {
                errors.push("Expiration date cannot be in the past.");
            }

            // Down Payment validation (if DPForm exists)
            const dpInput = document.querySelector("input[name='DownPayment']");
            if(dpInput) {
                const dpValue = parseFloat(dpInput.value);
                if(isNaN(dpValue) || dpValue <= 0) {
                    errors.push("Down payment must be a positive number.");
                } else if(dpValue >= price) {
                    errors.push("Down payment must be less than the full price.");
                }
            }

            if(errors.length > 0) {
                e.preventDefault(); // stop form submission
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Error',
                    html: errors.join("<br/>")
                });
            }
        });

    </script>
}