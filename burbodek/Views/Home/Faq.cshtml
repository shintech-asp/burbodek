@using burbodek.Models.ViewModels
@{
    ViewData["Title"] = "Frequently Ask Question";
}
@model FAQViewModel;
<!--begin::Hero card-->
<div class="card mb-12">
    <!--begin::Hero body-->
    <div class="card-body flex-column p-5">
        <!--begin::Hero nav-->
        <div class="card-rounded bg-light d-flex flex-stack flex-wrap p-5">
            <!--begin::Nav-->
            <ul class="nav flex-wrap border-transparent fw-bold">
                <!--begin::Nav item-->
                <li class="nav-item my-1">
                    <a class="btn btn-color-gray-600 btn-active-secondary btn-active-color-primary fw-bolder fs-8 fs-lg-base nav-link px-3 px-lg-8 mx-1 text-uppercase
                        active" asp-controller="Home" asp-action="Faq">
                        FAQ
                    </a>
                </li>
                <!--begin::Nav item-->
                <li class="nav-item my-1">
                    <a class="btn btn-color-gray-600 btn-active-secondary btn-active-color-primary fw-bolder fs-8 fs-lg-base nav-link px-3 px-lg-8 mx-1 text-uppercase
                        " asp-controller="Home" asp-action="Terms">
                        Terms And Condition
                    </a>
                </li>
            </ul>
            <!--end::Nav-->
        </div>
        <!--end::Hero nav-->
    </div>
    <!--end::Hero body-->
</div>
<!--end::Hero card-->
<!--begin::FAQ Description Card-->
<div class="card mb-5">
    <div class="card-header">
        <h3 class="card-title">FAQ Page Description</h3>
    </div>
    <div class="card-body">
        @{
            var FaqTitle = "";
            @if (Model.FaqTitle != null)
            {
                FaqTitle = Model.FaqTitle.Description;
            }
        }
        <div class="mb-5">
            <label class="form-label fw-bold">Description</label>
            <textarea name="Description" class="form-control" rows="5" id="FaqTitle" placeholder="Enter FAQ page description...">@FaqTitle</textarea>
        </div>
        <div class="text-end">
            <button class="btn btn-primary" type="button" id="SubmitFAQDescription">
                <i class="ki-duotone ki-check fs-2"></i>
                Update Description
            </button>
        </div>
    </div>
</div>
<!--end::FAQ Description Card-->
<!--begin::FAQ List Card-->
<div class="card mb-5">
    <div class="card-header">
        <h3 class="card-title">Existing FAQs</h3>
        <div class="card-toolbar">
            <span class="badge badge-light-primary">@Model.Faqs.Count Questions</span>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Faqs.Count > 0)
        {
            @for (int i = 0; i < Model.Faqs.Count; i++)
            {
                var data = Model.Faqs[i];
                var collapseId = $"kt_job_5_{i}";

                <div class="m-0">
                    <!--begin::Heading-->
                    <div class="d-flex align-items-center collapsible py-3 toggle mb-0" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false">
                        <!--begin::Icon-->
                        <div class="btn btn-sm btn-icon mw-20px btn-active-color-primary me-5">
                            <i class="ki-duotone ki-minus-square toggle-on text-primary fs-1">
                                <span class="path1"></span>
                                <span class="path2"></span>
                            </i>
                            <i class="ki-duotone ki-plus-square toggle-off fs-1">
                                <span class="path1"></span>
                                <span class="path2"></span>
                                <span class="path3"></span>
                            </i>
                        </div>
                        <!--end::Icon-->
                        <!--begin::Title-->
                        <h4 class="text-gray-700 fw-bold cursor-pointer mb-0 flex-grow-1">
                            @data.Title
                        </h4>
                        <!--end::Title-->
                        <!--begin::Actions-->
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-light-primary EditFaq"
                                    data-id="@data.Id"
                                    data-title="@data.Title"
                                    data-description="@data.Description">
                                <i class="ki-duotone ki-pencil fs-4">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                </i>
                                Edit
                            </button>
                            <button class="btn btn-sm btn-light-danger DeleteFaq" data-id="@data.Id">
                                <i class="ki-duotone ki-trash fs-4">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                    <span class="path3"></span>
                                    <span class="path4"></span>
                                    <span class="path5"></span>
                                </i>
                                Delete
                            </button>
                        </div>
                        <!--end::Actions-->
                    </div>
                    <!--end::Heading-->
                    <!--begin::Body-->
                    <div id="@collapseId" class="fs-6 ms-1 collapse">
                        <!--begin::Text-->
                        <div class="mb-4 text-gray-600 fw-semibold fs-6 ps-10">
                            @data.Description
                        </div>
                        <!--end::Text-->
                    </div>
                    <!--end::Content-->
                    <!--begin::Separator-->
                    <div class="separator separator-dashed"></div>
                    <!--end::Separator-->
                </div>
            }
        }
        else
        {
            <div class="text-center py-10">
                <i class="ki-duotone ki-question fs-5x text-gray-400 mb-5">
                    <span class="path1"></span>
                    <span class="path2"></span>
                    <span class="path3"></span>
                </i>
                <p class="text-gray-600 fs-4">No FAQs available yet</p>
                <p class="text-gray-400">Start by adding your first question below</p>
            </div>
        }
    </div>
</div>
<!--end::FAQ List Card-->
<!--begin::Add New FAQ Card-->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ki-duotone ki-plus-square fs-2 text-primary me-2">
                <span class="path1"></span>
                <span class="path2"></span>
                <span class="path3"></span>
            </i>
            Add New FAQ
        </h3>
    </div>
    <div class="card-body">
        <div class="row g-5">
            <div class="col-12">
                <label class="form-label fw-bold required">Question</label>
                <input type="text" class="form-control form-control-solid" id="Title" placeholder="Enter your question here..." />
            </div>
            <div class="col-12">
                <label class="form-label fw-bold required">Answer</label>
                <textarea class="form-control form-control-solid" rows="5" id="Answer" placeholder="Enter the answer here..."></textarea>
            </div>
            <div class="col-12 text-end">
                <button class="btn btn-light-primary me-3" type="button" id="ClearForm">
                    <i class="ki-duotone ki-cross fs-2">
                        <span class="path1"></span>
                        <span class="path2"></span>
                    </i>
                    Clear
                </button>
                <button class="btn btn-primary" id="SubmitQuestion" type="button">
                    <i class="ki-duotone ki-check fs-2">
                        <span class="path1"></span>
                        <span class="path2"></span>
                    </i>
                    Submit FAQ
                </button>
            </div>
        </div>
    </div>
</div>
<!--end::Add New FAQ Card-->
<!--begin::Edit FAQ Modal-->
<div class="modal fade" id="editFaqModal" tabindex="-1" aria-labelledby="editFaqModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editFaqModalLabel">Edit FAQ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editFaqForm">
                    <input type="hidden" id="EditFaqId" />

                    <div class="mb-5">
                        <label for="EditTitle" class="form-label fw-bold required">Question</label>
                        <input type="text" class="form-control form-control-solid" id="EditTitle" placeholder="Enter question" required />
                    </div>

                    <div class="mb-5">
                        <label for="EditAnswer" class="form-label fw-bold required">Answer</label>
                        <textarea class="form-control form-control-solid" id="EditAnswer" rows="5" placeholder="Enter answer" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="UpdateFaq">
                    <i class="ki-duotone ki-check fs-2">
                        <span class="path1"></span>
                        <span class="path2"></span>
                    </i>
                    Update FAQ
                </button>
            </div>
        </div>
    </div>
</div>
<!--end::Edit FAQ Modal-->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {

            // --- Clear Form ---
            $('#ClearForm').click(function () {
                $('#Title').val('');
                $('#Answer').val('');
            });

            // --- Submit FAQ with Confirmation ---
            $('#SubmitQuestion').click(function () {
                var title = $('#Title').val().trim();
                var answer = $('#Answer').val().trim();

                // Validation
                if (!title || !answer) {
                    Swal.fire({
                        title: 'Validation Error!',
                        text: 'Please fill in both question and answer fields.',
                        icon: 'warning',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                // Show confirmation dialog
                Swal.fire({
                    title: 'Add New FAQ?',
                    text: "Are you sure you want to add this FAQ?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, add it!',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Show loading
                        Swal.fire({
                            title: 'Submitting...',
                            text: 'Please wait',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });

                        $.ajax({
                            url: '@Url.Action("SubmitFaq", "Home")',
                            type: 'POST',
                            data: {
                                Title: title,
                                Description: answer
                            },
                            success: function (response) {
                                Swal.fire({
                                    title: 'Success!',
                                    text: 'FAQ added successfully.',
                                    icon: 'success',
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    location.reload();
                                });
                            },
                            error: function (xhr, status, error) {
                                Swal.fire({
                                    title: 'Error!',
                                    text: 'Error submitting FAQ: ' + error,
                                    icon: 'error',
                                    confirmButtonText: 'OK'
                                });
                            }
                        });
                    }
                });
            });

            // --- Submit FAQ Description with Confirmation ---
            $('#SubmitFAQDescription').click(function () {
                var description = $('#FaqTitle').val().trim();

                // Validation
                if (!description) {
                    Swal.fire({
                        title: 'Validation Error!',
                        text: 'Please enter a description.',
                        icon: 'warning',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                // Show confirmation dialog
                Swal.fire({
                    title: 'Update Description?',
                    text: "Are you sure you want to update the FAQ page description?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, update it!',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Show loading
                        Swal.fire({
                            title: 'Updating...',
                            text: 'Please wait',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });

                        $.ajax({
                            url: '@Url.Action("SubmitFaqDescription", "Home")',
                            type: 'POST',
                            data: {
                                Description: description
                            },
                            success: function (response) {
                                Swal.fire({
                                    title: 'Updated!',
                                    text: 'FAQ description updated successfully.',
                                    icon: 'success',
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    location.reload();
                                });
                            },
                            error: function (xhr, status, error) {
                                Swal.fire({
                                    title: 'Error!',
                                    text: 'Error updating FAQ description: ' + error,
                                    icon: 'error',
                                    confirmButtonText: 'OK'
                                });
                            }
                        });
                    }
                });
            });

            // --- Open Edit Modal ---
            $('.EditFaq').click(function (e) {
                e.stopPropagation();

                var id = $(this).data('id');
                var title = $(this).data('title');
                var description = $(this).data('description');

                $('#EditFaqId').val(id);
                $('#EditTitle').val(title);
                $('#EditAnswer').val(description);

                $('#editFaqModal').modal('show');
            });

            // --- Update FAQ with Confirmation ---
            $('#UpdateFaq').click(function () {
                var id = $('#EditFaqId').val();
                var title = $('#EditTitle').val().trim();
                var answer = $('#EditAnswer').val().trim();

                // Validation
                if (!title || !answer) {
                    Swal.fire({
                        title: 'Validation Error!',
                        text: 'Please fill in both question and answer fields.',
                        icon: 'warning',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                // Show confirmation dialog
                Swal.fire({
                    title: 'Update FAQ?',
                    text: "Are you sure you want to update this FAQ?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, update it!',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Show loading
                        Swal.fire({
                            title: 'Updating...',
                            text: 'Please wait',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });

                        $.ajax({
                            url: '@Url.Action("UpdateFaq", "Home")',
                            type: 'POST',
                            data: {
                                Id: id,
                                Title: title,
                                Description: answer
                            },
                            success: function (response) {
                                $('#editFaqModal').modal('hide');
                                Swal.fire({
                                    title: 'Success!',
                                    text: 'FAQ updated successfully.',
                                    icon: 'success',
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    location.reload();
                                });
                            },
                            error: function (xhr, status, error) {
                                Swal.fire({
                                    title: 'Error!',
                                    text: 'Error updating FAQ: ' + error,
                                    icon: 'error',
                                    confirmButtonText: 'OK'
                                });
                            }
                        });
                    }
                });
            });

            // --- Delete FAQ with Confirmation ---
            $('.DeleteFaq').click(function (e) {
                e.stopPropagation();

                var id = $(this).data('id');

                Swal.fire({
                    title: 'Delete FAQ?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Show loading
                        Swal.fire({
                            title: 'Deleting...',
                            text: 'Please wait',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });

                        $.ajax({
                            url: '@Url.Action("DeleteFaq", "Home")',
                            type: 'POST',
                            data: { Id: id },
                            success: function (response) {
                                Swal.fire({
                                    title: 'Deleted!',
                                    text: 'FAQ has been deleted.',
                                    icon: 'success',
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    location.reload();
                                });
                            },
                            error: function (xhr, status, error) {
                                Swal.fire({
                                    title: 'Error!',
                                    text: 'Error deleting FAQ: ' + error,
                                    icon: 'error',
                                    confirmButtonText: 'OK'
                                });
                            }
                        });
                    }
                });
            });

        });
    </script>
}