@{
    ViewData["Title"] = "Admin Dashboard";
}
@model burbodek.Models.ViewModels.AdminDashboardViewModel

<style>
    .stat-card {
        border-radius: 16px;
        border: none;
        transition: transform 0.2s, box-shadow 0.2s;
        overflow: hidden;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.10) !important;
        }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: #1e2a3a;
        letter-spacing: -0.2px;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9ff;
        cursor: default;
    }

    .badge-status {
        border-radius: 8px;
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 600;
    }

    .user-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #e9ecef;
        flex-shrink: 0;
    }

    .chart-wrapper {
        position: relative;
        height: 280px;
    }

    .plan-badge {
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .new-user-row {
        padding: 10px 0;
        border-bottom: 1px solid #f1f3f7;
        transition: all 0.15s;
    }

        .new-user-row:last-child {
            border-bottom: none;
        }

        .new-user-row:hover {
            background: #f8f9ff;
            border-radius: 8px;
            padding-left: 6px;
        }

    .day-label {
        font-size: 11px;
        color: #a1a5b7;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
        padding-top: 8px;
        border-top: 1px dashed #e9ecef;
        margin-top: 8px;
    }

        .day-label:first-child {
            border-top: none;
            margin-top: 0;
            padding-top: 0;
        }
</style>

<div class="d-flex flex-column flex-root">
    <div class="page d-flex flex-row flex-column-fluid">
        <div class="wrapper d-flex flex-column flex-row-fluid" id="kt_wrapper">
            <div class="content d-flex flex-column flex-column-fluid py-6">
                <div class="container-xxl">

                    <!-- Page Title -->
                    <div class="d-flex align-items-center justify-content-between mb-7">
                        <div>
                            <h2 class="fw-bold text-gray-900 mb-1">Admin Dashboard</h2>
                            <span class="text-muted fs-6">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
                        </div>
                    </div>

                    <!-- ===== STAT CARDS ===== -->
                    <div class="row g-5 mb-7">

                        <div class="col-sm-6 col-xl-3">
                            <div class="card stat-card shadow-sm h-100">
                                <div class="card-body d-flex align-items-center gap-4 p-5">
                                    <div class="stat-icon" style="background:#e8f4fd;">
                                        <i class="ki-duotone ki-dollar fs-2 text-primary">
                                            <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        </i>
                                    </div>
                                    <div>
                                        <div class="text-muted fs-7 fw-semibold mb-1">Today's Revenue</div>
                                        <div class="fs-3 fw-bold text-gray-800">₱@Model.TodayRevenue.ToString("N0")</div>
                                        <div class="fs-8 text-success fw-semibold mt-1">From subscriptions</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-xl-3">
                            <div class="card stat-card shadow-sm h-100">
                                <div class="card-body d-flex align-items-center gap-4 p-5">
                                    <div class="stat-icon" style="background:#e8f5e9;">
                                        <i class="ki-duotone ki-profile-circle fs-2 text-success">
                                            <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        </i>
                                    </div>
                                    <div>
                                        <div class="text-muted fs-7 fw-semibold mb-1">New Users (7 days)</div>
                                        <div class="fs-3 fw-bold text-gray-800">@Model.NewUsersThisWeek</div>
                                        <div class="fs-8 text-muted fw-semibold mt-1">Joined this week</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-xl-3">
                            <div class="card stat-card shadow-sm h-100">
                                <div class="card-body d-flex align-items-center gap-4 p-5">
                                    <div class="stat-icon" style="background:#fff3e0;">
                                        <i class="ki-duotone ki-crown fs-2 text-warning">
                                            <span class="path1"></span><span class="path2"></span>
                                        </i>
                                    </div>
                                    <div>
                                        <div class="text-muted fs-7 fw-semibold mb-1">Active Subscriptions</div>
                                        <div class="fs-3 fw-bold text-gray-800">@Model.ActiveSubscriptions</div>
                                        <div class="fs-8 text-muted fw-semibold mt-1">Currently active</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-xl-3">
                            <div class="card stat-card shadow-sm h-100">
                                <div class="card-body d-flex align-items-center gap-4 p-5">
                                    <div class="stat-icon" style="background:#fce4ec;">
                                        <i class="ki-duotone ki-chart fs-2 text-danger">
                                            <span class="path1"></span><span class="path2"></span>
                                        </i>
                                    </div>
                                    <div>
                                        <div class="text-muted fs-7 fw-semibold mb-1">Weekly Revenue</div>
                                        <div class="fs-3 fw-bold text-gray-800">₱@Model.WeeklyRevenue.ToString("N0")</div>
                                        <div class="fs-8 text-muted fw-semibold mt-1">Last 7 days</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Campaign Revenue Card -->
                        <div class="col-sm-6 col-xl-3">
                            <div class="card stat-card shadow-sm h-100">
                                <div class="card-body d-flex align-items-center gap-4 p-5">
                                    <div class="stat-icon" style="background:#f3e5f5;">
                                        <i class="ki-duotone ki-rocket fs-2 text-info">
                                            <span class="path1"></span><span class="path2"></span>
                                        </i>
                                    </div>
                                    <div>
                                        <div class="text-muted fs-7 fw-semibold mb-1">Campaign Revenue</div>
                                        <div class="fs-3 fw-bold text-gray-800">₱@Model.CampaignRevenue.ToString("N0")</div>
                                        <div class="fs-8 text-muted fw-semibold mt-1">@Model.ActiveCampaigns active campaigns</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-xl-3">
                            <div class="card stat-card shadow-sm h-100">
                                <div class="card-body d-flex align-items-center gap-4 p-5">
                                    <div class="stat-icon" style="background:#e8f5e9;">
                                        <i class="ki-duotone ki-abstract-26 fs-2 text-success">
                                            <span class="path1"></span><span class="path2"></span>
                                        </i>
                                    </div>
                                    <div>
                                        <div class="text-muted fs-7 fw-semibold mb-1">Total Campaigns</div>
                                        <div class="fs-3 fw-bold text-gray-800">@Model.TotalCampaigns</div>
                                        <div class="fs-8 text-muted fw-semibold mt-1">All time</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ===== CHART + NEW USERS ===== -->
                    <div class="row g-5 mb-7">

                        <!-- Daily Revenue Chart -->
                        <div class="col-lg-8">
                            <div class="card shadow-sm h-100" style="border-radius:16px; border:none;">
                                <div class="card-body p-6">
                                    <div class="d-flex align-items-center justify-content-between mb-6">
                                        <div>
                                            <div class="section-title">Daily Revenue Flow</div>
                                            <div class="text-muted fs-7">Subscription income over the past 7 days</div>
                                        </div>
                                        <span class="badge badge-light-primary px-4 py-2 fs-7">Last 7 Days</span>
                                    </div>
                                    <div class="chart-wrapper">
                                        <canvas id="revenueChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Newly Joined Users -->
                        <div class="col-lg-4">
                            <div class="card shadow-sm h-100" style="border-radius:16px; border:none;">
                                <div class="card-body p-6">
                                    <div class="d-flex align-items-center justify-content-between mb-5">
                                        <div>
                                            <div class="section-title">New Members</div>
                                            <div class="text-muted fs-7">Joined this week</div>
                                        </div>
                                        <span class="badge badge-light-success px-3 py-2 fs-8">
                                            @Model.NewUsersThisWeek total
                                        </span>
                                    </div>

                                    <div style="max-height:310px; overflow-y:auto; padding-right:4px;">
                                        @{
                                            var grouped = Model.NewUsers
                                            .GroupBy(u => u.DateCreated.Date)
                                            .OrderByDescending(g => g.Key);
                                        }
                                        @if (Model.NewUsers.Any())
                                        {
                                            @foreach (var group in grouped)
                                            {
                                                <div class="day-label">
                                                    @(group.Key.Date == DateTime.Today ? "Today" :
                                                                                                group.Key.Date == DateTime.Today.AddDays(-1) ? "Yesterday" :
                                                                                                group.Key.ToString("dddd, MMM dd"))
                                        </div>
                                        @foreach (var user in group)
                                                {
                                                    <div class="new-user-row d-flex align-items-center gap-3">
                                                        <img src="@(user.UserProfile?.Picture ?? "/assets/media/avatars/300-14.jpg")"
                                                             class="user-avatar" alt="@user.Username" />
                                                        <div class="flex-grow-1 min-w-0">
                                                            <div class="fw-bold text-gray-800 fs-7 text-truncate">@user.Username</div>
                                                            <div class="text-muted fs-8 text-truncate">@user.Email</div>
                                                        </div>
                                                        @{
                                                            var roleColor = user.Role?.ToLower() switch
                                                            {
                                                                "employer" => "primary",
                                                                "employee" => "success",
                                                                "admin" => "danger",
                                                                _ => "secondary"
                                                            };
                                                        }
                                                        <span class="badge badge-light-@roleColor fs-9">@user.Role</span>
                                                    </div>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-center text-muted py-6 fs-7">No new users this week.</div>
                                        }
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ===== LATEST SUBSCRIPTIONS TABLE ===== -->
                    <div class="card shadow-sm mb-7" style="border-radius:16px; border:none;">
                        <div class="card-body p-6">
                            <div class="d-flex align-items-center justify-content-between mb-6">
                                <div>
                                    <div class="section-title">Latest Subscriptions</div>
                                    <div class="text-muted fs-7">Most recent subscription transactions</div>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle gs-0 gy-3">
                                    <thead>
                                        <tr class="fw-bold text-muted bg-light">
                                            <th class="ps-4 rounded-start" style="min-width:220px;">User</th>
                                            <th style="min-width:130px;">Plan</th>
                                            <th style="min-width:120px;">Price</th>
                                            <th style="min-width:140px;">Subscribed</th>
                                            <th style="min-width:140px;">Expires</th>
                                            <th class="pe-4 rounded-end" style="min-width:100px;">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="text-gray-600 fw-semibold">
                                        @if (Model.LatestSubscriptions.Any())
                                        {
                                            @foreach (var sub in Model.LatestSubscriptions)
                                            {
                                                <tr>
                                                    <td class="ps-4">
                                                        <div class="d-flex align-items-center gap-3">
                                                            <img src="@(sub.Users?.UserProfile?.Picture ?? "/assets/media/avatars/300-14.jpg")"
                                                                 class="user-avatar" alt="@sub.Users?.Username" />
                                                            <div>
                                                                <div class="fw-bold text-gray-800">@sub.Users?.Username</div>
                                                                <div class="text-muted fs-8">@sub.Users?.Email</div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @{
                                                            var planColor = sub.Plans?.PlanName?.ToLower() switch
                                                            {
                                                                "premium" => "warning",
                                                                "basic" => "primary",
                                                                "pro" => "info",
                                                                _ => "secondary"
                                                            };
                                                        }
                                                        <span class="plan-badge badge badge-light-@planColor">
                                                            @(sub.Plans?.PlanName ?? "—")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="fw-bold text-gray-800">
                                                            ₱@((sub.Plans?.Price ?? 0).ToString("N0"))
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="text-gray-700">@sub.CreatedAt.ToString("MMM dd, yyyy")</span>
                                                        <div class="text-muted fs-8">@sub.CreatedAt.ToString("hh:mm tt")</div>
                                                    </td>
                                                    <td>
                                                        @if (sub.Expiration.HasValue)
                                                        {
                                                            <span class="text-gray-700">@sub.Expiration.Value.ToString("MMM dd, yyyy")</span>
                                                            <div class="text-muted fs-8">@sub.Expiration.Value.ToString("hh:mm tt")</div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">—</span>
                                                        }
                                                    </td>
                                                    <td class="pe-4">
                                                        @if (sub.Status?.ToLower() == "active")
                                                        {
                                                            <span class="badge badge-light-success badge-status">Active</span>
                                                        }
                                                        else if (sub.Status?.ToLower() == "expired")
                                                        {
                                                            <span class="badge badge-light-danger badge-status">Expired</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-light-secondary badge-status">@(sub.Status ?? "—")</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-6 fst-italic">No subscriptions found.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- ===== LATEST CAMPAIGNS TABLE ===== -->
                    <div class="card shadow-sm" style="border-radius:16px; border:none;">
                        <div class="card-body p-6">
                            <div class="d-flex align-items-center justify-content-between mb-6">
                                <div>
                                    <div class="section-title">Latest Campaigns</div>
                                    <div class="text-muted fs-7">Most recently created campaigns</div>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle gs-0 gy-3">
                                    <thead>
                                        <tr class="fw-bold text-muted bg-light">
                                            <th class="ps-4 rounded-start" style="min-width:220px;">Campaign</th>
                                            <th style="min-width:160px;">Created By</th>
                                            <th style="min-width:160px;">Listing</th>
                                            <th style="min-width:100px;">Clicks</th>
                                            <th style="min-width:120px;">Payment</th>
                                            <th class="pe-4 rounded-end" style="min-width:110px;">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="text-gray-600 fw-semibold">
                                        @if (Model.LatestCampaigns.Any())
                                        {
                                            @foreach (var campaign in Model.LatestCampaigns)
                                            {
                                                <tr>
                                                    <td class="ps-4">
                                                        <div class="d-flex align-items-center gap-3">
                                                            @if (!string.IsNullOrEmpty(campaign.LogoFilePath))
                                                            {
                                                                <img src="@campaign.LogoFilePath"
                                                                     class="user-avatar" alt="@campaign.CampaignName" />
                                                            }
                                                            else
                                                            {
                                                                <div class="stat-icon" style="background:#f3e5f5; width:36px; height:36px; min-width:36px; border-radius:8px;">
                                                                    <i class="ki-duotone ki-rocket fs-6 text-info">
                                                                        <span class="path1"></span><span class="path2"></span>
                                                                    </i>
                                                                </div>
                                                            }
                                                            <div>
                                                                <div class="fw-bold text-gray-800">@campaign.CampaignName</div>
                                                                <div class="text-muted fs-8">@campaign.City, @campaign.Province</div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <img src="@(campaign.CreatedByUser?.UserProfile?.Picture ?? "/assets/media/avatars/300-14.jpg")"
                                                                 class="user-avatar" alt="@campaign.CreatedByUser?.Username" />
                                                            <div>
                                                                <div class="fw-bold text-gray-800 fs-7">@campaign.CreatedByUser?.Username</div>
                                                                <div class="text-muted fs-8">@campaign.CreatedByUser?.Email</div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @if (campaign.ListingType == "Job" && campaign.SelectedJob != null)
                                                        {
                                                            <span class="badge badge-light-primary fs-8">
                                                                💼 @campaign.SelectedJob.JobTitle
                                                            </span>
                                                        }
                                                        else if (campaign.ListingType == "Training" && campaign.SelectedTraining != null)
                                                        {
                                                            <span class="badge badge-light-warning fs-8">
                                                                🎓 @campaign.SelectedTraining.Name
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted fs-8">—</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="fw-bold text-gray-800">@campaign.TotalClicks.ToString("N0")</span>
                                                        <div class="text-muted fs-8">clicks</div>
                                                    </td>
                                                    <td>
                                                        <span class="fw-bold text-gray-800">
                                                            ₱@((campaign.Payment ?? 0).ToString("N0"))
                                                        </span>
                                                    </td>
                                                    <td class="pe-4">
                                                        @if (campaign.isPaid == true && campaign.IsActive)
                                                        {
                                                            <span class="badge badge-light-success badge-status">Active</span>
                                                        }
                                                        else if (campaign.isPaid == true && !campaign.IsActive)
                                                        {
                                                            <span class="badge badge-light-secondary badge-status">Ended</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-light-danger badge-status">Unpaid</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-6 fst-italic">No campaigns found.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <!-- END CAMPAIGNS TABLE -->

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
                    Model.DailyRevenue.Select(d => d.Date.ToString("MMM dd")).ToList()
            ));

    const values = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
                Model.DailyRevenue.Select(d => (double)d.Total).ToList()
        ));

    const ctx = document.getElementById('revenueChart').getContext('2d');

        const gradient = ctx.createLinearGradient(0, 0, 0, 280);
        gradient.addColorStop(0, 'rgba(13, 110, 253, 0.25)');
        gradient.addColorStop(1, 'rgba(13, 110, 253, 0.00)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Revenue (₱)',
                    data: values,
                    fill: true,
                    backgroundColor: gradient,
                    borderColor: '#0d6efd',
                    borderWidth: 2.5,
                    pointBackgroundColor: '#0d6efd',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 7,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e2a3a',
                        titleColor: '#a1a5b7',
                        bodyColor: '#fff',
                        padding: 12,
                        callbacks: {
                            label: ctx => ' ₱' + ctx.parsed.y.toLocaleString()
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: '#a1a5b7', font: { size: 12 } }
                    },
                    y: {
                        grid: { color: '#f1f3f7', lineWidth: 1 },
                        ticks: {
                            color: '#a1a5b7',
                            font: { size: 12 },
                            callback: val => '₱' + val.toLocaleString()
                        }
                    }
                }
            }
        });
    </script>
}