@{
    ViewData["Title"] = "Subscription Plans";
}
@model List<Plans>
<!--begin::FAQ card-->
<div class="card">
    <!--begin::Body-->
    <div class="card-body p-10 p-lg-15">
        <!--begin::Classic content-->
        <div class="mb-13">
            <!--begin::Intro-->
            <div class="mb-15">
                <!--begin::Title-->
                <h4 class="fs-2x text-gray-800 w-bolder mb-6">
                    Subscription/Plan Configuration
                </h4>
                <!--end::Title-->
                <!--begin::Text-->
                <div class="fs-6 fw-semibold text-gray-600 mb-5">
                    <p>
                        Manage your subscription plans here. You can update plans as needed to suit your business requirements.
                    </p>
                </div>

                <!--end::Text-->
                <div class="table">
                    <div class="table-responsive">
                        <table class="table gs-7 gy-7 gx-7">
                            <thead>
                                <tr class="fw-semibold fs-6 text-gray-800 border-bottom border-gray-200">
                                    <th>Plan</th>
                                    <th>Details</th>
                                    <th>Price</th>
                                    <th>Discount in percentage</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var data in Model)
                                {
                                    <tr>
                                        <td>@data.PlanName</td>
                                        <td>@data.PlanDetails</td>
                                        <td>@data.Price</td>
                                        <td>@data.Discount</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary EditSubscription"
                                                    data-id="@data.Id"
                                                    data-planname="@data.PlanName"
                                                    data-plandetails="@data.PlanDetails"
                                                    data-price="@data.Price"
                                                    data-discount="@data.Discount">
                                                Edit
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!--end::Intro-->
        </div>
        <!--end::Classic content-->
    </div>
    <!--end::Body-->
</div>
<!--end::FAQ card-->
<!--begin::Edit Subscription Modal-->
<div class="modal fade" id="editSubscriptionModal" tabindex="-1" aria-labelledby="editSubscriptionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editSubscriptionModalLabel">Edit Subscription Plan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editSubscriptionForm">
                    <input type="hidden" id="SubscriptionId" />

                    <div class="mb-5">
                        <label for="PlanName" class="form-label fw-bold">Plan Name</label>
                        <input type="text" class="form-control" id="PlanName" placeholder="Enter plan name" required />
                    </div>

                    <div class="mb-5">
                        <label for="PlanDetails" class="form-label fw-bold">Plan Details</label>
                        <textarea class="form-control" id="PlanDetails" rows="3" placeholder="Enter plan details" required></textarea>
                    </div>

                    <div class="mb-5">
                        <label for="Price" class="form-label fw-bold">Price</label>
                        <input type="number" class="form-control" id="Price" placeholder="Enter price" step="0.01" required />
                    </div>

                    <div class="mb-5">
                        <label for="Discount" class="form-label fw-bold">Discount (%)</label>
                        <input type="number" class="form-control" id="Discount" placeholder="Enter discount percentage" min="0" max="100" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="UpdateSubscription">Update Plan</button>
            </div>
        </div>
    </div>
</div>
<!--end::Edit Subscription Modal-->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {

            // --- Open Edit Modal ---
            $('.EditSubscription').click(function () {
                var id = $(this).data('id');
                var planName = $(this).data('planname');
                var planDetails = $(this).data('plandetails');
                var price = $(this).data('price');
                var discount = $(this).data('discount');

                // Populate modal fields
                $('#SubscriptionId').val(id);
                $('#PlanName').val(planName);
                $('#PlanDetails').val(planDetails);
                $('#Price').val(price);
                $('#Discount').val(discount);

                // Show modal
                $('#editSubscriptionModal').modal('show');
            });

            // --- Update Subscription with Confirmation ---
            $('#UpdateSubscription').click(function () {
                var id = $('#SubscriptionId').val();
                var planName = $('#PlanName').val();
                var planDetails = $('#PlanDetails').val();
                var price = $('#Price').val();
                var discount = $('#Discount').val();

                // Basic validation
                if (!planName || !planDetails || !price || !discount) {
                    Swal.fire({
                        title: 'Validation Error!',
                        text: 'Please fill in all fields.',
                        icon: 'warning',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                // Show confirmation dialog
                Swal.fire({
                    title: 'Are you sure?',
                    text: "Do you want to update this subscription plan?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, update it!',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Show loading
                        Swal.fire({
                            title: 'Updating...',
                            text: 'Please wait',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });

                        // Perform AJAX request
                        $.ajax({
                            url: '@Url.Action("UpdateSubscription", "Home")',
                            type: 'POST',
                            data: {
                                Id: id,
                                PlanName: planName,
                                PlanDetails: planDetails,
                                Price: price,
                                Discount: discount
                            },
                            success: function (response) {
                                $('#editSubscriptionModal').modal('hide');
                                Swal.fire({
                                    title: 'Success!',
                                    text: 'Subscription plan updated successfully.',
                                    icon: 'success',
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    location.reload();
                                });
                            },
                            error: function (xhr, status, error) {
                                Swal.fire({
                                    title: 'Error!',
                                    text: 'Error updating subscription: ' + error,
                                    icon: 'error',
                                    confirmButtonText: 'OK'
                                });
                            }
                        });
                    }
                });
            });


        });
    </script>
}