@using burbodek.Models.ViewModels
@{
	ViewData["Title"] = "Cruise Ship Jobs";
	Layout = "_LayoutClient";
}
@model FAQViewModel
<!--begin::Content-->
<div class="content flex-column-fluid" id="kt_content">
	<!--begin::Hero Section with Wave-->
	<div class="position-relative overflow-hidden">
		<!-- Background wave shape -->
		<svg class="position-absolute top-0 start-0 w-100 h-100" style="z-index:-2;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none">
			<path fill="#009EF7" fill-opacity="1" d="M0,128L40,138.7C80,149,160,171,240,165.3C320,160,400,128,480,144C560,160,640,224,720,224C800,224,880,160,960,144C1040,128,1120,160,1200,181.3C1280,203,1360,213,1400,218.7L1440,224L1440,320L0,320Z"></path>
		</svg>

		<!-- Gradient overlay -->
		<div class="position-absolute top-0 start-0 w-100 h-100"
			 style="background: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,158,247,0.8)); z-index:-1;">
		</div>

		<div class="py-20 container text-center text-white">
			<h1 class="fw-bolder display-4 mb-5">Find Your Career at Sea 🌊</h1>
			<p class="fs-5 fw-light mb-8">
				Explore exciting opportunities on luxury cruise ships.
				<span class="fw-bold">Set sail toward your dream career today!</span>
			</p>
			<a asp-controller="Index" asp-action="BrowseJob" class="btn btn-lg btn-light me-3 shadow">Browse Jobs</a>
			<a asp-controller="Index" asp-action="SignUpEmployer" class="btn btn-lg btn-outline-light shadow">Post a Job</a>
		</div>
	</div>
	<!--end::Hero Section-->
	<!--begin::Features Section-->
	<div class="py-20">
		<div class="container">
			<div class="row g-10">
				<div class="col-lg-4">
					<div class="card shadow-lg border-0 h-100 hover-elevate-up">
						<div class="card-body text-center py-10">
							<i class="ki-duotone ki-briefcase fs-3hx text-primary mb-5"></i>
							<h3 class="fw-bold">Job Opportunities</h3>
							<p class="text-gray-600">
								Thousands of positions across hospitality, entertainment, and technical fields.
							</p>
						</div>
					</div>
				</div>
				<div class="col-lg-4">
					<div class="card shadow-lg border-0 h-100 hover-elevate-up">
						<div class="card-body text-center py-10">
							<i class="ki-duotone ki-user fs-3hx text-success mb-5"></i>
							<h3 class="fw-bold">Verified Employers</h3>
							<p class="text-gray-600">
								Partnered with trusted cruise companies ensuring safe and authentic opportunities.
							</p>
						</div>
					</div>
				</div>
				<div class="col-lg-4">
					<div class="card shadow-lg border-0 h-100 hover-elevate-up">
						<div class="card-body text-center py-10">
							<i class="ki-duotone ki-search-list fs-3hx text-warning mb-5"></i>
							<h3 class="fw-bold">Easy Application</h3>
							<p class="text-gray-600">
								Apply online, upload your resume, and track everything in one platform.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!--end::Features Section-->
	<div class="container mb-3">
		<div class="card card-flush">
			<!--begin::Header-->
			<div class="card-header py-7">
				<!--begin::Statistics-->
				<div class="m-0">
					<!--begin::Heading-->
					<div class="d-flex align-items-center mb-2">
						<!--begin::Title-->
						<span class="fs-2hx fw-bold text-gray-800 me-2 lh-1 ls-n2">35,568</span>
						<!--end::Title-->
					</div>
					<!--end::Heading-->
					<!--begin::Description-->
					<span class="fs-6 fw-semibold text-gray-400">Who trusted us?</span>
					<!--end::Description-->
				</div>
				<!--end::Statistics-->
				<!--begin::Toolbar-->
				<div class="card-toolbar">
					<!--begin::Menu-->
					<button class="btn btn-icon btn-color-gray-400 btn-active-color-primary justify-content-end" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end" data-kt-menu-overflow="true">
						<i class="ki-duotone ki-dots-square fs-1 text-gray-400 me-n1">
							<span class="path1"></span>
							<span class="path2"></span>
							<span class="path3"></span>
							<span class="path4"></span>
						</i>
					</button>
					<!--begin::Menu 2-->
					<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px" data-kt-menu="true">
						<!--begin::Menu item-->
						<div class="menu-item px-3">
							<div class="menu-content fs-6 text-dark fw-bold px-3 py-4">Quick Actions</div>
						</div>
						<!--end::Menu item-->
						<!--begin::Menu separator-->
						<div class="separator mb-3 opacity-75"></div>
						<!--end::Menu separator-->
						<!--begin::Menu item-->
						<div class="menu-item px-3">
							<a href="#" class="menu-link px-3">New Ticket</a>
						</div>
						<!--end::Menu item-->
						<!--begin::Menu item-->
						<div class="menu-item px-3">
							<a href="#" class="menu-link px-3">New Customer</a>
						</div>
						<!--end::Menu item-->
						<!--begin::Menu item-->
						<div class="menu-item px-3" data-kt-menu-trigger="hover" data-kt-menu-placement="right-start">
							<!--begin::Menu item-->
							<a href="#" class="menu-link px-3">
								<span class="menu-title">New Group</span>
								<span class="menu-arrow"></span>
							</a>
							<!--end::Menu item-->
							<!--begin::Menu sub-->
							<div class="menu-sub menu-sub-dropdown w-175px py-4">
								<!--begin::Menu item-->
								<div class="menu-item px-3">
									<a href="#" class="menu-link px-3">Admin Group</a>
								</div>
								<!--end::Menu item-->
								<!--begin::Menu item-->
								<div class="menu-item px-3">
									<a href="#" class="menu-link px-3">Staff Group</a>
								</div>
								<!--end::Menu item-->
								<!--begin::Menu item-->
								<div class="menu-item px-3">
									<a href="#" class="menu-link px-3">Member Group</a>
								</div>
								<!--end::Menu item-->
							</div>
							<!--end::Menu sub-->
						</div>
						<!--end::Menu item-->
						<!--begin::Menu item-->
						<div class="menu-item px-3">
							<a href="#" class="menu-link px-3">New Contact</a>
						</div>
						<!--end::Menu item-->
						<!--begin::Menu separator-->
						<div class="separator mt-3 opacity-75"></div>
						<!--end::Menu separator-->
						<!--begin::Menu item-->
						<div class="menu-item px-3">
							<div class="menu-content px-3 py-3">
								<a class="btn btn-primary btn-sm px-4" href="#">Generate Reports</a>
							</div>
						</div>
						<!--end::Menu item-->
					</div>
					<!--end::Menu 2-->
					<!--end::Menu-->
				</div>
				<!--end::Toolbar-->
			</div>
			<!--end::Header-->
			<!--begin::Body-->
			<div class="card-body pt-0 pb-1">
				<div id="kt_charts_widget_27" class="min-h-auto" style="min-height: 365px;"></div>
			</div>
			<!--end::Body-->
		</div>
	</div>
	@if (Model.FaqTitle != null && Model.Faqs.Count > 0)
	{
		<div class="container mb-3">
			<div class="card-body p-10 p-lg-15">
				<div class="mb-13">
					<div class="mb-15">
						<h4 class="fs-2x text-gray-800 w-bolder mb-6">Frequently Asked Questions</h4>
						<p class="fw-semibold fs-4 text-gray-600 mb-2">@Model.FaqTitle.Description</p>
					</div>
					<div class="row">
						<div class="col-md-6 pe-md-10 mb-10 mb-md-0">
							<h2 class="text-gray-800 w-bolder mb-4">Our platform</h2>
							<!--end::Title-->
							@for (int i = 0; i < Model.Faqs.Count; i++)
							{
								var data = Model.Faqs[i];
								var collapseId = $"kt_job_6_{i}";

								<!--begin::Section-->
								<div class="m-0">
									<!--begin::Heading-->
									<div class="d-flex align-items-center collapsible py-3 toggle collapsed mb-0" data-bs-toggle="collapse" data-bs-target="#@collapseId">
										<!--begin::Icon-->
										<div class="btn btn-sm btn-icon mw-20px btn-active-color-primary me-5">
											<i class="ki-duotone ki-minus-square toggle-on text-primary fs-1">
												<span class="path1"></span>
												<span class="path2"></span>
											</i>
											<i class="ki-duotone ki-plus-square toggle-off fs-1">
												<span class="path1"></span>
												<span class="path2"></span>
												<span class="path3"></span>
											</i>
										</div>
										<!--end::Icon-->
										<!--begin::Title-->
										<h4 class="text-gray-700 fw-bold cursor-pointer mb-0">@data.Title</h4>
										<!--end::Title-->
									</div>
									<!--end::Heading-->
									<!--begin::Body-->
									<div id="@collapseId" class="collapse fs-6 ms-1">
										<!--begin::Text-->
										<div class="mb-4 text-gray-600 fw-semibold fs-6 ps-10">@data.Description</div>
										<!--end::Text-->
									</div>
									<!--end::Content-->
								</div>
								<!--end::Section-->
							}
						</div>
					</div>
					<!--end::Row-->
				</div>
				<!--end::Classic content-->
			</div>
		</div>
	}
</div>
<!--end::Content-->