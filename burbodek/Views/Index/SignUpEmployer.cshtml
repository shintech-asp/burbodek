	<!--begin::Javascript-->
	<script>var hostUrl = "~/assets/";</script>
	<!--begin::Global Javascript Bundle(mandatory for all pages)-->
	<script src="~/assets/plugins/global/plugins.bundle.js" asp-append-version="true"></script>
	<script src="~/assets/js/scripts.bundle.js" asp-append-version="true"></script>
	<link href="~/assets/plugins/custom/select2/select2.bundle.css" rel="stylesheet" />
	<script src="~/assets/plugins/custom/select2/select2.bundle.js" asp-append-version="true"></script>
    <script src="~/assets/js/leaflet.js" asp-append-version="true"></script>
	<!--end::Global Javascript Bundle-->
	<!--begin::Custom Javascript(used for this page only)-->
	<script src="~/assets/js/custom/utilities/modals/create-account.js" asp-append-version="true"></script>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<!--end::Custom Javascript-->
	<script>
		@if (TempData["Success"] != null)
		{
				<text>
					Swal.fire({
						icon: 'success',
						title: 'Success!',
						text: '@TempData["Success"]',
						showConfirmButton: false,
						timer: 2000
					});
				</text>
		}
		@if (TempData["Error"] != null)
		{
				<text>
					Swal.fire({
						icon: 'error',
						title: 'Oops...',
						text: '@TempData["Error"]',
						confirmButtonColor: '#d33'
					});
				</text>
		}

		document.addEventListener('DOMContentLoaded', function () {

			// ─── File size validation ───────────────────────────────────────────
			document.querySelectorAll(".file-upload").forEach(input => {
				input.addEventListener("change", function () {
					const file = this.files[0];
					const maxSize = 5 * 1024 * 1024;
					if (file && file.size > maxSize) {
						alert("File must not exceed 5MB.");
						this.value = "";
					}
				});
			});

			// ─── Map setup (Metro Manila only) ─────────────────────────────────
			const manilaBounds = [
				[14.3500, 120.8000],
				[14.9500, 121.2000]
			];

			const map = L.map('map', {
				center: [14.5995, 120.9842],
				zoom: 11,
				scrollWheelZoom: true,
				maxBounds: manilaBounds,
				maxBoundsViscosity: 1.0,
				minZoom: 10,
				maxZoom: 19
			});

			L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
				attribution: '© OpenStreetMap contributors',
				maxZoom: 19
			}).addTo(map);

			let marker = null;

			// ─── Stepper next → invalidate map size ────────────────────────────
			const nextButtons = document.querySelectorAll('[data-kt-stepper-action="next"]');
			nextButtons.forEach(btn => {
				btn.addEventListener('click', () => {
					setTimeout(() => { map.invalidateSize(); }, 150);
				});
			});

			// ─── Metro Manila city list ─────────────────────────────────────────
			const validRegions = [
				'Metro Manila', 'National Capital Region', 'NCR',
				'Manila', 'Quezon City', 'Makati', 'Pasig', 'Taguig',
				'Mandaluyong', 'Marikina', 'Pasay', 'Parañaque',
				'Las Piñas', 'Muntinlupa', 'Valenzuela', 'Navotas',
				'Malabon', 'Caloocan', 'San Juan', 'Pateros'
			];

			// ─── Map click handler ──────────────────────────────────────────────
			map.on('click', async function (e) {
				const lat = e.latlng.lat.toFixed(6);
				const lng = e.latlng.lng.toFixed(6);
				const latNum = parseFloat(lat);
				const lngNum = parseFloat(lng);

				// Hard bounding box check first (before API call)
				if (
					latNum < 14.3500 || latNum > 14.9500 ||
					lngNum < 120.8000 || lngNum > 121.2000
				) {
					Swal.fire({
						title: 'Out of Range',
						text: 'Please select a location within the Metro Manila area only.',
						icon: 'warning',
						confirmButtonText: 'OK'
					});
					return;
				}

				document.getElementById("Latitude").value = '0';
				document.getElementById("Longitude").value = '0';

				try {
					const response = await fetch(
						`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`
					);
					if (!response.ok) throw new Error('Geocoding service unavailable');

					const data = await response.json();
					const address = data.address || {};

					// Block water/ocean clicks
					if (!address.state && !address.county && !address.city) {
						if (marker) { map.removeLayer(marker); marker = null; }
						Swal.fire({
							title: 'Invalid Location',
							text: 'You selected a water area. Please pin a location on land within Metro Manila.',
							icon: 'warning',
							confirmButtonText: 'OK'
						});
						return;
					}

					// Block non-Philippines
					if (address.country !== 'Philippines') {
						if (marker) { map.removeLayer(marker); marker = null; }
						Swal.fire({
							title: 'Outside Philippines',
							text: 'Please pin a location within the Philippines only.',
							icon: 'error',
							confirmButtonText: 'OK'
						});
						return;
					}

					// Block outside Metro Manila
					const fullAddressText = data.display_name || '';
					const stateText = address.state || address.county || '';
					const isInManila = validRegions.some(region =>
						fullAddressText.includes(region) || stateText.includes(region)
					);

					if (!isInManila) {
						if (marker) { map.removeLayer(marker); marker = null; }
						Swal.fire({
							title: 'Outside Metro Manila',
							text: 'Please select a location within Metro Manila / NCR only.',
							icon: 'error',
							confirmButtonText: 'OK'
						});
						return;
					}

					// ✅ Valid — place/move marker
					if (marker) {
						marker.setLatLng([lat, lng]);
					} else {
						marker = L.marker([lat, lng]).addTo(map);
					}

					const city     = address.city || address.town || address.municipality || address.county || 'N/A';
					const province = address.state || 'Metro Manila';
					const fullAddr = data.display_name || 'Address not found';

					document.getElementById("Latitude").value  = lat;
					document.getElementById("Longitude").value = lng;

					// Update any address fields if they exist
					const cityEl    = document.getElementById("locationCity");
					const provEl    = document.getElementById("locationProvince");
					const addrEl    = document.getElementById("locationFullAddress");
					if (cityEl) cityEl.value = city;
					if (provEl) provEl.value = province;
					if (addrEl) addrEl.value = fullAddr;

					marker.bindPopup(
						`<strong>${city}, ${province}</strong><br>${fullAddr}`
					).openPopup();

					map.setView([lat, lng], 14);

				} catch (err) {
					console.error('Reverse geocoding failed:', err);
					Swal.fire({
						title: 'Error',
						text: 'Unable to fetch address details. Please try again.',
						icon: 'error',
						confirmButtonText: 'OK'
					});
				}
			});

			// ─── Checkbox / stepper logic (unchanged) ──────────────────────────
			const trainingCheckbox = document.getElementById('kt_create_account_form_account_type_personal');
			const employerCheckbox = document.getElementById('kt_create_account_form_account_type_corporate');

			let originalTrainingFields = [];
			let originalEmployerFields = [];

			const trainingFields = document.querySelectorAll('[data-account="training"]');
			const employerFields = document.querySelectorAll('[data-account="employer"]');

			trainingFields.forEach(field => originalTrainingFields.push(field.cloneNode(true)));
			employerFields.forEach(field => originalEmployerFields.push(field.cloneNode(true)));

			function toggleFields() {
				const isTrainingSelected = trainingCheckbox.checked;
				const isEmployerSelected = employerCheckbox.checked;
				const step4Container = document.querySelector('[data-kt-stepper-element="content"]:nth-child(4) .w-100');

				document.querySelectorAll('[data-account="training"]').forEach(f => f.remove());
				document.querySelectorAll('[data-account="employer"]').forEach(f => f.remove());

				if (isTrainingSelected) {
					originalTrainingFields.forEach(originalField => {
						const clonedField = originalField.cloneNode(true);
						const input = clonedField.querySelector('input[type="file"]');
						const label = clonedField.querySelector('label');
						clonedField.style.display = 'flex';
						input.setAttribute('required', 'required');
						if (label && !label.classList.contains('required')) label.classList.add('required');
						step4Container.appendChild(clonedField);
					});
				}

				if (isEmployerSelected) {
					originalEmployerFields.forEach(originalField => {
						const clonedField = originalField.cloneNode(true);
						const input = clonedField.querySelector('input[type="file"]');
						const label = clonedField.querySelector('label');
						clonedField.style.display = 'flex';
						input.setAttribute('required', 'required');
						if (label && !label.classList.contains('required')) label.classList.add('required');
						step4Container.appendChild(clonedField);
					});
				}

				if (typeof FormValidation !== 'undefined' && window.stepperFormValidator) {
					if (isTrainingSelected) {
						setTimeout(() => {
							window.stepperFormValidator.revalidateField('sec_dti');
							window.stepperFormValidator.revalidateField('bir_certificate');
							window.stepperFormValidator.revalidateField('business_permit');
						}, 100);
					}
					if (isEmployerSelected) {
						setTimeout(() => {
							window.stepperFormValidator.revalidateField('poea_license');
							window.stepperFormValidator.revalidateField('proof_partnership');
						}, 100);
					}
				}
			}

			function handleCheckboxSelection() {
				toggleFields();
				updateStep2Visibility();
			}

			function updateStep2Visibility() {
				const step2 = document.querySelector('[data-kt-stepper-element="content"]:nth-child(2)');
				const accountNameField = step2?.querySelector('[name="account_name"]');
				const accountNameLabel = step2?.querySelector('label[class*="form-label"]');
				if (accountNameField && accountNameLabel) {
					accountNameLabel.textContent = employerCheckbox.checked
						? 'Name of Employer'
						: 'Name of Training Center';
					accountNameField.placeholder = employerCheckbox.checked
						? 'Enter employer name'
						: 'Enter training center name';
				}
			}

			if (trainingCheckbox) trainingCheckbox.addEventListener('change', handleCheckboxSelection);
			if (employerCheckbox) employerCheckbox.addEventListener('change', handleCheckboxSelection);

			toggleFields();
			updateStep2Visibility();

			function validateStepTransition(currentStep, nextStep) {
				if (currentStep === 1 && nextStep === 2) {
					if (!trainingCheckbox.checked && !employerCheckbox.checked) {
						Swal.fire({
							text: "Please select at least one account type.",
							icon: "error",
							buttonsStyling: false,
							confirmButtonText: "Ok, got it!",
							customClass: { confirmButton: "btn btn-primary" }
						});
						return false;
					}
				}

				if (currentStep === 4) {
					let hasError = false;
					const errorMessages = [];

					if (trainingCheckbox.checked) {
						document.querySelectorAll('[data-account="training"]').forEach(field => {
							const input = field.querySelector('input[type="file"]');
							const label = field.querySelector('label');
							if (input.hasAttribute('required') && !input.files.length) {
								hasError = true;
								errorMessages.push(`${label.textContent} is required`);
							}
						});
					}

					if (employerCheckbox.checked) {
						document.querySelectorAll('[data-account="employer"]').forEach(field => {
							const input = field.querySelector('input[type="file"]');
							const label = field.querySelector('label');
							if (input.hasAttribute('required') && !input.files.length) {
								hasError = true;
								errorMessages.push(`${label.textContent} is required`);
							}
						});
					}

					if (hasError) {
						Swal.fire({
							text: errorMessages.join('\n'),
							icon: "error",
							buttonsStyling: false,
							confirmButtonText: "Ok, got it!",
							customClass: { confirmButton: "btn btn-primary" }
						});
						return false;
					}
				}

				return true;
			}

			window.validateStepTransition = validateStepTransition;

			if (typeof KTStepper !== 'undefined') {
				setTimeout(() => {
					const stepperElement = document.querySelector('[data-kt-stepper="true"]');
					if (stepperElement && stepperElement.stepper) {
						const stepper = stepperElement.stepper;
						const originalNext = stepper.goNext;
						stepper.goNext = function () {
							const currentIndex = stepper.getCurrentStepIndex();
							const nextIndex = currentIndex + 1;
							if (validateStepTransition(currentIndex, nextIndex)) {
								originalNext.call(this);
							}
						};
					}
				}, 100);
			}

			window.debugFormState = function () {
				console.log('Training Center selected:', trainingCheckbox.checked);
				console.log('Employer selected:', employerCheckbox.checked);
			};
		});
	</script>


	<!--end::Javascript-->


