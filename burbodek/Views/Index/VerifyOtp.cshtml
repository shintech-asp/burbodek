@{
    ViewData["Title"] = "Verify OTP";
    Layout = null;
    var email = Context.Request.Query["email"].ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Verify OTP</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />
    <link href="/assets/plugins/global/plugins.bundle.css" rel="stylesheet" />
    <link href="/assets/css/style.bundle.css" rel="stylesheet" />
</head>
<body id="kt_body" class="app-blank">
    <div class="d-flex flex-column flex-root" id="kt_app_root">
        <div class="d-flex flex-column flex-lg-row flex-column-fluid">
            <div class="d-flex flex-column flex-lg-row-fluid w-lg-50 p-10 order-2 order-lg-1">
                <div class="d-flex flex-center flex-column flex-lg-row-fluid">
                    <div class="w-lg-500px p-10">

                        @* Alerts *@
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger d-flex align-items-center p-5 mb-10">
                                <i class="ki-duotone ki-shield-cross fs-2hx text-danger me-4">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                                <div class="d-flex flex-column">
                                    <span>@TempData["Error"]</span>
                                </div>
                            </div>
                        }
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success d-flex align-items-center p-5 mb-10">
                                <i class="ki-duotone ki-shield-tick fs-2hx text-success me-4">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                                <div class="d-flex flex-column">
                                    <span>@TempData["Success"]</span>
                                </div>
                            </div>
                        }

                        @* Heading *@
                        <div class="text-center mb-10">
                            <div class="mb-5">
                                <i class="ki-duotone ki-sms fs-5tx text-primary">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                            </div>
                            <h1 class="text-gray-900 fw-bolder mb-3">Two-Step Verification</h1>
                            <div class="text-muted fw-semibold fs-6 mb-1">
                                Enter the 6-digit verification code sent to
                            </div>
                            <div class="fw-bold text-gray-900 fs-4">@email</div>
                        </div>

                        @* OTP Form *@
                        <form method="post" action="/Index/VerifyOtp?email=@Uri.EscapeDataString(email)" id="kt_otp_form">
                            <input type="hidden" name="email" value="@email" />

                            @* OTP Input Boxes *@
                            <div class="mb-10">
                                <div class="fw-bold text-start text-gray-900 fs-6 mb-1 ms-1">
                                    Type your 6 digit security code
                                </div>
                                <div class="d-flex flex-wrap flex-stack gap-3 justify-content-center">
                                    <input type="text" maxlength="1" class="form-control form-control-solid h-60px w-60px fs-2qx text-center otp-input" data-index="0" />
                                    <input type="text" maxlength="1" class="form-control form-control-solid h-60px w-60px fs-2qx text-center otp-input" data-index="1" />
                                    <input type="text" maxlength="1" class="form-control form-control-solid h-60px w-60px fs-2qx text-center otp-input" data-index="2" />
                                    <input type="text" maxlength="1" class="form-control form-control-solid h-60px w-60px fs-2qx text-center otp-input" data-index="3" />
                                    <input type="text" maxlength="1" class="form-control form-control-solid h-60px w-60px fs-2qx text-center otp-input" data-index="4" />
                                    <input type="text" maxlength="1" class="form-control form-control-solid h-60px w-60px fs-2qx text-center otp-input" data-index="5" />
                                </div>
                                @* Hidden combined OTP field *@
                                <input type="hidden" name="otp" id="otpCombined" />
                            </div>

                            @* Expiry countdown *@
                            <div class="text-center mb-8">
                                <span class="text-muted fs-6">Code expires in </span>
                                <span class="fw-bold text-danger fs-6" id="countdown">05:00</span>
                            </div>

                            @* Submit *@
                            <div class="d-flex flex-center">
                                <button type="submit" id="kt_otp_submit" class="btn btn-primary me-3 w-100">
                                    <span class="indicator-label">Verify Account</span>
                                    <span class="indicator-progress">
                                        Please wait...
                                        <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                                    </span>
                                </button>
                            </div>
                        </form>

                        @* Resend *@
                        <div class="text-center mt-6">
                            <div class="text-muted fw-semibold fs-5 mb-3">
                                Didn't receive the code?
                            </div>
                            <form method="post" action="/Index/ResendOtp">
                                <input type="hidden" name="email" value="@email" />
                                <button type="submit" class="btn btn-light-primary btn-sm" id="resendBtn">
                                    <i class="ki-duotone ki-arrows-circle fs-5">
                                        <span class="path1"></span><span class="path2"></span>
                                    </i>
                                    Resend Code
                                </button>
                            </form>
                        </div>

                        @* Back to sign in *@
                        <div class="text-center mt-6">
                            <a href="/Index/SignIn" class="link-primary fs-6 fw-bold">
                                <i class="ki-duotone ki-arrow-left fs-6">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                                Back to Sign In
                            </a>
                        </div>

                    </div>
                </div>
            </div>

            @* Right side banner *@
            <div class="d-flex flex-lg-row-fluid w-lg-50 bgi-size-cover bgi-position-center order-1 order-lg-2"
                 style="background-image: url(/assets/media/misc/auth-bg.png)">
                <div class="d-flex flex-column flex-center py-15 px-5 px-md-15 w-100">

                    <img class="d-none d-lg-block mx-auto w-275px w-md-50 w-xl-500px mb-10 mb-lg-20" src="~/assets/media/logos/landing_logo.png" alt="">

                    <!--begin::Title-->
                    <h1 class="d-none d-lg-block text-white fs-2qx fw-bolder text-center mb-7">
                        Your Career, Your Growth, Your Success
                    </h1>
                    <!--end::Title-->
                    <!--begin::Text-->
                    <div class="d-none d-lg-block text-white fs-base text-center">
                        Discover the best <a href="#" class="opacity-75-hover text-warning fw-bold me-1">job opportunities</a> that match your skills and ambition.
                        <br>Apply with confidence and track your progress through our <a href="#" class="opacity-75-hover text-warning fw-bold me-1">training programs</a> designed to elevate your career.
                        <br>Unlock badges, gain experience, and reach your professional goals faster.
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script src="/assets/plugins/global/plugins.bundle.js"></script>
    <script src="/assets/js/scripts.bundle.js"></script>
    <script>
        // Auto-advance OTP inputs
        const inputs = document.querySelectorAll('.otp-input');
        inputs.forEach((input, index) => {
            input.addEventListener('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '');
                if (this.value.length === 1 && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
            });
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Backspace' && this.value === '' && index > 0) {
                    inputs[index - 1].focus();
                }
            });
            input.addEventListener('paste', function (e) {
                e.preventDefault();
                const paste = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
                paste.split('').slice(0, 6).forEach((char, i) => {
                    if (inputs[i]) inputs[i].value = char;
                });
                const next = Math.min(paste.length, inputs.length - 1);
                inputs[next].focus();
            });
        });

        // Combine OTP before submit
        document.getElementById('kt_otp_form').addEventListener('submit', function (e) {
            const combined = Array.from(inputs).map(i => i.value).join('');
            if (combined.length !== 6) {
                e.preventDefault();
                // Show validation error
                inputs.forEach(i => i.classList.add('border-danger'));
                return false;
            }
            document.getElementById('otpCombined').value = combined;
        });

        // Remove error border on input
        inputs.forEach(i => i.addEventListener('input', () => {
            inputs.forEach(x => x.classList.remove('border-danger'));
        }));

        // Countdown timer (5 minutes)
        let seconds = 300;
        const countdown = document.getElementById('countdown');
        const resendBtn = document.getElementById('resendBtn');
        const timer = setInterval(() => {
            seconds--;
            if (seconds <= 0) {
                clearInterval(timer);
                countdown.textContent = 'Expired';
                countdown.classList.remove('text-danger');
                countdown.classList.add('text-muted');
            } else {
                const m = Math.floor(seconds / 60).toString().padStart(2, '0');
                const s = (seconds % 60).toString().padStart(2, '0');
                countdown.textContent = `${m}:${s}`;
            }
        }, 1000);
    </script>
</body>
</html>